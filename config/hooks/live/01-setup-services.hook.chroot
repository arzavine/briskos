#!/bin/bash
set -euo pipefail

echo "=========================================================="
echo " [BriskOS Hook] 01-setup-services: Configuring system/user services"
echo "=========================================================="

# 1. Enable core system services
SYSTEM_SERVICES=(
    "NetworkManager.service"
    "iwd.service"
    "bluetooth.service"
    "systemd-timesyncd.service"
    "greetd.service"
)

for svc in "${SYSTEM_SERVICES[@]}"; do
    if systemctl list-unit-files "$svc" &>/dev/null || [ -f "/lib/systemd/system/$svc" ] || [ -f "/etc/systemd/system/$svc" ] || [ -f "/usr/lib/systemd/system/$svc" ]; then
        echo "--> Enabling system service: $svc"
        systemctl enable "$svc" 2>/dev/null || true
    else
        echo "--> Notice: $svc not present yet, skipping direct enable"
    fi
done

# Ensure greetd is explicitly wired as display-manager and wanted by graphical.target
GREETD_UNIT=""
for unit_dir in /usr/lib/systemd/system /lib/systemd/system /etc/systemd/system; do
    if [ -f "$unit_dir/greetd.service" ]; then
        GREETD_UNIT="$unit_dir/greetd.service"
        break
    fi
done

if [ -n "$GREETD_UNIT" ]; then
    echo "--> Verifying greetd display-manager & graphical.target symlinks ($GREETD_UNIT)..."
    mkdir -p /etc/systemd/system/graphical.target.wants
    ln -sf "$GREETD_UNIT" /etc/systemd/system/display-manager.service
    ln -sf "$GREETD_UNIT" /etc/systemd/system/graphical.target.wants/greetd.service
fi

# Ensure _greetd system user exists for tuigreet fallback on installed systems
if ! id -u _greetd >/dev/null 2>&1; then
    echo "--> Creating fallback system user _greetd..."
    useradd --system --no-create-home --shell /usr/sbin/nologin --home-dir /var/lib/greetd _greetd 2>/dev/null || true
fi

# Normalize greetd config & systemd drop-in permissions and validate TOML syntax
if [ -f "/etc/greetd/config.toml" ]; then
    chown root:root /etc/greetd/config.toml
    chmod 644 /etc/greetd/config.toml
    if command -v python3 >/dev/null 2>&1; then
        python3 -c 'import tomllib; tomllib.load(open("/etc/greetd/config.toml", "rb"))'
        echo "--> Validated /etc/greetd/config.toml syntax."
    fi
fi

if [ -d "/etc/systemd/system/greetd.service.d" ]; then
    chmod 755 /etc/systemd/system/greetd.service.d
    chown -R root:root /etc/systemd/system/greetd.service.d
    find /etc/systemd/system/greetd.service.d -type f -name "*.conf" -exec chmod 644 {} +
fi

# Avoid radio state conflict between TLP and systemd-rfkill
systemctl mask systemd-rfkill.service systemd-rfkill.socket 2>/dev/null || true

# Ensure default target is graphical so greetd starts on boot
systemctl set-default graphical.target 2>/dev/null || true

# 2. Enable global user services for PipeWire audio server and WirePlumber session manager
echo "--> Setting up PipeWire and WirePlumber global user service links..."

USER_SERVICES=(
    "pipewire.service"
    "pipewire-pulse.service"
    "wireplumber.service"
)

USER_SOCKETS=(
    "pipewire.socket"
    "pipewire-pulse.socket"
)

# Attempt systemctl --global enable (operates on /etc/systemd/user without needing active daemon)
for usvc in "${USER_SERVICES[@]}"; do
    systemctl --global enable "$usvc" 2>/dev/null || true
done

for usock in "${USER_SOCKETS[@]}"; do
    systemctl --global enable "$usock" 2>/dev/null || true
done

# In addition, ensure explicit symlinks in /etc/systemd/user/ for guaranteed activation during user session
mkdir -p /etc/systemd/user/default.target.wants
mkdir -p /etc/systemd/user/sockets.target.wants

for usvc in "${USER_SERVICES[@]}"; do
    for dir in /usr/lib/systemd/user /lib/systemd/user; do
        if [ -f "$dir/$usvc" ]; then
            ln -sf "$dir/$usvc" "/etc/systemd/user/default.target.wants/$usvc"
            break
        fi
    done
done

for usock in "${USER_SOCKETS[@]}"; do
    for dir in /usr/lib/systemd/user /lib/systemd/user; do
        if [ -f "$dir/$usock" ]; then
            ln -sf "$dir/$usock" "/etc/systemd/user/sockets.target.wants/$usock"
            break
        fi
    done
done

echo "--> Service configuration completed."
