# ==============================================================================
# Brisk Battery Sentinel Sudo Privileges
# Allow live session user and sudo group to adjust power profiles without password
# ==============================================================================

live ALL=(ALL) NOPASSWD: /usr/local/bin/brisk-sentinel
user ALL=(ALL) NOPASSWD: /usr/local/bin/brisk-sentinel
%sudo ALL=(ALL) NOPASSWD: /usr/local/bin/brisk-sentinel
