[Unit]
Description=BriskOS Glide Mode Low-Battery Auto-Pilot Engine
Documentation=https://github.com/briskos/briskos
After=systemd-udevd.service upower.service tlp.service
Wants=tlp.service

[Service]
Type=simple
ExecStart=/usr/local/bin/brisk-glide-daemon daemon
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=3s

[Install]
WantedBy=multi-user.target
