/* ==========================================================================
   BriskOS 1.0 LTS "Morning Breeze" Calamares Qt Stylesheet
   Adheres strictly to Morning Breeze Design Tokens & WCAG AA Contrast:
     - Shell / Sidebar:    #E9F1F4 (divider #D5E2E7)
     - Canvas Floor:       #F5F7F7
     - Cards / Inputs:     #FFFFFF (card border #CBD5E1, input rest #64748B)
     - Text Primary:       #0F172A
     - Text Secondary:     #475569
     - Single Accent:      #0E7490 (Hover #0C627A, Pressed #094D61)
     - Soft Active Pill:   #D6E9EE (Text #0C5B73 / #0F172A)
   ========================================================================== */

/* --- Global Base Window & Typography --- */
QWidget {
    background-color: #F5F7F7;
    color: #0F172A;
    font-family: "Inter", "Noto Sans", "Cantarell", "Segoe UI", sans-serif;
    font-size: 13px;
    selection-background-color: #0E7490;
    selection-color: #FFFFFF;
}

/* Main Calamares Window & Dialogs */
QMainWindow,
QDialog,
QWidget#calamares {
    background-color: #F5F7F7;
    color: #0F172A;
}

/* --- Left Sidebar (Step Navigation) --- */
#sidebarApp,
#sidebarMenu,
QWidget#sidebar,
QListView#sidebar {
    background-color: #E9F1F4;
    border: none;
    border-right: 1px solid #D5E2E7;
    color: #475569;
    font-size: 13px;
    font-weight: 500;
    padding: 16px 8px;
    min-width: 190px;
}

/* Sidebar List Item Elements */
QListView#sidebar::item {
    padding: 10px 14px;
    margin: 3px 6px;
    border-radius: 8px;
    color: #475569;
    background-color: transparent;
}

QListView#sidebar::item:hover {
    background-color: #DCE9EE;
    color: #0F172A;
}

/* Active / Selected Step */
QListView#sidebar::item:selected,
QListView#sidebar::item:selected:active {
    background-color: #D6E9EE;
    color: #0C5B73;
    font-weight: 600;
    border-left: 3px solid #0E7490;
}

/* --- Content Pages & Panels --- */
QStackedWidget,
#view-pages,
QWidget#page {
    background-color: #F5F7F7;
    border: none;
    padding: 16px;
}

/* Header & Text Labels */
QLabel {
    background-color: transparent;
    color: #0F172A;
}

QLabel#headerLabel,
QLabel#titleLabel {
    font-size: 20px;
    font-weight: 700;
    color: #0F172A;
    padding-bottom: 8px;
}

QLabel#subHeaderLabel,
QLabel#textLabel {
    font-size: 13px;
    color: #475569;
}

QLabel:disabled {
    color: #475569;
}

/* --- Buttons (Secondary & Default) --- */
QPushButton {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    min-width: 72px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #D6E9EE;
    border-color: #0E7490;
    color: #0C5B73;
}

QPushButton:pressed {
    background-color: #C3DFE7;
    border-color: #0C627A;
    color: #0F172A;
}

QPushButton:focus {
    border: 2px solid #0E7490;
}

QPushButton:disabled {
    background-color: #E9F1F4;
    border: 1px solid #CBD5E1;
    color: #475569;
}

/* Primary Action Buttons (Next / Install / Finish) */
QPushButton#nextButton,
QPushButton:default {
    background-color: #0E7490;
    border: 1px solid #0E7490;
    color: #FFFFFF;
}

QPushButton#nextButton:hover,
QPushButton:default:hover {
    background-color: #0C627A;
    border-color: #0C627A;
    color: #FFFFFF;
}

QPushButton#nextButton:pressed,
QPushButton:default:pressed {
    background-color: #094D61;
    border-color: #094D61;
    color: #FFFFFF;
}

QPushButton#nextButton:focus,
QPushButton:default:focus {
    border: 2px solid #0F172A;
}

/* --- Input Fields & Text Edits --- */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #64748B;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    selection-background-color: #0E7490;
    selection-color: #FFFFFF;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus {
    border: 2px solid #0E7490;
    background-color: #FFFFFF;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #E9F1F4;
    color: #475569;
    border: 1px solid #CBD5E1;
}

/* --- Dropdown Boxes (QComboBox) --- */
QComboBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #64748B;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #0E7490;
}

QComboBox:focus {
    border: 2px solid #0E7490;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #CBD5E1;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    selection-background-color: #D6E9EE;
    selection-color: #0F172A;
    padding: 4px;
}

/* --- Cards, GroupBoxes, and Frames --- */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    margin-top: 18px;
    padding: 16px 12px 12px 12px;
    font-weight: 600;
    color: #0F172A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    color: #0C5B73;
    background-color: transparent;
}

QFrame#card,
QFrame[frameShape="StyledPanel"] {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
}

/* --- Progress Bar --- */
QProgressBar {
    background-color: #FFFFFF;
    border: 1px solid #64748B;
    border-radius: 6px;
    text-align: center;
    color: #0F172A;
    font-weight: 600;
    font-size: 12px;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #3C96AD;
    border-radius: 5px;
}

/* --- Checkboxes & Radio Buttons --- */
QCheckBox,
QRadioButton {
    color: #0F172A;
    spacing: 8px;
    background-color: transparent;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #475569;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #FFFFFF;
    border: 1px solid #64748B;
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #0E7490;
}

QCheckBox::indicator:focus,
QRadioButton::indicator:focus {
    border: 2px solid #0E7490;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #0E7490;
    border: 3px solid #D6E9EE;
}

/* --- Tables, Lists & Trees (Partitions, Summary, Logs) --- */
QTreeView,
QListView,
QTableView {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    gridline-color: #E2E8F0;
    outline: none;
}

QTreeView:focus,
QListView:focus,
QTableView:focus {
    border: 2px solid #0E7490;
}

QTreeView::item,
QListView::item,
QTableView::item {
    padding: 6px;
    border-bottom: 1px solid #F1F5F9;
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
    background-color: #D6E9EE;
    color: #0F172A;
}

QHeaderView::section {
    background-color: #E9F1F4;
    color: #475569;
    padding: 6px 10px;
    border: none;
    border-right: 1px solid #CBD5E1;
    border-bottom: 1px solid #CBD5E1;
    font-weight: 600;
}

/* --- Scroll Bars --- */
QScrollBar:vertical {
    background: #F5F7F7;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #94A3B8;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #0E7490;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #F5F7F7;
    height: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #94A3B8;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #0E7490;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* --- Tooltips --- */
QToolTip {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #0E7490;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
}
