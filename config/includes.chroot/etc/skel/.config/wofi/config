# ==============================================================================
# BriskOS Wofi Start Menu Launcher Configuration
# Morning Breeze Design System: Crisp #F5F7F7 surface, #CBD5E1 border, 14px radius,
# anchored 8px above the Waybar floating start button.
# ==============================================================================

# Operating Mode
mode=drun
show=drun

# Geometry & Dimensions
width=440
height=510
location=bottom_left
xoffset=8
yoffset=-56

# Appearance & Behavior
prompt=Search applications...
allow_images=true
image_size=28
insensitive=true
no_actions=true
term=foot
hide_scroll=true
layer=overlay
