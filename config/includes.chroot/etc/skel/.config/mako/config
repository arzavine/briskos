# BriskOS 1.0 LTS Notification Daemon (Mako - "Morning Breeze")

sort=-time
layer=overlay

# Notification location: bottom-right
anchor=bottom-right
margin=12

# Geometry & Card Style
padding=14
width=360
height=130
border-size=1
border-radius=12

# Colors (Morning Breeze Light)
font=Inter 10
background-color=#fffffff2
text-color=#0f172a
border-color=#cbd5e1
progress-color=over #d6e9ee

# Behavior
default-timeout=5000
ignore-timeout=0
max-visible=4
icons=1
icon-path=/usr/share/icons/Papirus:/usr/share/icons/hicolor
max-icon-size=40
markup=1
actions=1
format=<b>%s</b>\n%b

# Urgency Styling
[urgency=low]
border-color=#cbd5e1
default-timeout=3000

[urgency=normal]
border-color=#0e7490
default-timeout=5000

[urgency=critical]
background-color=#fef2f2f5
border-color=#b91c1c
text-color=#7f1d1d
default-timeout=0
