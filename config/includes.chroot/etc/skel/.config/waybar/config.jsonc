// BriskOS 1.0 LTS Waybar Configuration ("Morning Breeze")
{
    "layer": "top",
    "position": "bottom",
    "height": 42,
    "margin-bottom": 8,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 4,

    "modules-left": [
        "custom/startmenu",
        "custom/store",
        "custom/installer",
        "custom/files",
        "custom/browser",
        "custom/terminal",
        "custom/office",
        "custom/settings"
    ],
    "modules-center": [
        "wlr/taskbar"
    ],
    "modules-right": [
        "tray",
        "pulseaudio",
        "network",
        "battery",
        "clock",
        "custom/power"
    ],

    // Launcher & Pinned Desktop Actions
    "custom/startmenu": {
        "format": "Apps",
        "interval": "once",
        "tooltip-format": "Applications and Search (Super)",
        "on-click": "pkill -x wofi || wofi --show drun"
    },

    "custom/store": {
        "format": "Store",
        "interval": "once",
        "tooltip-format": "Brisk Store",
        "on-click": "brisk-store"
    },

    "custom/installer": {
        "format": "Install",
        "interval": "once",
        "tooltip-format": "Install BriskOS 1.0 LTS to disk",
        "on-click": "brisk-installer"
    },

    "custom/files": {
        "format": " ",
        "interval": "once",
        "tooltip-format": "File Manager (Thunar)",
        "on-click": "thunar"
    },

    "custom/browser": {
        "format": " ",
        "interval": "once",
        "tooltip-format": "Web Browser",
        "on-click": "x-www-browser"
    },

    "custom/terminal": {
        "format": " ",
        "interval": "once",
        "tooltip-format": "Terminal (Foot)",
        "on-click": "foot"
    },

    "custom/office": {
        "format": " ",
        "interval": "once",
        "tooltip-format": "LibreOffice Writer",
        "on-click": "libreoffice --writer"
    },

    "custom/settings": {
        "format": " ",
        "interval": "once",
        "tooltip-format": "Brisk Control Center",
        "on-click": "brisk-control"
    },

    // Center Taskbar
    "wlr/taskbar": {
        "format": "{icon} {title:.18}",
        "icon-size": 18,
        "icon-theme": "Papirus",
        "all-outputs": true,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "wofi"
        ]
    },

    // System Tray & Status Modules
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "pulseaudio": {
        "scroll-step": 5,
        "format": "{volume}%",
        "format-bluetooth": "{volume}%",
        "format-muted": "Muted",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip-format": "Volume: {volume}% ({desc})"
    },

    "network": {
        "interval": 5,
        "format": "Online",
        "format-wifi": "{essid}",
        "format-ethernet": "Wired",
        "format-linked": "Wired",
        "format-disconnected": "Offline",
        "tooltip-format": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "on-click": "brisk-control"
    },

    "battery": {
        "states": {
            "warning": 25,
            "critical": 12
        },
        "format": "{capacity}%",
        "format-charging": "{capacity}%",
        "format-plugged": "{capacity}%",
        "tooltip-format": "{capacity}% ({time}) - {status}\nBrisk Sentinel Power Guard",
        "on-click": "brisk-sentinel-gui"
    },

    "clock": {
        "interval": 1,
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "months": "<span color='#0f172a'><b>{}</b></span>",
                "days": "<span color='#475569'>{}</span>",
                "weeks": "<span color='#0c5b73'><b>W{}</b></span>",
                "weekdays": "<span color='#0e7490'><b>{}</b></span>",
                "today": "<span color='#ffffff' background='#0e7490'><b> {} </b></span>"
            }
        }
    },

    "custom/power": {
        "format": " ",
        "interval": "once",
        "tooltip-format": "Log Out / Exit Session",
        "on-click": "labwc --exit"
    }
}
