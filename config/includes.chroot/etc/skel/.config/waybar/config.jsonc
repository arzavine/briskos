{
    // =========================================================================
    // BriskOS Waybar Bottom Taskbar Configuration
    // Night Glass Design System: Floating 3-Island Architecture
    // =========================================================================
    "layer": "top",
    "position": "bottom",
    "height": 40,
    "margin-bottom": 8,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,

    // Module Layout - 3-Island Architecture
    "modules-left": [
        "custom/startmenu",
        "custom/store",
        "custom/settings",
        "custom/installer",
        "custom/browser",
        "custom/files",
        "custom/terminal",
        "custom/office"
    ],
    "modules-center": [
        "wlr/taskbar"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "clock",
        "custom/power"
    ],

    // -------------------------------------------------------------------------
    // Left Island: Start Menu & Quick-Launch Pinned Items
    // -------------------------------------------------------------------------
    "custom/startmenu": {
        "format": "❖",
        "tooltip-format": "Applications & Search (Super)",
        "on-click": "pkill -x wofi || wofi --show drun",
        "escape": true
    },
    "custom/store": {
        "format": "Store",
        "tooltip-format": "Brisk Store (Pusat Aplikasi Modern)",
        "on-click": "brisk-store",
        "escape": true
    },
    "custom/settings": {
        "format": "⚙️",
        "tooltip-format": "Brisk Control Center (Pusat Pengaturan)",
        "on-click": "brisk-control",
        "escape": true
    },
    "custom/installer": {
        "format": "💿 Install",
        "tooltip-format": "Install BriskOS 1.0 LTS permanently to disk",
        "on-click": "brisk-installer"
    },
    "custom/browser": {
        "format": "🌐",
        "tooltip-format": "Web Browser",
        "on-click": "x-www-browser",
        "escape": true
    },
    "custom/files": {
        "format": "📁",
        "tooltip-format": "File Manager (Thunar)",
        "on-click": "thunar",
        "escape": true
    },
    "custom/terminal": {
        "format": "💻",
        "tooltip-format": "Terminal (Foot)",
        "on-click": "foot",
        "escape": true
    },
    "custom/office": {
        "format": "📝",
        "tooltip-format": "Productivity Suite (Office)",
        "on-click": "sh -c 'command -v onlyoffice-desktopeditors >/dev/null 2>&1 && exec onlyoffice-desktopeditors || exec libreoffice --writer'",
        "escape": true
    },

    // -------------------------------------------------------------------------
    // Center Island: Window Taskbar
    // -------------------------------------------------------------------------
    "wlr/taskbar": {
        "format": "{icon} {title}",
        "icon-size": 18,
        "icon-theme": "Papirus-Dark",
        "spacing": 4,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "wofi"
        ],
        "max-length": 30
    },

    // -------------------------------------------------------------------------
    // Right Island: System Indicators & Session Controls
    // -------------------------------------------------------------------------
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂯 {icon} {volume}%",
        "format-bluetooth-muted": "󰂯 🔇 {volume}%",
        "format-muted": "🔇 {volume}%",
        "format-icons": {
            "headphone": "🎧",
            "hands-free": "🎧",
            "headset": "🎧",
            "phone": "📞",
            "portable": "📱",
            "car": "🚗",
            "default": ["🔈", "🔉", "🔊"]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "tooltip-format": "Volume: {volume}% ({desc})"
    },
    "network": {
        "interval": 5,
        "format-wifi": "📶 {essid} ({signalStrength}%)",
        "format-ethernet": "🖧 {ipaddr}",
        "format-linked": "🖧 {ifname} (No IP)",
        "format-disconnected": "⚠️ Offline",
        "tooltip-format": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "tooltip-format-wifi": "SSID: {essid} ({signalStrength}%)\nIP: {ipaddr}/{cidr}",
        "tooltip-format-ethernet": "Ethernet: {ifname}\nIP: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Network Disconnected",
        "on-click": "brisk-control"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-plugged": "🔌 {capacity}%",
        "format-critical": "🪽🪫 {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["🪫", "🔋", "🔋"],
        "tooltip-format": "{capacity}% ({time}) • {status}\n⚡ Brisk Sentinel & Glide Mode Auto-Guard\nClick to open power settings",
        "tooltip-format-critical": "🪽 GLIDE MODE ACTIVE ({capacity}%)\nAuto-guard low-battery protection engaged\nClick to open power settings",
        "tooltip-format-charging": "⚡ Charging: {capacity}% ({time} until full)\nClick to open power settings",
        "on-click": "brisk-sentinel-gui"
    },
    "clock": {
        "interval": 1,
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d %B %Y  %H:%M:%S}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "months": "<span color='#f8fafc'><b>{}</b></span>",
                "days": "<span color='#94a3b8'><b>{}</b></span>",
                "weekdays": "<span color='#38bdf8'><b>{}</b></span>",
                "today": "<span color='#0f172a' background='#38bdf8'><b><u>{}</u></b></span>"
            }
        }
    },
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power Off / Exit Session",
        "on-click": "labwc --exit",
        "escape": true
    }
}
