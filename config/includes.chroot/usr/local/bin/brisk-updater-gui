    ),
    "download": (
        '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>'
        '<polyline points="7 10 12 15 17 10"/>'
        '<line x1="12" y1="15" x2="12" y2="3"/>'
    ),
    "terminal": (
        '<polyline points="4 17 10 11 4 5"/>'
        '<line x1="12" y1="19" x2="20" y2="19"/>'
    ),
    "info": (
        '<circle cx="12" cy="12" r="9"/>'
        '<line x1="12" y1="16" x2="12" y2="12"/>'
        '<line x1="12" y1="8" x2="12.01" y2="8"/>'
    ),
    "warn": (
        '<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>'
        '<line x1="12" y1="9" x2="12" y2="13"/>'
        '<line x1="12" y1="17" x2="12.01" y2="17"/>'
    ),
    "check": (
        '<circle cx="12" cy="12" r="9"/>'
        '<polyline points="9 12 11.5 14.5 16 9.5"/>'
    ),
}


def svg_icon(name, color="#0E7490", size=18):
    inner = SVG_TEMPLATES.get(name, SVG_TEMPLATES["info"])
    svg_xml = (
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}" '
        f'viewBox="0 0 24 24" fill="none" stroke="{color}" stroke-width="1.8" '
        f'stroke-linecap="round" stroke-linejoin="round">{inner}</svg>'
    ).encode("utf-8")
    loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
    loader.set_size(size, size)
    loader.write(svg_xml)
    loader.close()
    return Gtk.Image.new_from_pixbuf(loader.get_pixbuf())


def read_os_version():
    version_id = "1.0"
    pretty = "BriskOS 1.0 LTS"
    if os.path.isfile("/etc/os-release"):
        try:
            with open("/etc/os-release", "r", encoding="utf-8", errors="replace") as fh:
                for raw in fh:
                    line = raw.strip()
                    if line.startswith("VERSION_ID="):
                        version_id = line.split("=", 1)[1].strip().strip('"').strip("'") or version_id
                    elif line.startswith("PRETTY_NAME="):
                        pretty = line.split("=", 1)[1].strip().strip('"').strip("'") or pretty
        except OSError:
            pass
    return version_id, pretty


def read_release_channel():
    channel_bin = "/usr/local/bin/brisk-channel"
    if os.path.isfile(channel_bin) and os.access(channel_bin, os.X_OK):
        try:
            res = subprocess.run(
                [channel_bin, "get", "--raw"],
                capture_output=True,
                text=True,
                timeout=3,
            )
            ch = res.stdout.strip().lower()
            if ch:
                return ch
        except Exception:
            pass
    return "stable"


def launch_terminal_updater():
    foot = shutil.which("foot")
    cmd = (
        "echo 'BriskOS System Updater (APT)'; echo; "
        "if command -v brisk >/dev/null 2>&1; then sudo /usr/local/bin/brisk update; "
        "else sudo apt-get update && sudo apt-get dist-upgrade; fi; "
        "echo; read -r -p 'Press Enter to close...'"
    )
    if foot:
        subprocess.Popen([foot, "-T", "BriskOS Terminal Updater", "bash", "-lc", cmd])
    else:
        subprocess.Popen(["bash", "-lc", cmd])


