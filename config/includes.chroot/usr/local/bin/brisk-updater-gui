    def set_banner(self, kind, text, spinning=False):
        ctx = self.banner_box.get_style_context()
        lbl_ctx = self.banner_label.get_style_context()
        for cls in ("notice-info", "notice-warn", "notice-success", "notice-error"):
            ctx.remove_class(cls)
        for cls in ("notice-info-text", "notice-warn-text", "notice-success-text", "notice-error-text"):
            lbl_ctx.remove_class(cls)

        style_map = {
            "info": ("notice-info", "notice-info-text", "info", "#0C5B73"),
            "warn": ("notice-warn", "notice-warn-text", "warn", "#9A3412"),
            "success": ("notice-success", "notice-success-text", "check", "#166534"),
            "error": ("notice-error", "notice-error-text", "warn", "#991B1B"),
        }
        box_cls, txt_cls, icon_name, icon_color = style_map.get(kind, style_map["info"])
        ctx.add_class(box_cls)
        lbl_ctx.add_class(txt_cls)
        self.banner_label.set_text(text)

        self.banner_icon_slot.remove(self.banner_icon)
        self.banner_icon = svg_icon(icon_name, color=icon_color, size=18)
        self.banner_icon.set_no_show_all(True)
        self.banner_icon_slot.pack_start(self.banner_icon, False, False, 0)

        if spinning:
            self.banner_icon.hide()
            self.banner_spinner.show()
            self.banner_spinner.start()
        else:
            self.banner_spinner.stop()
            self.banner_spinner.hide()
            self.banner_icon.show()

    def start_release_check(self):
        if self.is_updating:
            return
        self.check_generation += 1
        gen = self.check_generation
        self.btn_refresh.set_sensitive(False)
        self.set_banner("info", "Checking BriskOS release metadata...", spinning=True)
        threading.Thread(target=self._fetch_release_worker, args=(gen,), daemon=True).start()

    def _fetch_release_worker(self, gen):
        data = None
        err_msg = None

        if os.path.isfile(CACHE_RELEASE_FILE):
            try:
                with open(CACHE_RELEASE_FILE, "r", encoding="utf-8") as fh:
                    cached = json.load(fh)
                if isinstance(cached, list) and cached:
                    cached = cached[0]
                if isinstance(cached, dict) and cached.get("tag_name"):
                    data = cached
            except Exception:
                data = None

        if data is None:
            url = GITHUB_API_BETA if self.channel == "beta" else GITHUB_API_LATEST
            req = urllib.request.Request(
                url,
                headers={"User-Agent": "BriskOS-Software-Updater", "Accept": "application/vnd.github+json"},
            )
            try:
                with urllib.request.urlopen(req, timeout=6) as resp:
                    payload = json.loads(resp.read().decode("utf-8", errors="replace"))
                if isinstance(payload, list) and payload:
                    payload = payload[0]
                if isinstance(payload, dict) and payload.get("tag_name"):
                    data = payload
                else:
                    err_msg = "Release response contained no tag metadata."
            except urllib.error.HTTPError as e:
                err_msg = f"GitHub release check returned HTTP {e.code}."
            except Exception:
                err_msg = "Unable to reach GitHub release metadata (offline or network unavailable)."

        GLib.idle_add(self._apply_release_result, gen, data, err_msg)

    def _apply_release_result(self, gen, data, err_msg):
        if gen != self.check_generation:
            return False
        self.btn_refresh.set_sensitive(not self.is_updating)

        if data is None:
            self.set_banner(
                "warn",
                f"{err_msg} Debian APT updates remain available via Update Now.",
                spinning=False,
            )
            self.lbl_rel_heading.set_text("Debian APT Package Updates Ready")
            self.lbl_rel_meta.set_text(f"Installed: v{self.version_id}")
            self.notes_buffer.set_text(
                "Remote GitHub release notes could not be loaded while offline.\n\n"
                "You can still click Update Now to run APT repository updates and install all available "
                "security and package upgrades cleanly."
            )
            return False

        tag = str(data.get("tag_name") or "").strip()
        rel_name = str(data.get("name") or tag or "BriskOS Release").strip()
        published = str(data.get("published_at") or "")[:10]
        body = str(data.get("body") or "Standard maintenance and security package updates.").strip()

        clean_tag = tag.lstrip("vV")
        self.lbl_rel_heading.set_text(rel_name)
        self.lbl_rel_meta.set_text(f"Published: {published}" if published else tag)
        self.notes_buffer.set_text(body)

        if clean_tag and clean_tag == self.version_id:
            self.set_banner(
                "success",
                f"BriskOS {self.version_id} matches the latest release tag ({tag}). You can still run Update Now for APT package updates.",
                spinning=False,
            )
        else:
            self.set_banner(
                "info",
                f"Release {tag or rel_name} is published on the {self.channel} channel. Click Update Now to apply APT package updates.",
                spinning=False,
            )
        return False

    def append_log_line(self, line):
        end_iter = self.log_buffer.get_end_iter()
        self.log_buffer.insert(end_iter, line + "\n")
        mark = self.log_buffer.create_mark(None, self.log_buffer.get_end_iter(), False)
        self.log_view.scroll_to_mark(mark, 0.0, False, 0.0, 0.0)
        return False

    def on_update_clicked(self, _btn):
        if self.is_updating:
            return

        self.is_updating = True
        self.btn_update.set_sensitive(False)
        self.btn_refresh.set_sensitive(False)
        self.btn_terminal.set_sensitive(False)
        self.btn_close.set_sensitive(False)
        self.log_buffer.set_text("")
        self.progress_bar.set_fraction(0.05)
        self.lbl_step.set_text("Requesting administrator permissions...")
        self.lbl_pct.set_text("5%")
        self.set_banner("info", "System update is in progress. Please keep power connected.", spinning=True)

        threading.Thread(target=self._run_apt_upgrade_worker, daemon=True).start()

    def _run_apt_upgrade_worker(self):
        apt_script = (
            "set -e\n"
            "export DEBIAN_FRONTEND=noninteractive\n"
            "echo '__STEP__:15:Updating APT package lists...'\n"
            "apt-get update -y\n"
            "echo '__STEP__:45:Downloading upgraded packages...'\n"
            "apt-get -y --download-only dist-upgrade\n"
            "echo '__STEP__:75:Installing system updates...'\n"
            "apt-get -y -o Dpkg::Options::='--force-confdef' -o Dpkg::Options::='--force-confold' dist-upgrade\n"
            "echo '__STEP__:92:Cleaning obsolete packages and cache...'\n"
            "apt-get -y autoremove\n"
            "apt-get -y clean\n"
            "echo '__STEP__:100:System update complete.'\n"
        )
        cmd = ["bash", "-c", apt_script]
        if os.geteuid() != 0:
            if shutil.which("pkexec"):
                cmd = ["pkexec"] + cmd
            elif shutil.which("sudo"):
                cmd = ["sudo", "-n"] + cmd

        rc = 1
        last_err = ""
        try:
            proc = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
            )
            for raw_line in iter(proc.stdout.readline, ""):
                line = raw_line.rstrip("\r\n")
                if not line:
                    continue
                if line.startswith("__STEP__:"):
                    parts = line.split(":", 2)
                    if len(parts) == 3:
                        try:
                            pct = max(0, min(100, int(parts[1])))
                        except ValueError:
                            pct = 50
                        step_txt = parts[2]
                        GLib.idle_add(self._set_progress, pct / 100.0, f"{pct}%", step_txt)
                    continue
                last_err = line
                GLib.idle_add(self.append_log_line, line)
            proc.stdout.close()
            rc = proc.wait()
        except Exception as exc:
            last_err = str(exc)
            rc = 1

        GLib.idle_add(self._finish_update, rc, last_err)

    def _set_progress(self, frac, pct_text, step_text):
        self.progress_bar.set_fraction(frac)
        self.lbl_pct.set_text(pct_text)
        self.lbl_step.set_text(step_text)
        return False

    def _finish_update(self, rc, last_err):
        self.is_updating = False
        self.btn_update.set_sensitive(True)
        self.btn_refresh.set_sensitive(True)
        self.btn_terminal.set_sensitive(True)
        self.btn_close.set_sensitive(True)

        if rc == 0:
            self.progress_bar.set_fraction(1.0)
            self.lbl_pct.set_text("100%")
            self.lbl_step.set_text("All available system updates have been installed.")
            self.set_banner("success", "System update completed cleanly.", spinning=False)
            if shutil.which("notify-send"):
                try:
                    subprocess.Popen(
                        ["notify-send", "-a", APP_NAME, "System Update Complete", "BriskOS packages are now up to date."],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                    )
                except Exception:
                    pass
        elif rc in (126, 127):
            self.progress_bar.set_fraction(0.0)
            self.lbl_pct.set_text("")
            self.lbl_step.set_text("Update cancelled (administrator authorization was not granted).")
            self.set_banner("warn", "Authorization cancelled or pkexec unavailable. No packages were modified.", spinning=False)
        else:
            self.lbl_step.set_text("Update stopped with errors. Expand log below for details.")
            self.log_expander.set_expanded(True)
            detail = last_err if last_err else f"Updater exited with status {rc}."
            self.set_banner("error", f"System update failed: {detail}", spinning=False)
        return False

    def on_key_press(self, _win, event):
        if event.keyval == Gdk.KEY_Escape and not self.is_updating:
            self.close()
            return True
        return False

    def on_destroy(self, *_args):
        Gtk.main_quit()


def apply_styling():
    screen = Gdk.Screen.get_default()
    if screen is not None:
        provider = Gtk.CssProvider()
        provider.load_from_data(MORNING_BREEZE_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            screen,
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )


def main():
    if "--terminal" in sys.argv or "-t" in sys.argv or os.environ.get("BRISK_UPDATE_TERMINAL") == "1":
        launch_terminal_updater()
        return

    signal.signal(signal.SIGINT, signal.SIG_DFL)
    GLib.set_prgname(APP_ID)
    GLib.set_application_name(APP_NAME)

    if not Gtk.init_check()[0]:
        print("Error: Unable to initialize GTK3 display.", file=sys.stderr)
        sys.exit(1)

    apply_styling()
    win = BriskUpdaterWindow()
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
