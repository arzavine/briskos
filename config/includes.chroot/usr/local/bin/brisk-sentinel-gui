#!/usr/bin/env bash
# ==============================================================================
# brisk-sentinel-gui: Brisk Power & Battery Sentinel Desktop Control
# Clean Zenity GUI frontend for brisk-sentinel with Morning Breeze Pango colors.
# ==============================================================================
set -euo pipefail

export GDK_BACKEND="wayland,x11"

SENTINEL_CLI="/usr/local/bin/brisk-sentinel"
APP_TITLE_PLAIN="Brisk Sentinel: Power & Battery Manager"

# Telemetry state defaults
PROFILE="balanced"
CAPACITY="0"
STATUS="Unknown"
HEALTH="Unknown"
DISCHARGE_RATE="N/A"
TEMPERATURE="N/A"
REMAINING="N/A"
THRESHOLD="100"
GLIDE_AUTO_ENABLED="false"
GLIDE_THRESHOLD="15"
GLIDE_AUTO_DIM="true"
GLIDE_DIM_LEVEL="35"
GLIDE_DEBOUNCE_SECONDS="3"
GLIDE_NOTIFY="true"
GLIDE_ACTIVE="false"
GLIDE_DAEMON_RUNNING="false"

sanitize_int() {
    local raw="${1:-}"
    local fallback="${2:-0}"
    local digits="${raw//[^0-9]/}"
    if [[ -n "$digits" ]]; then
        printf '%s' "$digits"
    else
        printf '%s' "$fallback"
    fi
}

pango_escape() {
    local text="${1:-}"
    text="${text//&/&amp;}"
    text="${text//</&lt;}"
    text="${text//>/&gt;}"
    printf '%s' "$text"
}

show_error_dialog() {
    local msg="${1:-An unexpected error occurred.}"
    zenity --error \
        --title="$APP_TITLE_PLAIN" \
        --width=440 \
        --text="$(pango_escape "$msg")" 2>/dev/null || true
}

run_sentinel_action() {
    local action_desc="$1"
    shift
    local err_out=""
    if ! err_out="$("$SENTINEL_CLI" "$@" 2>&1)"; then
        if [[ -z "$err_out" ]]; then
            err_out="Command returned non-zero exit status."
        fi
        show_error_dialog "Failed to ${action_desc}: ${err_out}"
        return 1
    fi
    return 0
}

load_kv_output() {
    local raw_data="${1:-}"
    local line key val
    while IFS= read -r line; do
        [[ -z "$line" || "$line" != *=* ]] && continue
        key="${line%%=*}"
        val="${line#*=}"
        key="${key//[[:space:]]/}"
        val="${val%\"}"
        val="${val#\"}"
        val="${val%\'}"
        val="${val#\'}"
        case "$key" in
            PROFILE) PROFILE="$val" ;;
            CAPACITY) CAPACITY="$val" ;;
            STATUS) STATUS="$val" ;;
            HEALTH) HEALTH="$val" ;;
            DISCHARGE_RATE) DISCHARGE_RATE="$val" ;;
            TEMPERATURE) TEMPERATURE="$val" ;;
            REMAINING) REMAINING="$val" ;;
            THRESHOLD) THRESHOLD="$val" ;;
            GLIDE_AUTO_ENABLED) GLIDE_AUTO_ENABLED="$val" ;;
            GLIDE_THRESHOLD) GLIDE_THRESHOLD="$val" ;;
            GLIDE_AUTO_DIM) GLIDE_AUTO_DIM="$val" ;;
            GLIDE_DIM_LEVEL) GLIDE_DIM_LEVEL="$val" ;;
            GLIDE_DEBOUNCE_SECONDS) GLIDE_DEBOUNCE_SECONDS="$val" ;;
            GLIDE_NOTIFY) GLIDE_NOTIFY="$val" ;;
            GLIDE_ACTIVE) GLIDE_ACTIVE="$val" ;;
            GLIDE_DAEMON_RUNNING) GLIDE_DAEMON_RUNNING="$val" ;;
        esac
    done <<< "$raw_data"

    THRESHOLD="$(sanitize_int "$THRESHOLD" "100")"
    GLIDE_THRESHOLD="$(sanitize_int "$GLIDE_THRESHOLD" "15")"
    GLIDE_DIM_LEVEL="$(sanitize_int "$GLIDE_DIM_LEVEL" "35")"
    GLIDE_DEBOUNCE_SECONDS="$(sanitize_int "$GLIDE_DEBOUNCE_SECONDS" "3")"
}

refresh_telemetry() {
    local raw_data=""
    if ! raw_data="$("$SENTINEL_CLI" status --raw 2>/dev/null)"; then
        return 1
    fi
    load_kv_output "$raw_data"

    local glide_raw=""
    if glide_raw="$("$SENTINEL_CLI" glide status --raw 2>/dev/null)"; then
        load_kv_output "$glide_raw"
    fi
    return 0
}

show_diagnostics_dialog() {
    local diag_tmp
    diag_tmp="$(mktemp /tmp/brisk-sentinel-diag.XXXXXX)"
    {
        printf 'Brisk Sentinel Hardware & Battery Diagnostics\n'
        printf '=============================================\n\n'
        if ! "$SENTINEL_CLI" status 2>&1; then
            printf '\n[Warning] brisk-sentinel status exited with an error.\n'
        fi
        if command -v tlp-stat >/dev/null 2>&1; then
            printf '\n--- TLP Battery Status ---\n'
            tlp-stat -b 2>&1 || true
        fi
    } > "$diag_tmp"

    zenity --text-info \
        --title="Battery and Power Diagnostics: Brisk Sentinel" \
        --filename="$diag_tmp" \
        --width=720 \
        --height=500 \
        --ok-label="Close" 2>/dev/null || true

    rm -f "$diag_tmp"
}

show_glide_settings_dialog() {
    while true; do
        refresh_telemetry || true

        local auto_check="[ ]"
        local auto_color="#475569"
        local auto_label="DISABLED"
        local toggle_auto_action="Auto-Switch: Enable Glide"
        local toggle_auto_desc="Automatically switch to Eco mode when battery drops below ${GLIDE_THRESHOLD}%"
        if [[ "$GLIDE_AUTO_ENABLED" == "true" ]]; then
            auto_check="[x]"
            auto_color="#166534"
            auto_label="ENABLED"
            toggle_auto_action="Auto-Switch: Disable Glide"
            toggle_auto_desc="Currently active: auto-switches to Eco below ${GLIDE_THRESHOLD}%"
        fi

        local dim_check="[ ]"
        local dim_color="#475569"
        local dim_desc="Display stays at current brightness; only CPU and hardware power are saved"
        if [[ "$GLIDE_AUTO_DIM" == "true" ]]; then
            dim_check="[x]"
            dim_color="#0C5B73"
            dim_desc="Dims screen to ${GLIDE_DIM_LEVEL}% when Glide activates"
        fi

        local debounce_check="[ ]"
        local debounce_color="#475569"
        local debounce_desc="Instant switching (0s delay)"
        local next_debounce="3"
        if [[ "$GLIDE_DEBOUNCE_SECONDS" -ge 1 ]]; then
            debounce_check="[x]"
            debounce_color="#0C5B73"
            debounce_desc="Anti-flicker guard active (${GLIDE_DEBOUNCE_SECONDS}s delay)"
            next_debounce="0"
        fi

        local daemon_badge="<span color='#9A3412'>Standby</span>"
        if [[ "$GLIDE_DAEMON_RUNNING" == "true" ]]; then
            daemon_badge="<span color='#166534'>Daemon Active</span>"
        fi

        local active_badge=""
        if [[ "$GLIDE_ACTIVE" == "true" ]]; then
            active_badge=" | <span color='#B91C1C'><b>GLIDE ACTIVE NOW</b></span>"
        fi

        local glide_header
        glide_header="<span size='large' weight='bold' color='#0F172A'>Brisk Glide: Smart Low-Battery Failover</span>\n"
        glide_header+="<span color='#475569'>Automatic anti-flicker power failover when battery runs low</span>\n\n"
        glide_header+="<b>Status:</b> <span color='${auto_color}'><b>${auto_label}</b></span> (${daemon_badge})${active_badge}\n"
        glide_header+="<b>Trigger:</b> <span color='#0C5B73'><b>${GLIDE_THRESHOLD}%</b></span>  |  "
        glide_header+="<b>Auto-Dim:</b> <span color='${dim_color}'>${auto_check} $(pango_escape "$dim_desc")</span>\n"
        glide_header+="<b>Debounce:</b> <span color='${debounce_color}'>${debounce_check} $(pango_escape "$debounce_desc")</span>"

        local t20_mark="[ ]" t15_mark="[ ]" t10_mark="[ ]"
        case "$GLIDE_THRESHOLD" in
            20) t20_mark="[x]" ;;
            15) t15_mark="[x]" ;;
            10) t10_mark="[x]" ;;
        esac

        local choice=""
        choice="$(zenity --list \
            --title="Brisk Glide Settings" \
            --text="$glide_header" \
            --radiolist \
            --width=660 \
            --height=460 \
            --ok-label="Apply Setting" \
            --cancel-label="Back" \
            --column="Select" --column="ID" --column="Setting" --column="Details" \
            --hide-column=2 --print-column=2 \
            TRUE  "toggle_auto" "${auto_check} ${toggle_auto_action}" "$toggle_auto_desc" \
            FALSE "thresh_20"   "${t20_mark} Trigger Threshold: 20%" "Activate Eco failover early at 20% remaining charge" \
            FALSE "thresh_15"   "${t15_mark} Trigger Threshold: 15%" "Balanced reserve trigger at 15% remaining charge" \
            FALSE "thresh_10"   "${t10_mark} Trigger Threshold: 10%" "Last-mile emergency trigger at 10% remaining charge" \
            FALSE "toggle_dim"  "${dim_check} Toggle Screen Auto-Dim" "$dim_desc" \
            FALSE "debounce"    "${debounce_check} Toggle Anti-Flicker Debounce" "Switch between 3s stabilization delay and 0s instant mode" \
            FALSE "test_glide"  "Run Glide Transition Test" "Trigger a test check against current battery state" 2>/dev/null)" || return 0

        case "$choice" in
            toggle_auto)
                if [[ "$GLIDE_AUTO_ENABLED" == "true" ]]; then
                    run_sentinel_action "disable Brisk Glide" glide off || true
                else
                    run_sentinel_action "enable Brisk Glide" glide on || true
                fi
                ;;
            thresh_20)
                run_sentinel_action "set Glide threshold to 20%" glide threshold 20 || true
                ;;
            thresh_15)
                run_sentinel_action "set Glide threshold to 15%" glide threshold 15 || true
                ;;
            thresh_10)
                run_sentinel_action "set Glide threshold to 10%" glide threshold 10 || true
                ;;
            toggle_dim)
                run_sentinel_action "toggle Glide auto-dim" glide toggle-dim || true
                ;;
            debounce)
                run_sentinel_action "set Glide debounce to ${next_debounce}s" glide debounce "$next_debounce" || true
                ;;
            test_glide)
                run_sentinel_action "run Glide transition test" glide test || true
                ;;
            *)
                return 0
                ;;
        esac
    done
}

main() {
    if [[ ! -x "$SENTINEL_CLI" ]]; then
        show_error_dialog "Brisk Sentinel CLI was not found at ${SENTINEL_CLI}."
        exit 1
    fi

    while true; do
        local telemetry_ok=1
        if ! refresh_telemetry; then
            telemetry_ok=0
        fi

        local profile_color="#0C5B73"
        local profile_label="Balanced"
        local sel_balanced="FALSE" sel_eco="FALSE" sel_turbo="FALSE"
        case "$PROFILE" in
            eco)
                profile_color="#166534"
                profile_label="Eco (Power Saver)"
                sel_eco="TRUE"
                ;;
            turbo)
                profile_color="#9A3412"
                profile_label="Turbo (Max Performance)"
                sel_turbo="TRUE"
                ;;
            *)
                profile_color="#0C5B73"
                profile_label="Balanced (Adaptive)"
                sel_balanced="TRUE"
                ;;
        esac

        local glide_status_pango="<span color='#475569'>Off</span>"
        if [[ "$GLIDE_AUTO_ENABLED" == "true" ]]; then
            glide_status_pango="<span color='#166534'>On (at ${GLIDE_THRESHOLD}%)</span>"
        fi
        if [[ "$GLIDE_ACTIVE" == "true" ]]; then
            glide_status_pango="<span color='#B91C1C'><b>Active Now</b></span>"
        fi

        local thresh_label="${THRESHOLD}% Cap"
        if [[ "$THRESHOLD" -le 85 ]]; then
            thresh_label="${THRESHOLD}% (Longevity Guard)"
        fi

        local header_pango
        header_pango="<span size='large' weight='bold' color='#0F172A'>Brisk Sentinel: Power &amp; Battery Control</span>\n"
        if [[ "$telemetry_ok" -eq 0 ]]; then
            header_pango+="<span color='#B91C1C'><b>Notice:</b> Unable to read live telemetry from brisk-sentinel. Displaying defaults.</span>\n"
        fi
        header_pango+="<b>Profile:</b> <span color='${profile_color}'><b>$(pango_escape "$profile_label")</b></span>  |  "
        header_pango+="<b>Brisk Glide:</b> ${glide_status_pango}\n"
        header_pango+="<b>Battery:</b> <span color='#0F172A'>$(pango_escape "$CAPACITY")%</span> ($(pango_escape "$STATUS"))  |  "
        header_pango+="<b>Health:</b> $(pango_escape "$HEALTH")  |  "
        header_pango+="<b>Charge Limit:</b> $(pango_escape "$thresh_label")\n"
        header_pango+="<span color='#475569'>Draw: $(pango_escape "$DISCHARGE_RATE")  |  Temp: $(pango_escape "$TEMPERATURE")  |  Remaining: $(pango_escape "$REMAINING")</span>"

        local action=""
        action="$(zenity --list \
            --title="$APP_TITLE_PLAIN" \
            --text="$header_pango" \
            --radiolist \
            --width=700 \
            --height=490 \
            --ok-label="Apply Selection" \
            --cancel-label="Close" \
            --column="Select" --column="ID" --column="Power Mode / Action" --column="Description and Impact" \
            --hide-column=2 --print-column=2 \
            "$sel_balanced" "balanced"  "Balanced Mode" "Adaptive performance scaling and normal thermal limits" \
            "$sel_eco"      "eco"       "Eco Mode" "Extend battery runtime with conservative CPU scaling" \
            "$sel_turbo"    "turbo"     "Turbo Mode" "Prioritize peak clock speeds and high responsiveness" \
            FALSE           "glide"     "Brisk Glide Settings" "Configure automatic low-battery failover (${GLIDE_THRESHOLD}% trigger)" \
            FALSE           "thresh80"  "Battery Longevity (80% Charge Limit)" "Stop charging at 80% to reduce battery wear" \
            FALSE           "thresh100" "Full Charge (100% Charge Limit)" "Allow full 100% charge for travel autonomy" \
            FALSE           "diag"      "Hardware Diagnostics" "Inspect raw battery cells, health, and TLP power logs" \
            FALSE           "refresh"   "Refresh Telemetry" "Re-read live sensor and battery values" 2>/dev/null)" || exit 0

        case "$action" in
            balanced|eco|turbo)
                run_sentinel_action "switch power profile to ${action}" profile "$action" || true
                ;;
            glide)
                show_glide_settings_dialog
                ;;
            thresh80)
                run_sentinel_action "set charge limit to 80%" threshold 80 || true
                ;;
            thresh100)
                run_sentinel_action "set charge limit to 100%" threshold 100 || true
                ;;
            diag)
                show_diagnostics_dialog
                ;;
            refresh)
                continue
                ;;
            "")
                exit 0
                ;;
        esac
    done
}

main "$@"
