BRISK_LINE_3="\033[38;2;255;255;255m█\033[38;2;239;249;254m█\033[38;2;223;244;253m╔\033[38;2;207;239;253m═\033[38;2;192;234;252m═\033[38;2;176;228;252m█\033[38;2;160;223;251m█\033[38;2;144;218;251m╗ \033[38;2;113;208;250m█\033[38;2;97;202;249m█\033[38;2;82;197;248m╔\033[38;2;66;192;248m═\033[38;2;54;187;246m═\033[38;2;50;182;242m█\033[38;2;45;178;238m█\033[38;2;41;173;235m╗ \033[38;2;33;164;227m█\033[38;2;28;160;223m█\033[38;2;24;155;219m║ \033[38;2;16;146;211m╚\033[38;2;11;142;207m═\033[38;2;7;137;204m═\033[38;2;3;133;200m═\033[38;2;3;129;199m═\033[38;2;5;124;201m█\033[38;2;7;120;202m█\033[38;2;9;116;203m║ \033[38;2;14;107;206m█\033[38;2;16;103;207m█\033[38;2;18;99;209m╔\033[38;2;20;95;210m═\033[38;2;22;90;211m█\033[38;2;24;86;213m█\033[38;2;26;82;214m╗ \033[0m"
BRISK_LINE_4="\033[38;2;255;255;255m█\033[38;2;239;249;254m█\033[38;2;223;244;253m█\033[38;2;207;239;253m█\033[38;2;192;234;252m█\033[38;2;176;228;252m█\033[38;2;160;223;251m╔\033[38;2;144;218;251m╝ \033[38;2;113;208;250m█\033[38;2;97;202;249m█\033[38;2;82;197;248m║  \033[38;2;50;182;242m█\033[38;2;45;178;238m█\033[38;2;41;173;235m║ \033[38;2;33;164;227m█\033[38;2;28;160;223m█\033[38;2;24;155;219m║ \033[38;2;16;146;211m█\033[38;2;11;142;207m█\033[38;2;7;137;204m█\033[38;2;3;133;200m█\033[38;2;3;129;199m█\033[38;2;5;124;201m█\033[38;2;7;120;202m█\033[38;2;9;116;203m║ \033[38;2;14;107;206m█\033[38;2;16;103;207m█\033[38;2;18;99;209m║  \033[38;2;24;86;213m█\033[38;2;26;82;214m█\033[38;2;28;78;216m╗\033[0m"
BRISK_LINE_5="\033[38;2;255;255;255m╚\033[38;2;239;249;254m═\033[38;2;223;244;253m═\033[38;2;207;239;253m═\033[38;2;192;234;252m═\033[38;2;176;228;252m═\033[38;2;160;223;251m╝  \033[38;2;113;208;250m╚\033[38;2;97;202;249m═\033[38;2;82;197;248m╝  \033[38;2;50;182;242m╚\033[38;2;45;178;238m═\033[38;2;41;173;235m╝ \033[38;2;33;164;227m╚\033[38;2;28;160;223m═\033[38;2;24;155;219m╝ \033[38;2;16;146;211m╚\033[38;2;11;142;207m═\033[38;2;7;137;204m═\033[38;2;3;133;200m═\033[38;2;3;129;199m═\033[38;2;5;124;201m═\033[38;2;7;120;202m═\033[38;2;9;116;203m╝ \033[38;2;14;107;206m╚\033[38;2;16;103;207m═\033[38;2;18;99;209m╝  \033[38;2;24;86;213m╚\033[38;2;26;82;214m═\033[38;2;28;78;216m╝\033[0m"

SUBTITLE="\033[38;2;148;163;184m${bold}BriskOS 1.0 LTS\033[0m \033[38;2;56;189;248m•\033[0m \033[38;2;203;213;225mFeather Edition\033[0m"
BRISK_SEP="\033[38;2;255;255;255m─\033[38;2;239;249;254m─\033[38;2;223;244;253m─\033[38;2;207;239;253m─\033[38;2;192;234;252m─\033[38;2;176;228;252m─\033[38;2;160;223;251m─\033[38;2;144;218;251m─\033[38;2;129;213;250m─\033[38;2;113;208;250m─\033[38;2;97;202;249m─\033[38;2;82;197;248m─\033[38;2;66;192;248m─\033[38;2;54;187;246m─\033[38;2;50;182;242m─\033[38;2;45;178;238m─\033[38;2;41;173;235m─\033[38;2;37;169;231m─\033[38;2;33;164;227m─\033[38;2;28;160;223m─\033[38;2;24;155;219m─\033[38;2;20;151;215m─\033[38;2;16;146;211m─\033[38;2;11;142;207m─\033[38;2;7;137;204m─\033[38;2;3;133;200m─\033[38;2;3;129;199m─\033[38;2;5;124;201m─\033[38;2;7;120;202m─\033[38;2;9;116;203m─\033[38;2;11;112;205m─\033[38;2;14;107;206m─\033[38;2;16;103;207m─\033[38;2;18;99;209m─\033[38;2;20;95;210m─\033[38;2;22;90;211m─\033[38;2;24;86;213m─\033[38;2;26;82;214m─\033[38;2;28;78;216m─\033[0m"

# ------------------------------------------------------------------------------
# Live System Telemetry Engine
# ------------------------------------------------------------------------------
gather_telemetry() {
    # 1. OS & Distribution
    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        source /etc/os-release
        OS_NAME="${PRETTY_NAME:-BriskOS 1.0 LTS (Feather)}"
    else
        OS_NAME="BriskOS 1.0 LTS (Feather)"
    fi

    # 2. Kernel
    KERNEL_VER="$(uname -r 2>/dev/null || echo '6.1.0-28-amd64')"

    # 3. Host Architecture & Display Session
    ARCH_NAME="$(uname -m 2>/dev/null || echo 'x86_64')"
    if [[ -n "${WAYLAND_DISPLAY:-}" || "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
        HOST_INFO="${ARCH_NAME} (Wayland / Labwc)"
    else
        HOST_INFO="${ARCH_NAME} (Brisk Terminal)"
    fi

    # 4. Uptime
    if [[ -r /proc/uptime ]]; then
        read -r up_raw _ < /proc/uptime
        up_sec=${up_raw%%.*}
        days=$(( up_sec / 86400 ))
        hours=$(( (up_sec % 86400) / 3600 ))
        mins=$(( (up_sec % 3600) / 60 ))
        if (( days > 0 )); then
            UPTIME_STR="${days}d ${hours}h ${mins}m"
        elif (( hours > 0 )); then
            UPTIME_STR="${hours}h ${mins}m"
        else
            UPTIME_STR="${mins}m"
        fi
    else
        UPTIME_STR="2h 15m"
    fi

    # 5. Live Memory from free -m
    if command -v free >/dev/null 2>&1; then
        mem_info=$(free -m 2>/dev/null | awk '/^Mem:/{print $2, $3, $7}')
        if [[ -n "$mem_info" ]]; then
            read -r tot_m used_m avail_m <<< "$mem_info"
            if [[ -n "$avail_m" && "$avail_m" -gt 0 ]]; then
                act_used=$(( tot_m - avail_m ))
            else
                act_used=$used_m
            fi
            pct=$(( act_used * 100 / (tot_m > 0 ? tot_m : 1) ))

            if (( tot_m >= 1024 )); then
                tot_gb=$(awk "BEGIN {printf \"%.1f GB\", $tot_m/1024}")
            else
                tot_gb="${tot_m} MB"
            fi

            if (( act_used >= 1024 )); then
                used_fmt=$(awk "BEGIN {printf \"%.1f GB\", $act_used/1024}")
            else
                used_fmt="${act_used} MB"
            fi
            MEM_STR="${used_fmt} / ${tot_gb} (${pct}%)"
        else
            MEM_STR="184 MB / 16.0 GB (1.1%)"
        fi
    else
        MEM_STR="184 MB / 16.0 GB (1.1%)"
    fi

    # 6. Disk Usage from df -h /
    if command -v df >/dev/null 2>&1; then
        df_out=$(df -h --output=used,size,pcent / 2>/dev/null | tail -n 1)
        if [[ -n "$df_out" ]]; then
            read -r _used _size _pct <<< "$df_out"
            DISK_STR="${_used} / ${_size} (${_pct})"
        else
            DISK_STR=$(df -h / 2>/dev/null | awk 'NR==2 {print $(NF-3) " / " $(NF-4) " (" $(NF-1) ")"}')
        fi
        [[ -z "$DISK_STR" ]] && DISK_STR="4.8G / 64G (8%)"
    else
        DISK_STR="4.8G / 64G (8%)"
    fi

    # 7. Battery / Power Profile State
    # Check /run/brisk/glide-active or brisk-sentinel profile
    if [[ -f /run/brisk/glide-active || -f /run/brisk-glide.active ]]; then
        PROFILE_STR="🍃 Glide Active"
    elif [[ -f /etc/brisk/sentinel-profile ]]; then
        prof=$(tr -d '[:space:]' < /etc/brisk/sentinel-profile 2>/dev/null)
        case "$prof" in
            turbo) PROFILE_STR="⚡ Turbo Active" ;;
            eco) PROFILE_STR="🌱 Eco Active" ;;
            balanced) PROFILE_STR="⚖️ Balanced Active" ;;
            *) PROFILE_STR="⚡ Turbo Active" ;;
        esac
    else
        PROFILE_STR="⚡ Turbo Active"
    fi

    # Check Battery status
    BAT_STR=""
    for b in /sys/class/power_supply/BAT* /sys/class/power_supply/battery; do
        if [[ -d "$b" && -r "$b/capacity" ]]; then
            cap=$(cat "$b/capacity" 2>/dev/null)
            stat=$(cat "$b/status" 2>/dev/null)
            case "$stat" in
                Charging) icon="⚡" ;;
                Discharging) icon="🔋" ;;
                Full) icon="🔌" ;;
                *) icon="🔋" ;;
            esac
            BAT_STR="${cap}% ${icon} (${stat})"
            break
        fi
    done
    if [[ -z "$BAT_STR" ]]; then
        for a in /sys/class/power_supply/AC* /sys/class/power_supply/ADP*; do
            if [[ -d "$a" && -r "$a/online" ]]; then
                online=$(cat "$a/online" 2>/dev/null)
                if [[ "$online" == "1" ]]; then
                    BAT_STR="98% (AC Connected)"
                    break
                fi
            fi
        done
    fi
    [[ -z "$BAT_STR" ]] && BAT_STR="98% (AC Connected)"
}

# ------------------------------------------------------------------------------
# Visual Width Alignment Helper
# Compensates for double-width UTF-8 emojis (⚡, 🍃, 🌱, etc.) in terminal fonts
# ------------------------------------------------------------------------------
calc_vis_width() {
    local text="$1"
    local len=${#text}
    local extra=0
    case "$text" in
        *⚡*|*🍃*|*🌱*|*⚖*|*🔋*|*🔌*) extra=1 ;;
    esac
    echo $(( len + extra ))
}

# ------------------------------------------------------------------------------
# Compact Mode for 'clear' and 'cls'
# ------------------------------------------------------------------------------
render_compact() {
    gather_telemetry
    printf "\n  \033[38;2;56;189;248m▟▀\033[0m %b \033[38;2;71;85;105m──\033[0m %b \033[38;2;71;85;105m──\033[0m %b\n" \
        "\033[38;2;255;255;255;1mBRISK COCKPIT\033[0m \033[38;2;56;189;248m•\033[0m \033[38;2;148;163;184m${OS_NAME}\033[0m" \
        "\033[38;2;203;213;225m${KERNEL_VER}\033[0m" \
        "${cyan_c}${PROFILE_STR}${rst}"
    printf "     \033[38;2;148;163;184mMemory:\033[0m %b  \033[38;2;71;85;105m──\033[0m  \033[38;2;148;163;184mDisk (/):\033[0m %b  \033[38;2;71;85;105m──\033[0m  \033[38;2;148;163;184mBattery:\033[0m %b\n\n" \
        "${cyan_c}${MEM_STR}${rst}" \
        "${val_c}${DISK_STR}${rst}" \
        "${green_c}${BAT_STR}${rst}"
}

# ------------------------------------------------------------------------------
# Full Dual-Column Cockpit Renderer
# ------------------------------------------------------------------------------
render_full() {
    gather_telemetry

    # Render Dual-Column Header
    echo ""
    printf "  %b    %b\n" "$FEATHER_0" "$BRISK_LINE_0"
    printf "  %b    %b\n" "$FEATHER_1" "$BRISK_LINE_1"
    printf "  %b    %b\n" "$FEATHER_2" "$BRISK_LINE_2"
    printf "  %b    %b\n" "$FEATHER_3" "$BRISK_LINE_3"
    printf "  %b    %b\n" "$FEATHER_4" "$BRISK_LINE_4"
    printf "  %b    %b\n" "$FEATHER_5" "$BRISK_LINE_5"
    printf "  %b    %b\n" "$FEATHER_6" "$SUBTITLE"
    printf "  %b    %b\n" "$FEATHER_7" "$BRISK_SEP"
    echo ""

    # System Telemetry Card in Rounded Box
    # Box total width = 70 chars, inner = 64 chars
    local top_border="  ${box_border}╭────────────────────────────────────────────────────────────────────╮${rst}"
    local bot_border="  ${box_border}╰────────────────────────────────────────────────────────────────────╯${rst}"
    local v_border="${box_border}│${rst}"

    print_card_row() {
        local l_label="$1" l_val="$2" l_color="$3"
        local r_label="$4" r_val="$5" r_color="$6"

        local l_vis="${l_label} ${l_val}"
        local r_vis="${r_label} ${r_val}"
        local l_len
        l_len=$(calc_vis_width "$l_vis")
        local r_len
        r_len=$(calc_vis_width "$r_vis")

        local l_pad=$(( 31 - l_len ))
        if (( l_pad < 1 )); then l_pad=1; fi
        local l_spaces
        l_spaces=$(printf '%*s' "$l_pad" '')

        local current_inner=$(( l_len + l_pad + 2 + r_len ))
        local r_pad=$(( 64 - current_inner ))
        if (( r_pad < 0 )); then r_pad=0; fi
        local r_spaces
        r_spaces=$(printf '%*s' "$r_pad" '')

        printf "  %b  ${lbl_c}%s${rst} ${l_color}%s${rst}%s  ${lbl_c}%s${rst} ${r_color}%s${rst}%s  %b\n" \
            "$v_border" "$l_label" "$l_val" "$l_spaces" "$r_label" "$r_val" "$r_spaces" "$v_border"
    }

    echo -e "$top_border"
    print_card_row "OS:" "$OS_NAME" "$val_c" "Kernel:" "$KERNEL_VER" "$val_c"
    print_card_row "Host:" "$HOST_INFO" "$val_c" "Uptime:" "$UPTIME_STR" "$val_c"
    print_card_row "Memory:" "$MEM_STR" "$cyan_c" "Disk (/):" "$DISK_STR" "$val_c"
    print_card_row "Profile:" "$PROFILE_STR" "$cyan_c" "Battery:" "$BAT_STR" "$green_c"

    # Terminal ANSI Palette Swatches Line
    local swatches=""
    for i in 0 1 2 3 4 5 6 7; do
        swatches="${swatches}\033[48;5;${i}m  \033[0m"
    done
    swatches="${swatches} "
    for i in 8 9 10 11 12 13 14 15; do
        swatches="${swatches}\033[48;5;${i}m  \033[0m"
    done

    local pad_palette
    pad_palette=$(printf '%*s' 22 '')
    printf "  %b  ${lbl_c}Palette:${rst} %b%s  %b\n" "$v_border" "$swatches" "$pad_palette" "$v_border"
    echo -e "$bot_border"
    echo ""
}

# ------------------------------------------------------------------------------
# Entrypoint Dispatcher
# ------------------------------------------------------------------------------
case "${1:-}" in
    --compact|-c)
        render_compact
        ;;
    --help|-h)
        echo "Brisk Cockpit - Terminal Greeting Engine & Live Telemetry"
        echo "Usage: brisk-cockpit [OPTIONS]"
        echo ""
        echo "Options:"
        echo "  --compact, -c    Render compact 2-line header for clear/cls"
        echo "  --help, -h       Show this usage manual"
        ;;
    *)
        render_full
        ;;
esac
