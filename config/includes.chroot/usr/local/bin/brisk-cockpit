#!/bin/bash
# ==============================================================================
# Brisk Cockpit - Terminal Greeting Engine & Live System Telemetry
# Morning Breeze Dark Slate Palette (TrueColor ANSI, zero emojis, adaptive layout)
# ==============================================================================

set -u
export LC_ALL="${LC_ALL:-C.UTF-8}"

# ANSI TrueColor tokens (Morning Breeze Slate + Cerulean-Teal + Frost White)
RST="\033[0m"
BOLD="\033[1m"
C_FROST="\033[38;2;241;245;249m"   # #f1f5f9 (14.97:1 on #18202b)
C_SKY="\033[38;2;56;189;248m"      # #38bdf8 (7.66:1)
C_CYAN="\033[38;2;34;211;238m"     # #22d3ee (9.08:1)
C_TEAL="\033[38;2;45;212;191m"     # #2dd4bf (8.81:1)
C_SLATE="\033[38;2;148;163;184m"   # #94a3b8 (6.40:1)
C_RULE="\033[38;2;100;116;139m"    # #64748b (non-text divider)
C_GOOD="\033[38;2;74;222;128m"     # #4ade80 (9.41:1)
C_WARN="\033[38;2;251;191;36m"     # #fbbf24 (9.83:1)

# ------------------------------------------------------------------------------
# Terminal Column Detection ($COLUMNS -> stty -> tput -> 80)
# ------------------------------------------------------------------------------
detect_cols() {
    local cols="${COLUMNS:-}"
    if [[ ! "$cols" =~ ^[0-9]+$ || "$cols" -le 0 ]]; then
        if [[ -r /dev/tty ]]; then
            cols=$(stty size </dev/tty 2>/dev/null | awk '{print $2}')
        fi
    fi
    if [[ ! "$cols" =~ ^[0-9]+$ || "$cols" -le 0 ]]; then
        cols=$(tput cols 2>/dev/null || echo 80)
    fi
    if [[ ! "$cols" =~ ^[0-9]+$ || "$cols" -le 0 ]]; then
        cols=80
    fi
    echo "$cols"
}

# ------------------------------------------------------------------------------
# Live Telemetry Collection (Real system data only, no fabricated defaults)
# ------------------------------------------------------------------------------
gather_telemetry() {
    # 1. OS & Distribution
    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        source /etc/os-release
        OS_NAME="${PRETTY_NAME:-BriskOS 1.0 LTS (Feather)}"
    else
        OS_NAME="BriskOS 1.0 LTS (Feather)"
    fi

    # 2. Kernel
    KERNEL_VER="$(uname -r 2>/dev/null || echo 'Linux')"

    # 3. Hostname, Architecture & Session Type
    local host_node arch_name sess_label
    host_node="$(uname -n 2>/dev/null || echo 'briskos')"
    arch_name="$(uname -m 2>/dev/null || echo 'x86_64')"
    if [[ -n "${WAYLAND_DISPLAY:-}" || "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
        sess_label="Wayland"
    elif [[ -n "${DISPLAY:-}" ]]; then
        sess_label="X11"
    else
        sess_label="Console"
    fi
    HOST_INFO="${host_node} (${arch_name}, ${sess_label})"

    # 4. Uptime & Active Power Profile
    UPTIME_STR="Unavailable"
    if [[ -r /proc/uptime ]]; then
        read -r up_raw _ < /proc/uptime
        local up_sec=${up_raw%%.*}
        local days=$(( up_sec / 86400 ))
        local hours=$(( (up_sec % 86400) / 3600 ))
        local mins=$(( (up_sec % 3600) / 60 ))
        if (( days > 0 )); then
            UPTIME_STR="${days}d ${hours}h ${mins}m"
        elif (( hours > 0 )); then
            UPTIME_STR="${hours}h ${mins}m"
        else
            UPTIME_STR="${mins}m"
        fi
    fi

    local profile_tag=""
    if [[ -f /run/brisk/glide-active || -f /run/brisk-glide.active ]]; then
        profile_tag="Glide"
    elif [[ -r /etc/brisk/sentinel-profile ]]; then
        local prof
        prof=$(tr -d '[:space:]' < /etc/brisk/sentinel-profile 2>/dev/null || true)
        case "$prof" in
            turbo) profile_tag="Turbo" ;;
            eco) profile_tag="Eco" ;;
            balanced) profile_tag="Balanced" ;;
        esac
    fi
    if [[ -n "$profile_tag" ]]; then
        UPTIME_FULL="${UPTIME_STR} (Power: ${profile_tag})"
    else
        UPTIME_FULL="${UPTIME_STR}"
    fi

    # 5. Live Memory from /proc/meminfo (fallback free -m)
    MEM_PCT=0
    MEM_STR="Unavailable"
    MEM_COLOR="$C_SKY"
    if [[ -r /proc/meminfo ]]; then
        local mem_vals
        mem_vals=$(awk '
            /^MemTotal:/ { tot = $2 }
            /^MemAvailable:/ { avail = $2 }
            END {
                if (tot > 0) {
                    used = tot - avail
                    if (used < 0) used = 0
                    printf "%d %d", int(tot / 1024), int(used / 1024)
                }
            }
        ' /proc/meminfo 2>/dev/null || true)
        if [[ -n "$mem_vals" ]]; then
            read -r tot_m act_used <<< "$mem_vals"
            MEM_PCT=$(( act_used * 100 / (tot_m > 0 ? tot_m : 1) ))
            local tot_fmt used_fmt
            if (( tot_m >= 1024 )); then
                tot_fmt=$(awk "BEGIN {printf \"%.1f GB\", $tot_m/1024}")
            else
                tot_fmt="${tot_m} MB"
            fi
            if (( act_used >= 1024 )); then
                used_fmt=$(awk "BEGIN {printf \"%.1f GB\", $act_used/1024}")
            else
                used_fmt="${act_used} MB"
            fi
            MEM_STR="${used_fmt} / ${tot_fmt} (${MEM_PCT}%)"
            if (( MEM_PCT >= 80 )); then
                MEM_COLOR="$C_WARN"
            fi
        fi
    fi

    # 6. Disk Usage for /
    DISK_PCT=0
    DISK_STR="Unavailable"
    DISK_COLOR="$C_FROST"
    if command -v df >/dev/null 2>&1; then
        local df_out
        df_out=$(df -h --output=used,size,pcent / 2>/dev/null | tail -n 1 || true)
        if [[ -n "$df_out" ]]; then
            read -r _used _size _pct <<< "$df_out"
            DISK_STR="${_used} / ${_size} (${_pct})"
            local pct_num="${_pct%%%}"
            if [[ "$pct_num" =~ ^[0-9]+$ ]]; then
                DISK_PCT="$pct_num"
                if (( DISK_PCT >= 85 )); then
                    DISK_COLOR="$C_WARN"
                fi
            fi
        fi
    fi

    # 7. Battery / AC Power Status (strictly from /sys/class/power_supply)
    BAT_STR=""
    BAT_COLOR="$C_GOOD"
    local b cap stat
    for b in /sys/class/power_supply/BAT* /sys/class/power_supply/battery; do
        if [[ -d "$b" && -r "$b/capacity" ]]; then
            cap=$(tr -d '[:space:]' < "$b/capacity" 2>/dev/null || echo "")
            stat=$(tr -d '[:space:]' < "$b/status" 2>/dev/null || echo "Unknown")
            if [[ -n "$cap" ]]; then
                BAT_STR="${cap}% (${stat})"
                if [[ "$cap" =~ ^[0-9]+$ ]] && (( cap <= 20 )) && [[ "$stat" == "Discharging" ]]; then
                    BAT_COLOR="$C_WARN"
                fi
                break
            fi
        fi
    done

    if [[ -z "$BAT_STR" ]]; then
        local a online
        for a in /sys/class/power_supply/AC* /sys/class/power_supply/ADP*; do
            if [[ -d "$a" && -r "$a/online" ]]; then
                online=$(tr -d '[:space:]' < "$a/online" 2>/dev/null || echo "0")
                if [[ "$online" == "1" ]]; then
                    BAT_STR="AC Online (No Battery)"
                    BAT_COLOR="$C_FROST"
                    break
                fi
            fi
        done
    fi
    if [[ -z "$BAT_STR" ]]; then
        BAT_STR="AC Power (Desktop/VM)"
        BAT_COLOR="$C_SLATE"
    fi
}

# ------------------------------------------------------------------------------
# Visual Helpers: Truncation & Proportional Usage Bar
# ------------------------------------------------------------------------------
fit_text() {
    local txt="$1" max_len="$2"
    if (( max_len < 4 )); then
        echo "${txt:0:max_len}"
        return
    fi
    if (( ${#txt} > max_len )); then
        echo "${txt:0:$(( max_len - 3 ))}..."
    else
        echo "$txt"
    fi
}

make_bar() {
    local pct="$1" width="$2" fill_col="$3"
    local filled=$(( (pct * width + 50) / 100 ))
    (( filled < 0 )) && filled=0
    (( filled > width )) && filled=$width
    local empty=$(( width - filled ))
    local bar="${fill_col}"
    local i
    for (( i = 0; i < filled; i++ )); do bar+="━"; done
    bar+="${C_RULE}"
    for (( i = 0; i < empty; i++ )); do bar+="─"; done
    bar+="${RST}"
    printf "%s" "$bar"
}

# ------------------------------------------------------------------------------
# Compact Mode for 'clear' and 'cls'
# ------------------------------------------------------------------------------
render_compact() {
    gather_telemetry
    printf "\n  ${C_SKY}▟▀${RST} ${C_FROST}${BOLD}BRISK${RST} ${C_RULE}|${RST} ${C_FROST}%s${RST} ${C_RULE}|${RST} ${C_SLATE}Kernel${RST} ${C_FROST}%s${RST} ${C_RULE}|${RST} ${C_SLATE}Uptime${RST} ${C_FROST}%s${RST}\n" \
        "$OS_NAME" "$KERNEL_VER" "$UPTIME_FULL"
    printf "     ${C_SLATE}Memory${RST} ${MEM_COLOR}%s${RST} ${C_RULE}|${RST} ${C_SLATE}Disk (/)${RST} ${DISK_COLOR}%s${RST} ${C_RULE}|${RST} ${C_SLATE}Battery${RST} ${BAT_COLOR}%s${RST}\n\n" \
        "$MEM_STR" "$DISK_STR" "$BAT_STR"
}

# ------------------------------------------------------------------------------
# Full Adaptive Side-by-Side Cockpit Renderer (9 lines total)
# LEFT:  Feather + BRISK lettering (39 visible columns)
# RIGHT: Live Device Info (OS, Kernel, Host, Memory, Disk, Battery, Uptime)
# ------------------------------------------------------------------------------
render_full() {
    gather_telemetry
    local cols
    cols=$(detect_cols)

    # Left column: 7 rows, each exactly 39 visible columns wide
    # Feather (10 cols) + 2 spaces + BRISK lettering / subtitle / rule (27 cols)
    local f0="\033[38;2;241;245;249m       ▟▀ \033[0m"
    local f1="\033[38;2;186;230;253m     ▟██  \033[0m"
    local f2="\033[38;2;125;211;252m   ▟███▀  \033[0m"
    local f3="\033[38;2;56;189;248m  ▟▀▟██▀  \033[0m"
    local f4="\033[38;2;14;165;233m ▟█▟███▀  \033[0m"
    local f5="\033[38;2;6;182;212m▟█▟████▀  \033[0m"
    local f6="\033[38;2;20;184;166m▀▀ ▀▀▀▀   \033[0m"

    # Horizontal Frost-White -> Cerulean-Sky -> Cyan -> Teal BRISK lettering (27 cols)
    local b0="\033[38;2;241;245;249m████▄ \033[38;2;186;230;253m████▄ \033[38;2;56;189;248m███ \033[38;2;34;211;238m▄████ \033[38;2;45;212;191m█  ▄▀\033[0m"
    local b1="\033[38;2;241;245;249m█   █ \033[38;2;186;230;253m█   █ \033[38;2;56;189;248m █  \033[38;2;34;211;238m█▄▄   \033[38;2;45;212;191m█▄█▀ \033[0m"
    local b2="\033[38;2;241;245;249m████▄ \033[38;2;186;230;253m████▀ \033[38;2;56;189;248m █  \033[38;2;34;211;238m ▀▀█▄ \033[38;2;45;212;191m██▄  \033[0m"
    local b3="\033[38;2;241;245;249m█   █ \033[38;2;186;230;253m█  █▄ \033[38;2;56;189;248m █  \033[38;2;34;211;238m▄   █ \033[38;2;45;212;191m█ ▀█▄\033[0m"
    local b4="\033[38;2;241;245;249m████▀ \033[38;2;186;230;253m█   █ \033[38;2;56;189;248m███ \033[38;2;34;211;238m████▀ \033[38;2;45;212;191m█  ▀█\033[0m"
    local b5="${C_FROST}${BOLD}BriskOS 1.0 LTS${RST} ${C_SKY}•${RST} ${C_SLATE}Feather${RST}  "
    local b6="\033[38;2;56;189;248m─────────\033[38;2;14;165;233m─────────\033[38;2;20;184;166m─────────\033[0m"

    local left_rows=(
        "${f0}  ${b0}"
        "${f1}  ${b1}"
        "${f2}  ${b2}"
        "${f3}  ${b3}"
        "${f4}  ${b4}"
        "${f5}  ${b5}"
        "${f6}  ${b6}"
    )

    # Stacked fallback ONLY when terminal is narrower than 76 columns
    if (( cols < 76 )); then
        echo ""
        for lr in "${left_rows[@]}"; do
            printf "  %b\n" "$lr"
        done
        printf "  ${C_SLATE}%-8s${RST} ${C_FROST}%s${RST}\n" "OS" "$OS_NAME"
        printf "  ${C_SLATE}%-8s${RST} ${C_FROST}%s${RST}\n" "Kernel" "$KERNEL_VER"
        printf "  ${C_SLATE}%-8s${RST} ${C_FROST}%s${RST}\n" "Host" "$HOST_INFO"
        printf "  ${C_SLATE}%-8s${RST} ${MEM_COLOR}%s${RST}\n" "Memory" "$MEM_STR"
        printf "  ${C_SLATE}%-8s${RST} ${DISK_COLOR}%s${RST}\n" "Disk" "$DISK_STR"
        printf "  ${C_SLATE}%-8s${RST} ${BAT_COLOR}%s${RST}\n" "Battery" "$BAT_STR"
        printf "  ${C_SLATE}%-8s${RST} ${C_FROST}%s${RST}\n\n" "Uptime" "$UPTIME_FULL"
        return
    fi

    # Adaptive side-by-side width math (uses available terminal width up to 114 cols)
    local gutter_str gutter_w lbl_w right_avail max_val_w show_bars=0 bar_w=10
    if (( cols >= 100 )); then
        gutter_str="   ${C_RULE}│${RST}   "
        gutter_w=7
        lbl_w=10
        show_bars=1
    elif (( cols >= 90 )); then
        gutter_str="  ${C_RULE}│${RST}  "
        gutter_w=5
        lbl_w=9
        show_bars=1
    else
        gutter_str=" ${C_RULE}│${RST} "
        gutter_w=3
        lbl_w=8
        show_bars=0
    fi

    local effective_cols=$(( cols > 114 ? 114 : cols ))
    right_avail=$(( effective_cols - 2 - 39 - gutter_w - 1 ))
    max_val_w=$(( right_avail - lbl_w ))

    local r_os r_kern r_host r_mem r_disk r_bat r_up
    r_os=$(fit_text "$OS_NAME" "$max_val_w")
    r_kern=$(fit_text "$KERNEL_VER" "$max_val_w")
    r_host=$(fit_text "$HOST_INFO" "$max_val_w")
    r_bat=$(fit_text "$BAT_STR" "$max_val_w")
    r_up=$(fit_text "$UPTIME_FULL" "$max_val_w")

    local mem_bar="" disk_bar=""
    if (( show_bars == 1 )) && (( max_val_w >= 34 )); then
        local bar_col=25
        if (( bar_col + bar_w + 2 > max_val_w )); then
            bar_col=$(( max_val_w - bar_w - 2 ))
        fi
        r_mem=$(fit_text "$MEM_STR" "$bar_col")
        r_disk=$(fit_text "$DISK_STR" "$bar_col")
        local mem_pad=$(( bar_col - ${#r_mem} + 2 ))
        local disk_pad=$(( bar_col - ${#r_disk} + 2 ))
        (( mem_pad < 2 )) && mem_pad=2
        (( disk_pad < 2 )) && disk_pad=2
        mem_bar="$(printf '%*s' "$mem_pad" '')$(make_bar "$MEM_PCT" "$bar_w" "$MEM_COLOR")"
        disk_bar="$(printf '%*s' "$disk_pad" '')$(make_bar "$DISK_PCT" "$bar_w" "$C_SKY")"
    else
        r_mem=$(fit_text "$MEM_STR" "$max_val_w")
        r_disk=$(fit_text "$DISK_STR" "$max_val_w")
    fi

    local right_rows=(
        "$(printf "${C_SLATE}%-${lbl_w}s${RST}${C_FROST}${BOLD}%s${RST}" "OS" "$r_os")"
        "$(printf "${C_SLATE}%-${lbl_w}s${RST}${C_FROST}%s${RST}" "Kernel" "$r_kern")"
        "$(printf "${C_SLATE}%-${lbl_w}s${RST}${C_FROST}%s${RST}" "Host" "$r_host")"
        "$(printf "${C_SLATE}%-${lbl_w}s${RST}${MEM_COLOR}%s${RST}%s" "Memory" "$r_mem" "$mem_bar")"
        "$(printf "${C_SLATE}%-${lbl_w}s${RST}${DISK_COLOR}%s${RST}%s" "Disk" "$r_disk" "$disk_bar")"
        "$(printf "${C_SLATE}%-${lbl_w}s${RST}${BAT_COLOR}%s${RST}" "Battery" "$r_bat")"
        "$(printf "${C_SLATE}%-${lbl_w}s${RST}${C_FROST}%s${RST}" "Uptime" "$r_up")"
    )

    echo ""
    local idx
    for (( idx = 0; idx < 7; idx++ )); do
        printf "  %b%b%b\n" "${left_rows[$idx]}" "$gutter_str" "${right_rows[$idx]}"
    done
    echo ""
}

# ------------------------------------------------------------------------------
# Entrypoint Dispatcher
# ------------------------------------------------------------------------------
case "${1:-}" in
    --compact|-c)
        render_compact
        ;;
    --help|-h)
        echo "Brisk Cockpit - Terminal Greeting Engine & Live Telemetry"
        echo "Usage: brisk-cockpit [OPTIONS]"
        echo ""
        echo "Options:"
        echo "  --compact, -c    Render compact 2-line header for clear/cls"
        echo "  --help, -h       Show this usage manual"
        ;;
    *)
        render_full
        ;;
esac
