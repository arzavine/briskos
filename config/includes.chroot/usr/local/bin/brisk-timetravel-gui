#!/usr/bin/env bash
# ==============================================================================
# brisk-timetravel-gui: Brisk System Snapshot & Rollback Center
# Clean Zenity GUI frontend for brisk-timetravel with safe cancel handling.
# ==============================================================================
set -euo pipefail

export GDK_BACKEND="wayland,x11"

CLI_BIN="/usr/local/bin/brisk-timetravel"
CONFIG_FILE="/etc/brisk/timetravel.conf"
APP_TITLE="Brisk Time-Travel: Snapshot & Rollback Center"

pango_escape() {
    local text="${1:-}"
    text="${text//&/&amp;}"
    text="${text//</&lt;}"
    text="${text//>/&gt;}"
    printf '%s' "$text"
}

show_error() {
    local msg="${1:-An unexpected error occurred.}"
    zenity --error \
        --title="$APP_TITLE" \
        --width=450 \
        --text="$(pango_escape "$msg")" 2>/dev/null || true
}

show_info() {
    local msg="$1"
    zenity --info \
        --title="$APP_TITLE" \
        --width=440 \
        --text="$(pango_escape "$msg")" 2>/dev/null || true
}

run_with_progress() {
    local title="$1"
    local text="$2"
    shift 2

    local status_file log_file rc=0
    status_file="$(mktemp /tmp/brisk-tt-rc.XXXXXX)"
    log_file="$(mktemp /tmp/brisk-tt-log.XXXXXX)"

    (
        set +e
        "$@" >"$log_file" 2>&1
        printf '%s' "$?" > "$status_file"
    ) | zenity --progress \
        --title="$title" \
        --text="$(pango_escape "$text")" \
        --pulsate \
        --auto-close \
        --no-cancel \
        --width=420 2>/dev/null || true

    wait || true
    if [[ -s "$status_file" ]]; then
        rc="$(cat "$status_file")"
    else
        rc=1
    fi

    local output=""
    if [[ -s "$log_file" ]]; then
        output="$(cat "$log_file")"
    fi
    rm -f "$status_file" "$log_file"

    if [[ "$rc" -ne 0 ]]; then
        LAST_CMD_OUTPUT="$output"
        return "$rc"
    fi
    LAST_CMD_OUTPUT="$output"
    return 0
}

fetch_raw_snapshots() {
    local out=""
    if ! out="$(sudo "$CLI_BIN" list --raw 2>&1)"; then
        show_error "Failed to query snapshots from ${CLI_BIN}: ${out}"
        return 1
    fi
    printf '%s' "$out"
    return 0
}

action_create() {
    local comment=""
    if ! comment="$(zenity --entry \
        --title="Create System Checkpoint" \
        --text="<span weight='bold' color='#0F172A'>Create Instant System Checkpoint</span>\n<span color='#475569'>Enter an optional description for this restore point:</span>" \
        --entry-text="Before system update" \
        --ok-label="Create Checkpoint" \
        --cancel-label="Cancel" \
        --width=460 2>/dev/null)"; then
        return 0
    fi

    if [[ -z "${comment// /}" ]]; then
        comment="Manual snapshot"
    fi

    LAST_CMD_OUTPUT=""
    if run_with_progress \
        "Creating Checkpoint" \
        "Saving system checkpoint '${comment}'. Please wait..." \
        sudo "$CLI_BIN" create "$comment"; then
        show_info "Checkpoint created successfully: ${comment}"
    else
        show_error "Failed to create checkpoint: ${LAST_CMD_OUTPUT:-Unknown error}"
    fi
}

action_delete() {
    local raw_list=""
    if ! raw_list="$(fetch_raw_snapshots)"; then
        return 0
    fi

    if [[ -z "${raw_list//[$'\r\n ']/}" ]]; then
        show_info "No saved checkpoints are available to delete."
        return 0
    fi

    local rows=()
    local first="TRUE"
    local sid sdate stype ssize scomment
    while IFS='|' read -r sid sdate stype ssize scomment; do
        [[ -z "${sid:-}" ]] && continue
        rows+=("$first" "$sid" "${sdate:-Unknown}" "${stype:-manual}" "${ssize:-N/A}" "${scomment:-}")
        first="FALSE"
    done <<< "$raw_list"

    if [[ "${#rows[@]}" -eq 0 ]]; then
        show_info "No valid checkpoints found."
        return 0
    fi

    local to_delete=""
    to_delete="$(zenity --list \
        --title="Delete Checkpoint" \
        --text="<span weight='bold' color='#0F172A'>Select a checkpoint to permanently remove</span>" \
        --radiolist \
        --width=720 \
        --height=420 \
        --ok-label="Delete Selected" \
        --cancel-label="Cancel" \
        --column="Select" --column="ID" --column="Date" --column="Type" --column="Size" --column="Note" \
        --print-column=2 \
        "${rows[@]}" 2>/dev/null)" || return 0

    [[ -z "$to_delete" ]] && return 0

    if ! zenity --question \
        --title="Confirm Checkpoint Deletion" \
        --default-cancel \
        --ok-label="Delete Permanently" \
        --cancel-label="Keep Checkpoint" \
        --width=440 \
        --text="<span weight='bold' color='#B91C1C'>Delete Checkpoint ${to_delete}?</span>\n\nThis frees storage immediately and cannot be undone." 2>/dev/null; then
        return 0
    fi

    LAST_CMD_OUTPUT=""
    if run_with_progress \
        "Deleting Checkpoint" \
        "Removing checkpoint ${to_delete}..." \
        sudo "$CLI_BIN" delete "$to_delete"; then
        show_info "Checkpoint ${to_delete} was deleted."
    else
        show_error "Failed to delete checkpoint ${to_delete}: ${LAST_CMD_OUTPUT:-Unknown error}"
    fi
}

action_restore() {
    local raw_list=""
    if ! raw_list="$(fetch_raw_snapshots)"; then
        return 0
    fi

    if [[ -z "${raw_list//[$'\r\n ']/}" ]]; then
        show_info "No system checkpoints found. Create a checkpoint first before restoring."
        return 0
    fi

    local rows=()
    local first="TRUE"
    local sid sdate stype ssize scomment
    while IFS='|' read -r sid sdate stype ssize scomment; do
        [[ -z "${sid:-}" ]] && continue
        rows+=("$first" "$sid" "${sdate:-Unknown}" "${stype:-manual}" "${ssize:-N/A}" "${scomment:-}")
        first="FALSE"
    done <<< "$raw_list"

    if [[ "${#rows[@]}" -eq 0 ]]; then
        show_info "No restorable checkpoints found."
        return 0
    fi

    local selected_id=""
    selected_id="$(zenity --list \
        --title="Restore System from Checkpoint" \
        --text="<span weight='bold' color='#0F172A'>Select a checkpoint to restore</span>\n<span color='#475569'>Personal files in /home are preserved during rollback.</span>" \
        --radiolist \
        --width=740 \
        --height=440 \
        --ok-label="Continue to Restore" \
        --cancel-label="Cancel" \
        --column="Select" --column="ID" --column="Date" --column="Type" --column="Size" --column="Note" \
        --print-column=2 \
        "${rows[@]}" 2>/dev/null)" || return 0

    [[ -z "$selected_id" ]] && return 0

    if ! zenity --question \
        --title="System Rollback Confirmation" \
        --default-cancel \
        --ok-label="Restore System Now" \
        --cancel-label="Cancel" \
        --width=480 \
        --text="<span weight='bold' color='#9A3412'>SYSTEM ROLLBACK CONFIRMATION</span>\n\nYou are about to roll back system files to checkpoint <b>$(pango_escape "$selected_id")</b>:\n- System packages, /etc, and configuration files revert to that checkpoint\n- Personal user files under /home remain untouched\n- A pre-rollback safety snapshot is recorded automatically\n\nProceed with rollback now?" 2>/dev/null; then
        return 0
    fi

    LAST_CMD_OUTPUT=""
    if run_with_progress \
        "Restoring System Checkpoint" \
        "Restoring system state from checkpoint ${selected_id}. Do not power off..." \
        sudo "$CLI_BIN" restore "$selected_id"; then
        show_info "System rollback to checkpoint ${selected_id} completed. Reboot when ready to load all restored system services."
    else
        show_error "Rollback failed for checkpoint ${selected_id}: ${LAST_CMD_OUTPUT:-Unknown error}"
    fi
}

action_history() {
    local history_tmp
    history_tmp="$(mktemp /tmp/brisk-tt-history.XXXXXX)"
    if ! sudo "$CLI_BIN" list > "$history_tmp" 2>&1; then
        local err_msg
        err_msg="$(cat "$history_tmp")"
        rm -f "$history_tmp"
        show_error "Failed to load snapshot history: ${err_msg:-Permission or CLI error}"
        return 0
    fi

    if [[ ! -s "$history_tmp" ]]; then
        printf 'No snapshots recorded yet.\n' > "$history_tmp"
    fi

    local hist_choice=""
    hist_choice="$(zenity --text-info \
        --title="Snapshot History: Brisk Time-Travel" \
        --filename="$history_tmp" \
        --ok-label="Close" \
        --cancel-label="Back" \
        --extra-button="Delete Checkpoint" \
        --width=740 \
        --height=460 2>/dev/null || true)"

    rm -f "$history_tmp"

    if [[ "$hist_choice" == "Delete Checkpoint" ]]; then
        action_delete
    fi
}

load_config_safe() {
    AUTO_BACKUP_ENABLED="true"
    MAX_SNAPSHOTS="10"
    BACKUP_DIR="/var/backups/brisk-timetravel/snapshots"
    SNAPSHOT_TYPE="auto"

    [[ -r "$CONFIG_FILE" ]] || return 0

    local line key val
    while IFS= read -r line; do
        line="${line%%#*}"
        [[ -z "$line" || "$line" != *=* ]] && continue
        key="${line%%=*}"
        val="${line#*=}"
        key="${key//[[:space:]]/}"
        val="${val%\"}"
        val="${val#\"}"
        val="${val%\'}"
        val="${val#\'}"
        case "$key" in
            AUTO_BACKUP_ENABLED)
                [[ "$val" == "true" || "$val" == "false" ]] && AUTO_BACKUP_ENABLED="$val"
                ;;
            MAX_SNAPSHOTS)
                if [[ "$val" =~ ^[0-9]+$ ]] && [[ "$val" -ge 1 && "$val" -le 50 ]]; then
                    MAX_SNAPSHOTS="$val"
                fi
                ;;
            BACKUP_DIR)
                [[ -n "$val" ]] && BACKUP_DIR="$val"
                ;;
            SNAPSHOT_TYPE)
                [[ -n "$val" ]] && SNAPSHOT_TYPE="$val"
                ;;
        esac
    done < "$CONFIG_FILE"
}

action_settings() {
    load_config_safe

    local form_out=""
    form_out="$(zenity --forms \
        --title="Time-Travel Configuration" \
        --text="<span weight='bold' color='#0F172A'>Brisk Time-Travel Settings</span>\n<span color='#475569'>Current: Auto-Backup=${AUTO_BACKUP_ENABLED}, Max Snapshots=${MAX_SNAPSHOTS}</span>" \
        --add-combo="Auto-Backup before APT Updates" \
        --combo-values="true|false" \
        --add-entry="Max Retained Snapshots (1-50, current: ${MAX_SNAPSHOTS})" \
        --ok-label="Save Settings" \
        --cancel-label="Cancel" \
        --width=460 2>/dev/null)" || return 0

    local new_auto new_max
    IFS='|' read -r new_auto new_max <<< "$form_out"

    if [[ -z "${new_auto:-}" ]]; then
        new_auto="$AUTO_BACKUP_ENABLED"
    fi
    if [[ "$new_auto" != "true" && "$new_auto" != "false" ]]; then
        show_error "Invalid Auto-Backup value '${new_auto}'. Choose true or false."
        return 0
    fi

    if [[ -z "${new_max:-}" ]]; then
        new_max="$MAX_SNAPSHOTS"
    fi
    if ! [[ "$new_max" =~ ^[0-9]+$ ]] || [[ "$new_max" -lt 1 || "$new_max" -gt 50 ]]; then
        show_error "Max Retained Snapshots must be a whole number between 1 and 50."
        return 0
    fi

    local set_err=""
    if ! set_err="$(sudo "$CLI_BIN" set-config "$new_auto" "$new_max" 2>&1)"; then
        show_error "Failed to update ${CONFIG_FILE}: ${set_err:-Permission or validation error.}"
        return 0
    fi

    show_info "Saved Time-Travel settings: Auto-Backup=${new_auto}, Max Snapshots=${new_max}."
}

main() {
    if [[ ! -x "$CLI_BIN" ]]; then
        show_error "Brisk Time-Travel CLI was not found at ${CLI_BIN}."
        exit 1
    fi

    while true; do
        local header_pango
        header_pango="<span size='large' weight='bold' color='#0F172A'>Brisk Time-Travel: System Checkpoints</span>\n"
        header_pango+="<span color='#475569'>Create, inspect, and restore clean system checkpoints with /home preserved.</span>"

        local action=""
        action="$(zenity --list \
            --title="$APP_TITLE" \
            --text="$header_pango" \
            --radiolist \
            --width=660 \
            --height=390 \
            --ok-label="Open Action" \
            --cancel-label="Close" \
            --column="Select" --column="ID" --column="Action" --column="Description" \
            --hide-column=2 --print-column=2 \
            TRUE  "create"   "Create System Checkpoint" "Save a clean restore point right now before changes" \
            FALSE "restore"  "Restore System" "Roll back packages and /etc configuration to a prior checkpoint" \
            FALSE "history"  "Snapshot History" "Browse saved checkpoints or delete old restore points" \
            FALSE "settings" "Time-Travel Settings" "Configure pre-update auto-backup and retention limit" 2>/dev/null)" || exit 0

        case "$action" in
            create)   action_create ;;
            restore)  action_restore ;;
            history)  action_history ;;
            settings) action_settings ;;
            "")       exit 0 ;;
        esac
    done
}

main "$@"
