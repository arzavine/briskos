#!/bin/sh
# ==============================================================================
# BriskOS 1.0 LTS Wayland Session Launcher (invoked by greetd / brisk-greeter)
# ==============================================================================

export XDG_SESSION_TYPE="wayland"
export XDG_CURRENT_DESKTOP="wlroots"
export GDK_BACKEND="wayland,x11"
export QT_QPA_PLATFORM="wayland;xcb"
export MOZ_ENABLE_WAYLAND="1"

enable_software_wlr() {
    export WLR_RENDERER="pixman"
    export WLR_NO_HARDWARE_CURSORS="1"
    export WLR_RENDERER_ALLOW_SOFTWARE="1"
    export LIBGL_ALWAYS_SOFTWARE="1"
}

needs_sw_wlr=0
if grep -qsE '(^|[[:space:]])(brisk\.safe_graphics=1|nomodeset)([[:space:]]|$)' /proc/cmdline 2>/dev/null; then
    needs_sw_wlr=1
elif [ -d /sys/module/vboxvideo ] || [ -d /sys/module/vboxguest ] || [ -d /sys/module/vmwgfx ]; then
    needs_sw_wlr=1
elif grep -qiE 'virtualbox|innotek|oracle|vmware|qemu|kvm|bochs' /sys/class/dmi/id/product_name /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/board_vendor 2>/dev/null; then
    needs_sw_wlr=1
elif command -v systemd-detect-virt >/dev/null 2>&1; then
    virt_type="$(systemd-detect-virt -v 2>/dev/null || true)"
    case "$virt_type" in
        oracle|vmware|qemu|kvm|bochs)
            needs_sw_wlr=1
            ;;
    esac
fi

if [ "$needs_sw_wlr" -eq 1 ]; then
    enable_software_wlr
fi

UID_NUM="$(id -u)"
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    if [ -d "/run/user/${UID_NUM}" ]; then
        export XDG_RUNTIME_DIR="/run/user/${UID_NUM}"
    else
        export XDG_RUNTIME_DIR="/tmp/xdg-runtime-${UID_NUM}"
        mkdir -p -m 0700 "$XDG_RUNTIME_DIR"
    fi
fi

if [ -n "${XDG_SESSION_ID:-}" ] && command -v loginctl >/dev/null 2>&1; then
    loginctl activate "$XDG_SESSION_ID" 2>/dev/null || true
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "${XDG_RUNTIME_DIR}/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi

LOG_FILE="/tmp/brisk-session-${UID_NUM}.log"
echo "=== BriskOS session start $(date -Is 2>/dev/null || date) tty=$(tty 2>/dev/null || echo none) XDG_SESSION_ID=${XDG_SESSION_ID:-} XDG_VTNR=${XDG_VTNR:-} XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-} WLR_RENDERER=${WLR_RENDERER:-auto} DBUS=${DBUS_SESSION_BUS_ADDRESS:-} ===" >>"$LOG_FILE"

attempt=1
while [ "$attempt" -le 3 ]; do
    start_ts="$(date +%s 2>/dev/null || echo 0)"
    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
        dbus-run-session -- labwc >>"$LOG_FILE" 2>&1
        rc=$?
    else
        labwc >>"$LOG_FILE" 2>&1
        rc=$?
    fi
    end_ts="$(date +%s 2>/dev/null || echo 10)"
    elapsed=$((end_ts - start_ts))
    echo "=== labwc attempt=${attempt} rc=${rc} elapsed=${elapsed}s renderer=${WLR_RENDERER:-auto} ===" >>"$LOG_FILE"
    if [ "$rc" -eq 0 ] || [ "$elapsed" -ge 4 ]; then
        exit "$rc"
    fi
    enable_software_wlr
    if [ -n "${XDG_SESSION_ID:-}" ] && command -v loginctl >/dev/null 2>&1; then
        loginctl activate "$XDG_SESSION_ID" 2>/dev/null || true
    fi
    sleep 1
    attempt=$((attempt + 1))
done

exit "${rc:-1}"
