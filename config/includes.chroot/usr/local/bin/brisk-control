    # --------------------------------------------------------------------------
    # Hardware Telemetry Helpers
    # --------------------------------------------------------------------------
    def _get_os_info(self):
        pretty = "BriskOS 1.0 LTS (Feather)"
        try:
            with open("/etc/os-release", "r", encoding="utf-8") as f:
                data = {}
                for line in f:
                    if "=" in line:
                        k, v = line.strip().split("=", 1)
                        data[k] = v.strip('"\'')
                if data.get("PRETTY_NAME"):
                    pretty = data["PRETTY_NAME"]
                codename = data.get("VERSION_CODENAME", "trixie")
                return f"{pretty} • Base Debian ({codename}) amd64"
        except Exception:
            pass
        return "Sistem Operasi Desktop Ringan • Berbasis Debian 13 (Trixie) amd64"

    def _get_cpu_info(self):
        try:
            with open("/proc/cpuinfo", "r", encoding="utf-8") as f:
                for line in f:
                    if "model name" in line:
                        return line.split(":", 1)[1].strip()
        except Exception:
            pass
        return "Prosesor x86_64"

    def _get_ram_info(self):
        try:
            with open("/proc/meminfo", "r", encoding="utf-8") as f:
                for line in f:
                    if "MemTotal" in line:
                        kb = int(line.split()[1])
                        gb = round(kb / (1024 * 1024), 1)
                        return f"{gb} GB RAM"
        except Exception:
            pass
        return "Tidak terdeteksi"

    def _get_gpu_info(self):
        ok, out, _ = self._run_cmd(["lspci"], timeout=3)
        if ok and out:
            for line in out.splitlines():
                if any(tag in line for tag in ("VGA compatible controller:", "3D controller:", "Display controller:")):
                    return line.split(":", 2)[-1].strip()
        return "Wayland DRM Graphics"

    def _get_storage_info(self):
        ok, out, _ = self._run_cmd(["findmnt", "-n", "-o", "FSTYPE,SOURCE", "/"], timeout=3)
        if ok and out:
            parts = out.split(None, 1)
            if len(parts) == 2:
                fstype, src = parts
                note = " (Instant CoW)" if fstype == "btrfs" else ""
                return f"{fstype}{note} • {src}"
            return out
        return "Root Filesystem"

    def _get_kernel_info(self):
        ok, out, _ = self._run_cmd(["uname", "-r"], timeout=3)
        if ok and out:
            return f"Linux {out}"
        return "Linux Kernel"

    def _get_channel_info(self):
        ok, out, _ = self._run_cmd(["/usr/local/bin/brisk-channel", "get", "--raw"], timeout=3)
        if ok and out in ("stable", "beta"):
            return out
        return "stable"

    # --------------------------------------------------------------------------
    # Live System State Loaders
    # --------------------------------------------------------------------------
    def _parse_wlr_randr(self):
        ok, out, _ = self._run_cmd(["wlr-randr", "--json"], timeout=4)
        if ok and out:
            try:
                outputs = json.loads(out)
                chosen = next((o for o in outputs if o.get("enabled")), outputs[0] if outputs else None)
                if chosen:
                    modes = []
                    for m in chosen.get("modes", []):
                        modes.append({
                            "w": int(m.get("width", 1920)),
                            "h": int(m.get("height", 1080)),
                            "hz": int(round(float(m.get("refresh", 60.0)))),
                            "current": bool(m.get("current", False)),
                        })
                    return {
                        "name": chosen.get("name", "eDP-1"),
                        "desc": chosen.get("description") or chosen.get("model") or chosen.get("name", "Wayland Output"),
                        "scale": float(chosen.get("scale", 1.0) or 1.0),
                        "modes": modes,
                    }
            except Exception:
                pass

        ok, out, _ = self._run_cmd(["wlr-randr"], timeout=4)
        if not ok or not out:
            return None
        name = None
        desc = "Wayland Output"
        scale = 1.0
        modes = []
        for line in out.splitlines():
            if line and not line[0].isspace():
                if name is not None:
                    break
                m_hdr = re.match(r'^(\S+)\s*(?:"([^"]*)")?', line)
                if m_hdr:
                    name = m_hdr.group(1)
                    desc = m_hdr.group(2) or name
            elif name is not None:
                m_mode = re.search(r'(\d+)x(\d+)\s+px,\s+([\d.]+)\s+Hz', line)
                if m_mode:
                    modes.append({
                        "w": int(m_mode.group(1)),
                        "h": int(m_mode.group(2)),
                        "hz": int(round(float(m_mode.group(3)))),
                        "current": bool(re.search(r'\([^)]*\bcurrent\b[^)]*\)', line)),
                    })
                m_scale = re.search(r'Scale:\s+([\d.]+)', line)
                if m_scale:
                    scale = float(m_scale.group(1))
        if not name:
            return None
        return {"name": name, "desc": desc, "scale": scale, "modes": modes}

    def _load_display_state(self):
        self.btn_refresh_display.set_sensitive(False)

        def worker():
            info = self._parse_wlr_randr()

            def apply_ui():
                self.btn_refresh_display.set_sensitive(True)
                if not info:
                    self.display_output = None
                    self.lbl_display_desc.set_text("Output Wayland belum aktif atau berjalan di luar sesi compositor")
                    self._set_badge(self.badge_display, "Offline", "badge-warn")
                    self.btn_apply_display.set_sensitive(False)
                    self.combo_res.set_sensitive(False)
                    self.combo_hz.set_sensitive(False)
                    self.scale_100.set_sensitive(False)
                    self.scale_125.set_sensitive(False)
                    self.scale_150.set_sensitive(False)
                    return

                self.display_output = info["name"]
                self.lbl_display_desc.set_text(f"{info['desc']} ({info['name']}) • Wayland DRM")
                self._set_badge(self.badge_display, "Aktif", "badge-active")
                self.btn_apply_display.set_sensitive(True)
                self.combo_res.set_sensitive(True)
                self.combo_hz.set_sensitive(True)
                self.scale_100.set_sensitive(True)
                self.scale_125.set_sensitive(True)
                self.scale_150.set_sensitive(True)

                res_list = []
                hz_list = []
                cur_res = None
                cur_hz = None
                for m in sorted(info["modes"], key=lambda x: (x["w"] * x["h"], x["hz"]), reverse=True):
                    r_str = f"{m['w']}x{m['h']}"
                    if r_str not in res_list:
                        res_list.append(r_str)
                    h_str = f"{m['hz']} Hz"
                    if h_str not in hz_list:
                        hz_list.append(h_str)
                    if m["current"]:
                        cur_res = r_str
                        cur_hz = h_str

                if res_list:
                    self.combo_res.remove_all()
                    for idx, r_str in enumerate(res_list):
                        self.combo_res.append_text(r_str)
                        if r_str == cur_res:
                            self.combo_res.set_active(idx)
                    if self.combo_res.get_active() < 0:
                        self.combo_res.set_active(0)

                if hz_list:
                    hz_sorted = sorted(hz_list, key=lambda s: int(s.split()[0]))
                    self.combo_hz.remove_all()
                    for idx, h_str in enumerate(hz_sorted):
                        self.combo_hz.append_text(h_str)
                        if h_str == cur_hz:
                            self.combo_hz.set_active(idx)
                    if self.combo_hz.get_active() < 0:
                        self.combo_hz.set_active(0)

                sc = round(info["scale"], 2)
                if abs(sc - 1.25) < 0.1:
                    self.scale_125.set_active(True)
                elif sc >= 1.4:
                    self.scale_150.set_active(True)
                else:
                    self.scale_100.set_active(True)

            self._ui(apply_ui)
        self._run_bg(worker)

    def _load_nightlight_state(self):
        cfg_path = os.path.expanduser("~/.config/brisk/nightlight.conf")
        cfg = {"enabled": False, "temp": 4500, "schedule": False}
        try:
            if os.path.exists(cfg_path):
                with open(cfg_path, "r", encoding="utf-8") as f:
                    cfg.update(json.load(f))
        except Exception:
            pass

        running, _, _ = self._run_cmd(["pgrep", "-x", "gammastep"], timeout=2)
        hour = datetime.datetime.now().hour
        sched_due = bool(cfg.get("schedule")) and (hour >= 18 or hour < 6)
        active = running or bool(cfg.get("enabled")) or sched_due

        self._loading_night = True
        self.scale_temp.set_value(max(3500, min(6500, int(cfg.get("temp", 4500)))))
        self.sw_sch.set_active(bool(cfg.get("schedule", False)))
        self.sw_night.set_active(active)
        self._set_badge(self.badge_night, "Aktif" if active else "Nonaktif", "badge-active" if active else "badge-info")
        self._loading_night = False

        if sched_due and not running:
            self._apply_gammastep(True, int(self.scale_temp.get_value()), save=False)

    def _save_nightlight_cfg(self, enabled, temp, schedule):
        cfg_path = os.path.expanduser("~/.config/brisk/nightlight.conf")
        os.makedirs(os.path.dirname(cfg_path), exist_ok=True)
        try:
            with open(cfg_path, "w", encoding="utf-8") as f:
                json.dump({"enabled": bool(enabled), "temp": int(temp), "schedule": bool(schedule)}, f, indent=2)
        except Exception:
            pass

    def _apply_gammastep(self, enabled, temp, save=True):
        if save:
            self._save_nightlight_cfg(enabled, temp, self.sw_sch.get_active())

        def worker():
            self._run_cmd(["pkill", "-x", "gammastep"], timeout=2)
            if not enabled:
                self._ui(self._set_badge, self.badge_night, "Nonaktif", "badge-info")
                return
            try:
                proc = subprocess.Popen(
                    ["gammastep", "-O", str(int(temp))],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.PIPE,
                    start_new_session=True,
                )
                time.sleep(0.25)
                rc = proc.poll()
                if rc is not None and rc != 0:
                    err_msg = ""
                    try:
                        err_msg = proc.stderr.read().decode("utf-8", errors="ignore").strip()
                    except Exception:
                        pass

                    def failed_ui():
                        self._loading_night = True
                        self.sw_night.set_active(False)
                        self._loading_night = False
                        self._set_badge(self.badge_night, "Tidak Didukung", "badge-warn")
                        if save:
                            self._save_nightlight_cfg(False, temp, self.sw_sch.get_active())
                        self._show_dialog(
                            Gtk.MessageType.WARNING,
                            "Night Light Tidak Dapat Dijalankan",
                            err_msg or "Pastikan berjalan di sesi Wayland dengan dukungan wlr-gamma-control.",
                        )
                    self._ui(failed_ui)
                else:
                    self._ui(self._set_badge, self.badge_night, f"Aktif ({int(temp)}K)", "badge-active")
            except FileNotFoundError:
                def missing_ui():
                    self._loading_night = True
                    self.sw_night.set_active(False)
                    self._loading_night = False
                    self._set_badge(self.badge_night, "Gammastep Hilang", "badge-warn")
                    self._show_dialog(
                        Gtk.MessageType.WARNING,
                        "Gammastep Tidak Tersedia",
                        "Paket 'gammastep' tidak ditemukan untuk mengatur Night Light Wayland.",
                    )
                self._ui(missing_ui)
            except Exception as exc:
                self._ui(self._set_badge, self.badge_night, "Kesalahan", "badge-error")
                self._ui(self._show_dialog, Gtk.MessageType.ERROR, "Gagal Menjalankan Night Light", str(exc))
        self._run_bg(worker)

    def _split_nmcli_row(self, line):
        return [p.replace("\\:", ":") for p in re.split(r"(?<!\\):", line)]

    def _refresh_network(self, rescan=False):
        if rescan:
            self.btn_scan.set_sensitive(False)
            self._clear_box(self.wifi_list_box)
            lbl_s = Gtk.Label(label="Memindai jaringan Wi-Fi sekitar...", xalign=0)
            lbl_s.get_style_context().add_class("card-desc")
            self.wifi_list_box.pack_start(lbl_s, False, False, 0)
            self.wifi_list_box.show_all()

        def worker():
            ok_radio, radio_out, err_radio = self._run_cmd(["nmcli", "radio", "wifi"], timeout=4)
            ok_dev, dev_out, _ = self._run_cmd(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device", "status"], timeout=4)
            ok_act, act_out, _ = self._run_cmd(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active"], timeout=4)

            has_nm = ok_radio or ok_dev
            wifi_on = radio_out.strip().lower() == "enabled"
            has_wifi_hw = False
            if ok_dev:
                for line in dev_out.splitlines():
                    parts = self._split_nmcli_row(line)
                    if len(parts) >= 2 and parts[1] == "wifi":
                        has_wifi_hw = True
                        break

            active_name = None
            active_dev = None
            active_type = None
            if ok_act and act_out:
                for line in act_out.splitlines():
                    parts = self._split_nmcli_row(line)
                    if len(parts) >= 3 and parts[1] in ("802-11-wireless", "802-3-ethernet"):
                        active_name, active_type, active_dev = parts[0], parts[1], parts[2]
                        if active_type == "802-11-wireless":
                            break

            ip_addr = ""
            if active_dev:
                ok_ip, ip_out, _ = self._run_cmd(["nmcli", "-g", "IP4.ADDRESS", "device", "show", active_dev], timeout=3)
                if ok_ip and ip_out:
                    ip_addr = ip_out.splitlines()[0].split("/")[0].strip()

            nets = []
            scan_err = ""
            if has_wifi_hw and wifi_on:
                cmd = ["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list"]
                if rescan:
                    cmd.extend(["--rescan", "yes"])
                ok_list, list_out, err_list = self._run_cmd(cmd, timeout=15 if rescan else 5)
                if not ok_list and err_list:
                    scan_err = err_list
                seen = {}
                for line in list_out.splitlines():
                    parts = self._split_nmcli_row(line)
                    if len(parts) < 4:
                        continue
                    in_use = parts[0].strip() == "*"
                    ssid = parts[1].strip()
                    if not ssid:
                        continue
                    try:
                        sig = int(parts[2].strip() or "0")
                    except ValueError:
                        sig = 0
                    sec = parts[3].strip() or "Terbuka"
                    prev = seen.get(ssid)
                    if not prev or in_use or sig > prev["signal"]:
                        seen[ssid] = {"ssid": ssid, "signal": sig, "security": sec, "in_use": in_use}
                nets = sorted(seen.values(), key=lambda x: (not x["in_use"], -x["signal"], x["ssid"].lower()))

            def apply_ui():
                self.btn_scan.set_sensitive(has_nm and has_wifi_hw and wifi_on)
                self._loading_network = True
                self.sw_wifi.set_sensitive(has_nm and has_wifi_hw)
                self.sw_wifi.set_active(wifi_on and has_wifi_hw)
                self._loading_network = False

                self._active_wifi_con = active_name
                self._active_wifi_dev = active_dev

                if not has_nm:
                    self.lbl_cur_net.set_text("NetworkManager Tidak Aktif")
                    self.lbl_cur_net_desc.set_text(err_radio or "Layanan nmcli tidak tersedia di lingkungan ini.")
                    self.btn_disc.set_sensitive(False)
                elif active_name:
                    kind = "Wi-Fi" if active_type == "802-11-wireless" else "Kabel Ethernet"
                    ip_part = f" • IP: {ip_addr}" if ip_addr else ""
                    self.lbl_cur_net.set_text(f"Terhubung: {active_name}")
                    self.lbl_cur_net_desc.set_text(f"{kind} ({active_dev}){ip_part}")
                    self.btn_disc.set_sensitive(True)
                else:
                    self.lbl_cur_net.set_text("Tidak Terhubung (Offline)")
                    self.lbl_cur_net_desc.set_text("Pilih jaringan Wi-Fi di bawah atau sambungkan kabel Ethernet.")
                    self.btn_disc.set_sensitive(False)

                self._clear_box(self.wifi_list_box)
                if not has_nm:
                    lbl = Gtk.Label(label="Layanan jaringan NetworkManager tidak berjalan.", xalign=0)
                    lbl.get_style_context().add_class("card-desc")
                    lbl.set_line_wrap(True)
                    self.wifi_list_box.pack_start(lbl, False, False, 0)
                elif not has_wifi_hw:
                    lbl = Gtk.Label(label="Tidak ada adaptor Wi-Fi terdeteksi pada perangkat ini.", xalign=0)
                    lbl.get_style_context().add_class("card-desc")
                    lbl.set_line_wrap(True)
                    self.wifi_list_box.pack_start(lbl, False, False, 0)
                elif not wifi_on:
                    lbl = Gtk.Label(label="Adaptor Wi-Fi dimatikan. Aktifkan sakelar di atas untuk memindai.", xalign=0)
                    lbl.get_style_context().add_class("card-desc")
                    lbl.set_line_wrap(True)
                    self.wifi_list_box.pack_start(lbl, False, False, 0)
                elif scan_err and not nets:
                    lbl = Gtk.Label(label=f"Gagal memindai Wi-Fi: {scan_err}", xalign=0)
                    lbl.get_style_context().add_class("card-desc")
                    lbl.set_line_wrap(True)
                    self.wifi_list_box.pack_start(lbl, False, False, 0)
                elif not nets:
                    lbl = Gtk.Label(label="Belum ada jaringan Wi-Fi ditemukan di sekitar. Klik Pindai Ulang.", xalign=0)
                    lbl.get_style_context().add_class("card-desc")
                    lbl.set_line_wrap(True)
                    self.wifi_list_box.pack_start(lbl, False, False, 0)
                else:
                    for net in nets:
                        item = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                        item.get_style_context().add_class("sub-row")
                        sec_txt = "Terbuka" if net["security"] in ("", "--", "Terbuka") else net["security"]
                        is_open = sec_txt == "Terbuka"
                        item.pack_start(
                            svg_icon("wifi_open" if is_open else "wifi_lock", color=COLOR_ACCENT_TEXT if net["in_use"] else COLOR_TEXT_SECONDARY, size=18),
                            False, False, 0,
                        )

                        v_i = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                        status_tag = " (Aktif)" if net["in_use"] else ""
                        s_name = Gtk.Label(label=f"{net['ssid']}{status_tag}", xalign=0)
                        s_name.get_style_context().add_class("card-title")
                        s_name.set_ellipsize(Pango.EllipsizeMode.END)
                        s_info = Gtk.Label(label=f"Sinyal {net['signal']}% • {sec_txt}", xalign=0)
                        s_info.get_style_context().add_class("card-desc")
                        v_i.pack_start(s_name, False, False, 0)
                        v_i.pack_start(s_info, False, False, 0)

                        if net["in_use"]:
                            badge = Gtk.Label(label="Terhubung")
                            badge.get_style_context().add_class("badge-active")
                            badge.set_valign(Gtk.Align.CENTER)
                            item.pack_start(v_i, True, True, 0)
                            item.pack_end(badge, False, False, 0)
                        else:
                            btn_c = Gtk.Button(label="Sambungkan")
                            btn_c.get_style_context().add_class("btn-secondary")
                            btn_c.set_valign(Gtk.Align.CENTER)
                            btn_c.connect("clicked", self._on_connect_wifi_dialog, net["ssid"], net["security"])
                            item.pack_start(v_i, True, True, 0)
                            item.pack_end(btn_c, False, False, 0)
                        self.wifi_list_box.pack_start(item, False, False, 0)

                self.wifi_list_box.show_all()

            self._ui(apply_ui)
        self._run_bg(worker)

    def _load_audio_state(self):
        def worker():
            vol_pct = 65
            muted = False
            ok_w, out_w, _ = self._run_cmd(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], timeout=3)
            if ok_w and out_w:
                m = re.search(r'([\d.]+)', out_w)
                if m:
                    vol_pct = max(0, min(100, int(round(float(m.group(1)) * 100))))
                muted = "[MUTED]" in out_w.upper()
            else:
                ok_p, out_p, _ = self._run_cmd(["pactl", "get-sink-volume", "@DEFAULT_SINK@"], timeout=3)
                if ok_p and out_p:
                    m = re.search(r'(\d+)%', out_p)
                    if m:
                        vol_pct = max(0, min(100, int(m.group(1))))
                ok_m, out_m, _ = self._run_cmd(["pactl", "get-sink-mute", "@DEFAULT_SINK@"], timeout=3)
                if ok_m and "yes" in out_m.lower():
                    muted = True

            ok_def, def_sink, _ = self._run_cmd(["pactl", "get-default-sink"], timeout=3)
            def_sink = def_sink.strip() if ok_def else ""

            sinks = []
            ok_sinks, sinks_out, _ = self._run_cmd(["pactl", "list", "sinks"], timeout=4)
            if ok_sinks and sinks_out:
                cur_name = None
                cur_desc = None
                for line in sinks_out.splitlines():
                    s_line = line.strip()
                    if s_line.startswith("Name:"):
                        if cur_name:
                            sinks.append((cur_name, cur_desc or cur_name))
                        cur_name = s_line.split(":", 1)[1].strip()
                        cur_desc = None
                    elif s_line.startswith("Description:") and cur_name:
                        cur_desc = s_line.split(":", 1)[1].strip()
                if cur_name:
                    sinks.append((cur_name, cur_desc or cur_name))

            def apply_ui():
                self._loading_audio = True
                self.scale_vol.set_value(vol_pct)
                self.sw_mute.set_active(muted)
                if muted:
                    self._set_badge(self.lbl_vval, f"{vol_pct}% (Bisu)", "badge-warn")
                else:
                    self._set_badge(self.lbl_vval, f"{vol_pct}%", "badge-info")

                self.combo_out.remove_all()
                self._audio_sinks = sinks
                if not sinks:
                    self.combo_out.append_text("Tidak ada perangkat output terdeteksi")
                    self.combo_out.set_active(0)
                    self.combo_out.set_sensitive(False)
                else:
                    self.combo_out.set_sensitive(True)
                    active_idx = 0
                    for idx, (sname, sdesc) in enumerate(sinks):
                        self.combo_out.append_text(sdesc)
                        if sname == def_sink:
                            active_idx = idx
                    self.combo_out.set_active(active_idx)
                self._loading_audio = False

            self._ui(apply_ui)
        self._run_bg(worker)

    def _get_labwc_rc_path(self, writable=False):
        user_rc = os.path.expanduser("~/.config/labwc/rc.xml")
        if writable:
            return self._seed_user_config("labwc/rc.xml")
        if os.path.exists(user_rc):
            return user_rc
        skel_rc = "/etc/skel/.config/labwc/rc.xml"
        return skel_rc if os.path.exists(skel_rc) else user_rc

    def _load_input_state(self):
        rc_path = self._get_labwc_rc_path(writable=False)
        spd_val = 6
        nat_scroll = True
        tap_click = True
        try:
            if os.path.exists(rc_path):
                root = ET.parse(rc_path).getroot()
                dev = root.find("./libinput/device[@category='default']")
                if dev is None:
                    dev = root.find("./libinput/device")
                if dev is not None:
                    ps = dev.findtext("pointerSpeed")
                    if ps is not None:
                        spd_float = max(-0.8, min(0.8, float(ps.strip())))
                        spd_val = max(1, min(10, int(round((spd_float + 0.8) / 1.6 * 9 + 1))))
                    ns = dev.findtext("naturalScroll")
                    if ns is not None:
                        nat_scroll = ns.strip().lower() in ("yes", "true", "on", "1")
                    tp = dev.findtext("tap")
                    if tp is not None:
                        tap_click = tp.strip().lower() in ("yes", "true", "on", "1")
        except Exception:
            pass

        self._loading_input = True
        self.scale_spd.set_value(spd_val)
        self.sw_nat.set_active(nat_scroll)
        self.sw_tap.set_active(tap_click)
        self._loading_input = False

    def _load_power_state(self):
        def worker():
            ok_s, raw_s, _ = self._run_cmd(["/usr/local/bin/brisk-sentinel", "status", "--raw"], timeout=4)
            ok_g, raw_g, _ = self._run_cmd(["/usr/local/bin/brisk-sentinel", "glide", "status", "--raw"], timeout=4)
            kv = {}
            for block in (raw_s if ok_s else "", raw_g if ok_g else ""):
                for line in block.splitlines():
                    if "=" in line:
                        k, v = line.split("=", 1)
                        kv[k.strip()] = v.strip().strip('"\'')

            def apply_ui():
                self._loading_power = True
                prof = kv.get("PROFILE", "balanced").lower()
                if prof == "eco":
                    self.prof_eco.set_active(True)
                    self._set_badge(self.badge_power, "ECO", "badge-active")
                elif prof == "turbo":
                    self.prof_turb.set_active(True)
                    self._set_badge(self.badge_power, "TURBO", "badge-warn")
                else:
                    self.prof_bal.set_active(True)
                    self._set_badge(self.badge_power, "BALANCED", "badge-info")

                self.sw_gm.set_active(kv.get("GLIDE_AUTO_ENABLED", "true").lower() == "true")
                self.sw_dim.set_active(kv.get("GLIDE_AUTO_DIM", "true").lower() == "true")
                try:
                    thresh = int(kv.get("THRESHOLD", "80"))
                except ValueError:
                    thresh = 80
                self.sw_80.set_active(thresh < 98)

                cap = kv.get("CAPACITY", "--")
                st = kv.get("STATUS", "Unknown")
                health = kv.get("HEALTH", "--")
                if kv:
                    self.lbl_power_hw.set_text(f"Baterai: {cap} ({st}) • Kesehatan: {health} • Profil aktif: {prof.capitalize()}")
                else:
                    self.lbl_power_hw.set_text("Telemetri Brisk Sentinel siap • Kelola profil TLP, Glide Mode, dan batas pengisian.")
                self._loading_power = False

            self._ui(apply_ui)
        self._run_bg(worker)

    def _load_appearance_state(self):
        cfg_path = os.path.expanduser("~/.config/brisk/appearance.conf")
        cfg = {"wallpaper": "default", "taskbar": "islands"}
        try:
            if os.path.exists(cfg_path):
                with open(cfg_path, "r", encoding="utf-8") as f:
                    cfg.update(json.load(f))
            else:
                wb_css = os.path.expanduser("~/.config/waybar/style.css")
                if os.path.exists(wb_css):
                    with open(wb_css, "r", encoding="utf-8") as f:
                        if "BRISK-DOCK-MODE-START" in f.read():
                            cfg["taskbar"] = "dock"
        except Exception:
            pass

        wp_key = cfg.get("wallpaper", "default")
        if wp_key == "midnight":
            wp_key = "slate"
        if wp_key not in self.wp_buttons:
            wp_key = "default"

        self._loading_appearance = True
        self.combo_tb.set_active(1 if cfg.get("taskbar") == "dock" else 0)
        self._update_wp_button_styles(wp_key)
        self._loading_appearance = False

    def _update_wp_button_styles(self, active_key):
        for key, btn in self.wp_buttons.items():
            ctx = btn.get_style_context()
            badge = self.wp_badges.get(key)
            if key == active_key:
                ctx.add_class("active-preset")
                if badge:
                    badge.show()
            else:
                ctx.remove_class("active-preset")
                if badge:
                    badge.hide()

    def _load_timetravel_state(self):
        def worker():
            auto_on = True
            if os.path.exists("/etc/brisk/timetravel.conf"):
                try:
                    with open("/etc/brisk/timetravel.conf", "r", encoding="utf-8") as f:
                        txt = f.read()
                    if re.search(r'^AUTO_BACKUP_ENABLED=false\b', txt, re.M):
                        auto_on = False
                except Exception:
                    pass

            cli_bin = "/usr/local/bin/brisk-timetravel"
            if not os.path.exists(cli_bin):
                ok, out, err = False, "", "Utilitas brisk-timetravel tidak terpasang."
            elif os.geteuid() == 0:
                ok, out, err = self._run_cmd([cli_bin, "list", "--raw"], timeout=5)
            else:
                ok, out, err = self._run_cmd(["sudo", "-n", cli_bin, "list", "--raw"], timeout=5)

            lines = [ln for ln in out.splitlines() if ln.strip()] if ok and out else []

            def apply_ui():
                self._clear_box(self.tt_list_box)
                auto_txt = "Auto-Checkpoint aktif" if auto_on else "Auto-Checkpoint nonaktif"

                if not ok:
                    self._set_badge(self.badge_tt, "Perlu Izin / Error", "badge-error")
                    self.lbl_tt_desc.set_text(err or f"Tidak dapat membaca daftar snapshot • {auto_txt}")
                    msg_lbl = Gtk.Label(
                        label="Daftar checkpoint tidak dapat diakses saat ini. Gunakan Wizard Time-Travel atau klik Buat Snapshot Baru.",
                        xalign=0,
                    )
                    msg_lbl.get_style_context().add_class("card-desc")
                    msg_lbl.set_line_wrap(True)
                    self.tt_list_box.pack_start(msg_lbl, False, False, 0)
                elif lines:
                    parsed = [ln.split("|") for ln in lines]
                    latest = parsed[-1]
                    latest_date = latest[1] if len(latest) > 1 else latest[0]
                    self._set_badge(self.badge_tt, "Terlindungi", "badge-active")
                    self.lbl_tt_desc.set_text(f"{len(lines)} titik pemulihan tersedia • Terbaru: {latest_date} • {auto_txt}")

                    for parts in reversed(parsed[-4:]):
                        sid = parts[0]
                        sdate = parts[1] if len(parts) > 1 else "-"
                        stype = parts[2] if len(parts) > 2 else "-"
                        ssize = parts[3] if len(parts) > 3 else "-"
                        scomment = parts[4] if len(parts) > 4 else "Checkpoint sistem"

                        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                        row.get_style_context().add_class("sub-row")
                        row.pack_start(svg_icon("timetravel", color=COLOR_ACCENT_TEXT, size=18), False, False, 0)

                        v_s = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                        t_lbl = Gtk.Label(label=f"{scomment}", xalign=0)
                        t_lbl.get_style_context().add_class("card-title")
                        t_lbl.set_ellipsize(Pango.EllipsizeMode.END)
                        d_lbl = Gtk.Label(label=f"ID: {sid} • {sdate} • {stype.upper()} ({ssize})", xalign=0)
                        d_lbl.get_style_context().add_class("card-desc")
                        v_s.pack_start(t_lbl, False, False, 0)
                        v_s.pack_start(d_lbl, False, False, 0)
                        row.pack_start(v_s, True, True, 0)
                        self.tt_list_box.pack_start(row, False, False, 0)
                else:
                    self._set_badge(self.badge_tt, "Belum Ada Snapshot", "badge-warn")
                    self.lbl_tt_desc.set_text(f"Belum ada snapshot tersimpan • {auto_txt}")
                    empty_lbl = Gtk.Label(
                        label="Belum ada titik pemulihan tersimpan. Klik 'Buat Snapshot Baru' untuk mencadangkan kondisi sistem saat ini.",
                        xalign=0,
                    )
                    empty_lbl.get_style_context().add_class("card-desc")
                    empty_lbl.set_line_wrap(True)
                    self.tt_list_box.pack_start(empty_lbl, False, False, 0)

                self.tt_list_box.show_all()

            self._ui(apply_ui)
        self._run_bg(worker)

    # --------------------------------------------------------------------------
    # Event Handlers, Keyboard Shortcuts & Signals
    # --------------------------------------------------------------------------
    def _on_window_key_press(self, widget, event):
        ctrl = bool(event.state & Gdk.ModifierType.CONTROL_MASK)
        if ctrl and event.keyval in (Gdk.KEY_f, Gdk.KEY_F):
            self.search_entry.grab_focus()
            return True
        return False

    def _on_search_key_press(self, entry, event):
        if event.keyval == Gdk.KEY_Escape:
            if entry.get_text():
                entry.set_text("")
            row = self.nav_list.get_selected_row() or self.nav_list.get_row_at_index(0)
            if row:
                row.grab_focus()
            return True
        return False

    def _on_nav_selected(self, listbox, row):
        if row and hasattr(row, "cat_id"):
            self._active_cat_id = row.cat_id
            self.stack.set_visible_child_name(row.cat_id)
        for r in self.nav_list.get_children():
            if hasattr(r, "icon_img") and hasattr(r, "icon_name"):
                is_sel = (r == row)
                color = COLOR_ACCENT if is_sel else COLOR_TEXT_SECONDARY
                pb = svg_pixbuf(r.icon_name, color=color, size=18)
                if pb is not None:
                    r.icon_img.set_from_pixbuf(pb)

    def _on_search_changed(self, entry):
        query = entry.get_text().strip().lower()
        visible_count = 0
        for row in self.nav_list.get_children():
            title = getattr(row, "cat_title", "").lower()
            cid = getattr(row, "cat_id", "").lower()
            if not query or query in title or query in cid:
                row.show()
                visible_count += 1
            else:
                row.hide()
        if visible_count == 0:
            self.sidebar_empty_lbl.show()
        else:
            self.sidebar_empty_lbl.hide()

    def _on_apply_display(self, btn):
        if not self.display_output:
            self._show_dialog(Gtk.MessageType.WARNING, "Tidak Ada Output Wayland", "Tidak ada monitor Wayland aktif yang terdeteksi dari wlr-randr.")
            return

        res_text = self.combo_res.get_active_text() or "1920x1080"
        hz_text = self.combo_hz.get_active_text() or "60 Hz"
        res_mode = res_text.split()[0]
        hz_num = hz_text.split()[0]
        scale = "1.0"
        if self.scale_125.get_active():
            scale = "1.25"
        elif self.scale_150.get_active():
            scale = "1.5"

        out_name = self.display_output
        self.btn_apply_display.set_sensitive(False)

        def worker():
            ok, _, err = self._run_cmd(["wlr-randr", "--output", out_name, "--mode", f"{res_mode}@{hz_num}Hz", "--scale", scale], timeout=6)
            if not ok:
                ok, _, err2 = self._run_cmd(["wlr-randr", "--output", out_name, "--mode", res_mode, "--scale", scale], timeout=6)
                if not ok and err2:
                    err = err2

            def done():
                self.btn_apply_display.set_sensitive(True)
                if ok:
                    self._show_dialog(
                        Gtk.MessageType.INFO,
                        "Pengaturan Layar Diterapkan",
                        f"Output: {out_name}\nResolusi: {res_mode}\nRefresh Rate: {hz_num} Hz\nSkala: {scale}x",
                    )
                    self._load_display_state()
                else:
                    self._show_dialog(
                        Gtk.MessageType.ERROR,
                        "Gagal Menerapkan Pengaturan Layar",
                        err or "Compositor menolak mode layar yang dipilih.",
                    )
            self._ui(done)
        self._run_bg(worker)

    def _on_nightlight_toggle(self, switch, state):
        if self._loading_night:
            return False
        self._apply_gammastep(bool(state), int(self.scale_temp.get_value()), save=True)
        return False

    def _on_temp_changed(self, scale):
        if self._loading_night:
            return
        if self._temp_debounce_id:
            GLib.source_remove(self._temp_debounce_id)
        val = int(scale.get_value())

        def fire():
            self._temp_debounce_id = None
            active = self.sw_night.get_active()
            if active:
                self._apply_gammastep(True, val, save=True)
            else:
                self._save_nightlight_cfg(False, val, self.sw_sch.get_active())
            return False

        self._temp_debounce_id = GLib.timeout_add(180, fire)

    def _on_schedule_toggle(self, switch, state):
        if self._loading_night:
            return False
        temp = int(self.scale_temp.get_value())
        self._save_nightlight_cfg(self.sw_night.get_active(), temp, bool(state))
        if state:
            hour = datetime.datetime.now().hour
            should_on = (hour >= 18 or hour < 6)
            if should_on != self.sw_night.get_active():
                self.sw_night.set_active(should_on)
        return False

    def _on_wifi_switch(self, switch, state):
        if self._loading_network:
            return False
        self.sw_wifi.set_sensitive(False)
        action = "on" if state else "off"

        def worker():
            ok, _, err = self._run_cmd(["nmcli", "radio", "wifi", action], timeout=8)

            def done():
                self.sw_wifi.set_sensitive(True)
                if not ok:
                    self._show_dialog(Gtk.MessageType.ERROR, "Gagal Mengubah Status Wi-Fi", err or "Perintah nmcli gagal dijalankan.")
                self._refresh_network(rescan=bool(state))
            self._ui(done)
        self._run_bg(worker)
        return False

    def _on_disconnect_wifi(self, btn):
        if not self._active_wifi_con:
            return
        con_name = self._active_wifi_con
        self.btn_disc.set_sensitive(False)

        def worker():
            ok, _, err = self._run_cmd(["nmcli", "connection", "down", "id", con_name], timeout=8)

            def done():
                if not ok:
                    self._show_dialog(Gtk.MessageType.ERROR, "Gagal Memutuskan Koneksi", err or f"Tidak dapat memutus {con_name}.")
                self._refresh_network(rescan=False)
            self._ui(done)
        self._run_bg(worker)

    def _on_scan_wifi(self, btn):
        self._refresh_network(rescan=True)

    def _connect_wifi_async(self, ssid, password=None):
        self.btn_scan.set_sensitive(False)
        self.lbl_cur_net.set_text(f"Menyambungkan ke {ssid}...")
        self.lbl_cur_net_desc.set_text("Menunggu autentikasi dari NetworkManager...")

        def worker():
            cmd = ["nmcli", "dev", "wifi", "connect", ssid]
            if password:
                cmd.extend(["password", password])
            ok, out, err = self._run_cmd(cmd, timeout=25)

            def done():
                if ok:
                    self._show_dialog(Gtk.MessageType.INFO, "Wi-Fi Terhubung", f"Berhasil tersambung ke {ssid}.")
                else:
                    self._show_dialog(Gtk.MessageType.ERROR, f"Gagal Terhubung ke {ssid}", err or out or "Periksa kata sandi atau sinyal Wi-Fi.")
                self._refresh_network(rescan=False)
            self._ui(done)
        self._run_bg(worker)

    def _on_connect_wifi_dialog(self, btn, ssid, security=""):
        sec_upper = (security or "").upper()
        if not sec_upper or sec_upper in ("--", "TERBUKA", "NONE"):
            self._connect_wifi_async(ssid, None)
            return

        dialog = Gtk.Dialog(
            title=f"Sambungkan ke {ssid}",
            transient_for=self,
            modal=True,
        )
        dialog.set_default_size(400, 190)
        cancel_btn = dialog.add_button("Batal", Gtk.ResponseType.CANCEL)
        ok_btn = dialog.add_button("Sambungkan", Gtk.ResponseType.OK)
        cancel_btn.get_style_context().add_class("btn-secondary")
        ok_btn.get_style_context().add_class("btn-primary")
        dialog.set_default_response(Gtk.ResponseType.OK)

        content = dialog.get_content_area()
        content.set_spacing(10)
        content.set_border_width(16)

        lbl = Gtk.Label(label=f"Masukkan kata sandi Wi-Fi ({security}) untuk {ssid}:", xalign=0)
        lbl.get_style_context().add_class("card-title")
        lbl.set_line_wrap(True)

        pwd = Gtk.Entry()
        pwd.set_visibility(False)
        pwd.set_activates_default(True)

        chk_show = Gtk.CheckButton(label="Tampilkan kata sandi")
        chk_show.connect("toggled", lambda c: pwd.set_visibility(c.get_active()))

        content.pack_start(lbl, False, False, 0)
        content.pack_start(pwd, False, False, 0)
        content.pack_start(chk_show, False, False, 0)
        dialog.show_all()

        resp = dialog.run()
        password = pwd.get_text()
        dialog.destroy()

        if resp == Gtk.ResponseType.OK:
            if not password:
                self._show_dialog(Gtk.MessageType.WARNING, "Sandi Kosong", "Masukkan kata sandi jaringan Wi-Fi terlebih dahulu.")
                return
            self._connect_wifi_async(ssid, password)

    def _update_vol_badge(self, val, muted):
        if muted:
            self._set_badge(self.lbl_vval, f"{val}% (Bisu)", "badge-warn")
        else:
            self._set_badge(self.lbl_vval, f"{val}%", "badge-info")

    def _on_volume_changed(self, scale):
        val = int(scale.get_value())
        self._update_vol_badge(val, self.sw_mute.get_active())
        if self._loading_audio:
            return
        if self._vol_debounce_id:
            GLib.source_remove(self._vol_debounce_id)

        def apply_vol():
            self._vol_debounce_id = None

            def worker():
                ok, _, _ = self._run_cmd(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{val}%"], timeout=2)
                if not ok:
                    self._run_cmd(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{val}%"], timeout=2)
            self._run_bg(worker)
            return False

        self._vol_debounce_id = GLib.timeout_add(60, apply_vol)

    def _on_mute_toggled(self, switch, state):
        val = int(self.scale_vol.get_value())
        self._update_vol_badge(val, bool(state))
        if self._loading_audio:
            return False
        flag = "1" if state else "0"

        def worker():
            ok, _, _ = self._run_cmd(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", flag], timeout=2)
            if not ok:
                self._run_cmd(["pactl", "set-sink-mute", "@DEFAULT_SINK@", flag], timeout=2)
        self._run_bg(worker)
        return False

    def _on_output_changed(self, combo):
        if self._loading_audio:
            return
        idx = combo.get_active()
        if idx < 0 or idx >= len(self._audio_sinks):
            return
        sink_name = self._audio_sinks[idx][0]

        def worker():
            ok, _, err = self._run_cmd(["pactl", "set-default-sink", sink_name], timeout=4)
            if not ok:
                self._ui(self._show_dialog, Gtk.MessageType.ERROR, "Gagal Mengganti Output Audio", err or sink_name)
        self._run_bg(worker)

    def _on_test_stereo(self, btn):
        btn.set_sensitive(False)
        btn.set_label("Memutar Nada...")

        def worker():
            if shutil.which("speaker-test"):
                ok, _, err = self._run_cmd(["speaker-test", "-t", "sine", "-f", "440", "-c", "2", "-l", "1"], timeout=10)
            elif shutil.which("paplay") and os.path.exists("/usr/share/sounds/freedesktop/stereo/bell.oga"):
                ok, _, err = self._run_cmd(["paplay", "/usr/share/sounds/freedesktop/stereo/bell.oga"], timeout=6)
            else:
                ok, err = False, "Utilitas uji suara ('speaker-test' atau 'paplay') tidak tersedia."

            def done():
                btn.set_label("Tes Stereo")
                btn.set_sensitive(True)
                if not ok:
                    self._show_dialog(
                        Gtk.MessageType.WARNING,
                        "Tes Audio Gagal",
                        err or "Pastikan utilitas 'speaker-test' (alsa-utils) dan PipeWire aktif.",
                    )
            self._ui(done)
        self._run_bg(worker)

    def _write_input_settings(self):
        spd_slider = self.scale_spd.get_value()
        ptr_speed = round(((spd_slider - 1.0) / 9.0) * 1.6 - 0.8, 2)
        nat_val = "yes" if self.sw_nat.get_active() else "no"
        tap_val = "yes" if self.sw_tap.get_active() else "no"
        self._set_badge(self.lbl_input_status, "Menyimpan...", "badge-info")

        def worker():
            try:
                rc_path = self._get_labwc_rc_path(writable=True)
                if os.path.exists(rc_path):
                    tree = ET.parse(rc_path)
                    root = tree.getroot()
                else:
                    root = ET.Element("labwc_config")
                    tree = ET.ElementTree(root)

                libinput = root.find("libinput")
                if libinput is None:
                    libinput = ET.SubElement(root, "libinput")
                dev = libinput.find("./device[@category='default']")
                if dev is None:
                    dev = ET.SubElement(libinput, "device", {"category": "default"})

                for tag, text_val in [("pointerSpeed", str(ptr_speed)), ("naturalScroll", nat_val), ("tap", tap_val)]:
                    el = dev.find(tag)
                    if el is None:
                        el = ET.SubElement(dev, tag)
                    el.text = text_val

                ET.indent(tree, space="  ")
                tmp_path = f"{rc_path}.tmp"
                tree.write(tmp_path, encoding="utf-8", xml_declaration=True)
                os.replace(tmp_path, rc_path)
                self._run_cmd(["labwc", "--reconfigure"], timeout=3)
                self._ui(self._set_badge, self.lbl_input_status, "Tersimpan", "badge-active")
            except Exception as exc:
                self._ui(self._set_badge, self.lbl_input_status, "Gagal", "badge-error")
                self._ui(self._show_dialog, Gtk.MessageType.ERROR, "Gagal Menyimpan Pengaturan Input", str(exc))
        self._run_bg(worker)

    def _on_input_slider_changed(self, scale):
        if self._loading_input:
            return
        if self._input_debounce_id:
            GLib.source_remove(self._input_debounce_id)

        def fire():
            self._input_debounce_id = None
            self._write_input_settings()
            return False
        self._input_debounce_id = GLib.timeout_add(180, fire)

    def _on_input_switch_changed(self, switch, state):
        if self._loading_input:
            return False
        GLib.idle_add(lambda: (self._write_input_settings(), False)[1])
        return False

    def _run_sentinel(self, args, reload_after=True):
        cli_bin = "/usr/local/bin/brisk-sentinel"
        cmd = [cli_bin] + args if os.geteuid() == 0 else ["sudo", "-n", cli_bin] + args

        def worker():
            ok, out, err = self._run_cmd(cmd, timeout=10)
            if not ok and os.geteuid() != 0 and shutil.which("pkexec"):
                ok, out, err = self._run_cmd(["pkexec", cli_bin] + args, timeout=15)

            def done():
                if not ok:
                    self._show_dialog(Gtk.MessageType.ERROR, "Gagal Mengubah Pengaturan Daya", err or out or "Periksa izin brisk-sentinel.")
                if reload_after:
                    self._load_power_state()
            self._ui(done)
        self._run_bg(worker)

    def _on_power_profile_toggled(self, btn, mode):
        if self._loading_power or not btn.get_active():
            return
        self._run_sentinel(["profile", mode])

    def _on_glide_toggle(self, switch, state):
        if self._loading_power:
            return False
        self._run_sentinel(["glide", "on" if state else "off"])
        return False

    def _on_glide_dim_toggle(self, switch, state):
        if self._loading_power:
            return False
        desired = "true" if state else "false"
        cli_bin = "/usr/local/bin/brisk-sentinel"

        def worker():
            ok_g, raw_g, _ = self._run_cmd([cli_bin, "glide", "status", "--raw"], timeout=4)
            cur = "true"
            if ok_g:
                for line in raw_g.splitlines():
                    if line.startswith("GLIDE_AUTO_DIM="):
                        cur = line.split("=", 1)[1].strip().strip('"\'').lower()
                        break
            if cur != desired:
                cmd = [cli_bin, "glide", "toggle-dim"] if os.geteuid() == 0 else ["sudo", "-n", cli_bin, "glide", "toggle-dim"]
                ok, out, err = self._run_cmd(cmd, timeout=10)
                if not ok and os.geteuid() != 0 and shutil.which("pkexec"):
                    ok, out, err = self._run_cmd(["pkexec", cli_bin, "glide", "toggle-dim"], timeout=15)
                if not ok:
                    self._ui(self._show_dialog, Gtk.MessageType.ERROR, "Gagal Mengubah Peredupan Glide", err or out or "Periksa izin brisk-sentinel.")
                self._ui(self._load_power_state)
        self._run_bg(worker)
        return False

    def _on_battery_ceiling_toggle(self, switch, state):
        if self._loading_power:
            return False
        self._run_sentinel(["threshold", "80" if state else "100"])
        return False

    def _on_open_sentinel_gui(self, btn):
        try:
            subprocess.Popen(["/usr/local/bin/brisk-sentinel-gui"], start_new_session=True)
        except Exception as exc:
            self._show_dialog(Gtk.MessageType.ERROR, "Gagal Membuka Brisk Sentinel", str(exc))

    def _save_appearance_cfg(self, **updates):
        cfg_path = os.path.expanduser("~/.config/brisk/appearance.conf")
        os.makedirs(os.path.dirname(cfg_path), exist_ok=True)
        cfg = {"wallpaper": "default", "taskbar": "islands"}
        try:
            if os.path.exists(cfg_path):
                with open(cfg_path, "r", encoding="utf-8") as f:
                    cfg.update(json.load(f))
        except Exception:
            pass
        cfg.update(updates)
        try:
            with open(cfg_path, "w", encoding="utf-8") as f:
                json.dump(cfg, f, indent=2)
        except Exception:
            pass

    def _on_select_wallpaper(self, btn, wp_key):
        if self._loading_appearance:
            return
        self._update_wp_button_styles(wp_key)
        self._save_appearance_cfg(wallpaper=wp_key)

        def worker():
            self._run_cmd(["pkill", "-x", "swaybg"], timeout=3)
            wp_svg = "/usr/share/backgrounds/briskos/brisk-default.svg"
            if wp_key == "default" and os.path.exists(wp_svg):
                sway_args = ["-i", wp_svg, "-m", "fill"]
                autostart_block = f'swaybg -i "{wp_svg}" -m fill &'
            elif wp_key == "mist":
                sway_args = ["-c", "#DCECF2"]
                autostart_block = "swaybg -c '#DCECF2' &"
            else:
                sway_args = ["-c", "#1E293B"]
                autostart_block = "swaybg -c '#1E293B' &"

            try:
                subprocess.Popen(
                    ["swaybg"] + sway_args,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
            except Exception:
                pass

            try:
                autostart_path = self._seed_user_config("labwc/autostart")
                if os.path.exists(autostart_path):
                    with open(autostart_path, "r", encoding="utf-8") as f:
                        txt = f.read()
                    new_txt = re.sub(
                        r'# 1\. Desktop Wallpaper Daemon.*?# 2\. Status Bar',
                        f'# 1. Desktop Wallpaper Daemon\n{autostart_block}\n\n# 2. Status Bar',
                        txt,
                        flags=re.S,
                    )
                    if new_txt != txt:
                        with open(autostart_path, "w", encoding="utf-8") as f:
                            f.write(new_txt)
            except Exception:
                pass
        self._run_bg(worker)

    def _on_taskbar_style_changed(self, combo):
        if self._loading_appearance:
            return
        mode = "dock" if combo.get_active() == 1 else "islands"
        self._save_appearance_cfg(taskbar=mode)

        def worker():
            try:
                cfg_path = self._seed_user_config("waybar/config.jsonc")
                css_path = self._seed_user_config("waybar/style.css")

                if os.path.exists(cfg_path):
                    with open(cfg_path, "r", encoding="utf-8") as f:
                        raw_cfg = f.read()
                    margin_val = "0" if mode == "dock" else "8"
                    for mkey in ("margin-bottom", "margin-left", "margin-right"):
                        raw_cfg = re.sub(
                            rf'("{mkey}"\s*:\s*)\d+',
                            rf'\g<1>{margin_val}',
                            raw_cfg,
                        )
                    with open(cfg_path, "w", encoding="utf-8") as f:
                        f.write(raw_cfg)

                if os.path.exists(css_path):
                    with open(css_path, "r", encoding="utf-8") as f:
                        raw_css = f.read()
                    raw_css = re.sub(
                        r'\n*/\* BRISK-DOCK-MODE-START \*/.*?/\* BRISK-DOCK-MODE-END \*/\s*',
                        '\n',
                        raw_css,
                        flags=re.S,
                    ).rstrip() + "\n"
                    if mode == "dock":
                        raw_css += (
                            "\n/* BRISK-DOCK-MODE-START */\n"
                            "window#waybar {\n"
                            "    background-color: rgba(233, 241, 244, 0.96);\n"
                            "    border-top: 1px solid #CBD5E1;\n"
                            "}\n"
                            ".modules-left,\n"
                            ".modules-center,\n"
                            ".modules-right {\n"
                            "    background-color: transparent;\n"
                            "    border: none;\n"
                            "    border-radius: 0;\n"
                            "    box-shadow: none;\n"
                            "}\n"
                            "/* BRISK-DOCK-MODE-END */\n"
                        )
                    with open(css_path, "w", encoding="utf-8") as f:
                        f.write(raw_css)

                self._run_cmd(["pkill", "-x", "waybar"], timeout=3)
                subprocess.Popen(
                    ["waybar"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
            except Exception as exc:
                self._ui(self._show_dialog, Gtk.MessageType.ERROR, "Gagal Mengubah Gaya Taskbar", str(exc))
        self._run_bg(worker)

    def _on_quick_snapshot(self, btn):
        if self._snapshot_busy:
            return
        self._snapshot_busy = True
        self.hdr_snap_btn.set_sensitive(False)
        self.btn_create_snap.set_sensitive(False)
        self.hdr_snap_lbl.set_text("Membuat...")
        self.btn_create_snap_lbl.set_text("Membuat Snapshot...")

        def run_snapshot():
            comment = "Manual Quick Checkpoint from Control Center"
            cli_bin = "/usr/local/bin/brisk-timetravel"
            if not os.path.exists(cli_bin):
                self._ui(self._finish_quick_snapshot, False, "Utilitas /usr/local/bin/brisk-timetravel tidak ditemukan.")
                return
            if os.geteuid() == 0:
                cmd = [cli_bin, "create", comment]
            elif shutil.which("sudo"):
                cmd = ["sudo", "-n", cli_bin, "create", comment]
            elif shutil.which("pkexec"):
                cmd = ["pkexec", cli_bin, "create", comment]
            else:
                self._ui(self._finish_quick_snapshot, False, "Utility sudo/pkexec tidak tersedia.")
                return

            try:
                proc = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
                if proc.returncode != 0 and os.geteuid() != 0 and "sudo" in cmd[0] and shutil.which("pkexec"):
                    proc = subprocess.run(["pkexec", cli_bin, "create", comment], capture_output=True, text=True, timeout=300)

                if proc.returncode == 0:
                    snap_id = (proc.stdout.strip().splitlines() or [""])[-1]
                    self._ui(self._finish_quick_snapshot, True, snap_id)
                else:
                    err = (proc.stderr or proc.stdout or "Gagal membuat snapshot pemulihan.").strip()
                    self._ui(self._finish_quick_snapshot, False, err)
            except Exception as exc:
                self._ui(self._finish_quick_snapshot, False, str(exc))

        self._run_bg(run_snapshot)

    def _finish_quick_snapshot(self, success, detail):
        self._snapshot_busy = False
        self.hdr_snap_lbl.set_text("Snapshot")
        self.btn_create_snap_lbl.set_text("Buat Snapshot Baru")
        self.hdr_snap_btn.set_sensitive(True)
        self.btn_create_snap.set_sensitive(True)
        if success:
            self._load_timetravel_state()
            suffix = f" ({detail})" if detail else ""
            self._show_dialog(
                Gtk.MessageType.INFO,
                "Snapshot Pemulihan Berhasil Dibuat",
                f"Titik pemulihan sistem{suffix} telah disimpan. Anda dapat memutar balik ke titik ini kapan saja.",
            )
        else:
            self._show_dialog(
                Gtk.MessageType.ERROR,
                "Gagal Membuat Snapshot Pemulihan",
                detail or "Terjadi kesalahan saat menjalankan brisk-timetravel.",
            )

    def _on_open_timetravel_gui(self, btn):
        try:
            subprocess.Popen(["/usr/local/bin/brisk-timetravel-gui"], start_new_session=True)
        except Exception as exc:
            self._show_dialog(Gtk.MessageType.ERROR, "Gagal Membuka Time-Travel", str(exc))

    def _on_open_updater_gui(self, btn):
        try:
            subprocess.Popen(["/usr/local/bin/brisk-updater-gui"], start_new_session=True)
        except Exception as exc:
            self._show_dialog(Gtk.MessageType.ERROR, "Gagal Membuka Software Updater", str(exc))

    def _on_check_updates(self, btn):
        self.btn_chk_updates.set_sensitive(False)
        self.lbl_up_status.set_text("Memeriksa rilis resmi BriskOS...")

        def worker():
            local_ver = "1.0"
            try:
                with open("/etc/os-release", "r", encoding="utf-8") as f:
                    for line in f:
                        if line.startswith("VERSION_ID="):
                            local_ver = line.split("=", 1)[1].strip().strip('"\'')
                            break
            except Exception:
                pass

            cache_file = "/tmp/brisk-latest-release.json"
            ok, out, _ = self._run_cmd(["/usr/local/bin/brisk-update-checker", "--now"], timeout=15)
            status_msg = "Tidak dapat memeriksa rilis daring (offline atau API tidak terjangkau)."

            if ok and "skipped" in out.lower():
                status_msg = "Pemeriksaan rilis dilewati (offline atau batas API GitHub tercapai)."
            elif ok and os.path.exists(cache_file):
                try:
                    with open(cache_file, "r", encoding="utf-8") as f:
                        data = json.load(f)
                    if isinstance(data, list) and data:
                        data = data[0]
                    tag = str(data.get("tag_name", "")).lstrip("vV")
                    if tag:
                        cmp_ok, _, _ = self._run_cmd(["dpkg", "--compare-versions", tag, "gt", local_ver], timeout=3)
                        if cmp_ok:
                            status_msg = f"Pembaruan tersedia: v{tag} (terpasang v{local_ver}). Klik Buka Software Updater."
                        else:
                            status_msg = f"Sistem Anda sudah mutakhir (v{local_ver}, rilis terbaru v{tag})."
                except Exception:
                    status_msg = "Gagal membaca metadata rilis."
            elif out and "up to date" in out.lower():
                status_msg = f"Sistem Anda sudah mutakhir (v{local_ver})."

            def done():
                self.btn_chk_updates.set_sensitive(True)
                self.lbl_up_status.set_text(status_msg)
            self._ui(done)
        self._run_bg(worker)


# ------------------------------------------------------------------------------
# Main Entry Point
# ------------------------------------------------------------------------------
class BriskControlApp(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE,
        )
        self.window = None

    def do_activate(self):
        if self.window is None:
            self.window = BriskControlCenter(self)
        self.window.present()

    def do_command_line(self, command_line):
        args = command_line.get_arguments()[1:]
        self.activate()
        if self.window and args:
            target = args[-1].lstrip("-")
            if target.startswith("panel="):
                target = target.split("=", 1)[1]
            self.window.select_panel(target)
        return 0


if __name__ == "__main__":
    if any(a in ("-h", "--help") for a in sys.argv[1:]):
        print("Brisk Control Center (brisk-control)")
        print("Usage: brisk-control [panel]")
        print("Panels: display, nightlight, network, sound, input, power, appearance, timetravel, about")
        sys.exit(0)
    if "--version" in sys.argv[1:]:
        print(f"{APP_NAME} {APP_VERSION}")
        sys.exit(0)

    GLib.set_application_name(APP_NAME)
    GLib.set_prgname("brisk-control")
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    app = BriskControlApp()
    sys.exit(app.run(sys.argv))
