    # --------------------------------------------------------------------------
    # Panel 7: Personalisasi (Appearance / swaybg & Waybar)
    # --------------------------------------------------------------------------
    def _create_appearance_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.get_style_context().add_class("content-area")

        hdr, _ = self._make_section_header(
            "appearance",
            "Personalisasi & Tema",
            "Pilih latar desktop Morning Breeze, warna solid hemat GPU, dan gaya panel taskbar Waybar.",
        )
        box.pack_start(hdr, False, False, 0)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        card.get_style_context().add_class("setting-card")

        lbl_w = Gtk.Label(label="Latar Belakang Desktop (Wallpaper)", xalign=0)
        lbl_w.get_style_context().add_class("card-title")
        card.pack_start(lbl_w, False, False, 0)

        wp_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        wp_presets = [
            ("default", "Morning Breeze Silk", "Wallpaper vektor bawaan", "swatch-silk"),
            ("mist", "Morning Mist Matte", "Solid ringan (#DCECF2)", "swatch-mist"),
            ("slate", "Deep Slate Matte", "Solid gelap (#1E293B)", "swatch-slate"),
        ]
        self.wp_buttons = {}
        self.wp_badges = {}
        for wp_key, wp_name, wp_desc, swatch_cls in wp_presets:
            b = Gtk.Button()
            b.get_style_context().add_class("wp-card")
            v_b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

            swatch = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
            swatch.get_style_context().add_class(swatch_cls)
            v_b.pack_start(swatch, False, False, 0)

            top_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            l_t = Gtk.Label(label=wp_name, xalign=0)
            l_t.get_style_context().add_class("card-title")
            badge_p = Gtk.Label(label="Aktif")
            badge_p.get_style_context().add_class("badge-active")
            badge_p.set_no_show_all(True)
            top_row.pack_start(l_t, True, True, 0)
            top_row.pack_end(badge_p, False, False, 0)

            l_d = Gtk.Label(label=wp_desc, xalign=0)
            l_d.get_style_context().add_class("card-desc")

            v_b.pack_start(top_row, False, False, 0)
            v_b.pack_start(l_d, False, False, 0)
            b.add(v_b)
            b.connect("clicked", self._on_select_wallpaper, wp_key)
            self.wp_buttons[wp_key] = b
            self.wp_badges[wp_key] = badge_p
            wp_box.pack_start(b, False, False, 0)
        card.pack_start(wp_box, False, False, 0)

        card.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)

