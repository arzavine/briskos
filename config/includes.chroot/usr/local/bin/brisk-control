# App Metadata
# ------------------------------------------------------------------------------
APP_ID = "brisk-control"
APP_NAME = "Brisk Control Center"
APP_SUBTITLE = "Pusat Pengaturan Terpadu"
APP_VERSION = "1.0.0"

