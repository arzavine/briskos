class BriskControlCenter(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=APP_NAME)
        self.set_default_size(960, 640)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("brisk-control")

        # Load Custom Night Glass CSS
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(NIGHT_GLASS_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self._build_headerbar()
        self._build_ui()
        self.show_all()

    def _build_headerbar(self):
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title(APP_NAME)
        header.set_subtitle(APP_SUBTITLE)
        self.set_titlebar(header)

        # Quick Time-Travel Snapshot Button in Header
        snap_btn = Gtk.Button()
        snap_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        snap_icon = Gtk.Label(label="🛡️")
        snap_lbl = Gtk.Label(label="Snapshot")
        snap_box.pack_start(snap_icon, False, False, 0)
        snap_box.pack_start(snap_lbl, False, False, 0)
        snap_btn.add(snap_box)
        snap_btn.set_tooltip_text("Ambil Titik Pemulihan Sistem Instan (Brisk Time-Travel)")
        snap_btn.connect("clicked", self._on_quick_snapshot)
        header.pack_end(snap_btn)

    def _build_ui(self):
        main_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(main_box)

        # ----------------------------------------------------------------------
        # Left Sidebar Navigation
        # ----------------------------------------------------------------------
        sidebar_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        sidebar_box.get_style_context().add_class("sidebar-box")
        main_box.pack_start(sidebar_box, False, False, 0)

        # Search Bar
        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Cari pengaturan...")
        self.search_entry.get_style_context().add_class("sidebar-search")
        self.search_entry.connect("search-changed", self._on_search_changed)
        sidebar_box.pack_start(self.search_entry, False, False, 0)

        # Sidebar List
        scrolled_nav = Gtk.ScrolledWindow()
        scrolled_nav.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sidebar_box.pack_start(scrolled_nav, True, True, 0)

        self.nav_list = Gtk.ListBox()
        self.nav_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.nav_list.connect("row-selected", self._on_nav_selected)
        scrolled_nav.add(self.nav_list)

        # ----------------------------------------------------------------------
        # Right Stack Area
        # ----------------------------------------------------------------------
        content_scroll = Gtk.ScrolledWindow()
        content_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        main_box.pack_start(content_scroll, True, True, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(150)
        content_scroll.add(self.stack)

        # Categories
        self.categories = [
            ("display", "🖥️  Layar & Tampilan", self._create_display_panel),
            ("nightlight", "🌙  Pelindung Mata", self._create_nightlight_panel),
            ("network", "📶  Wi-Fi & Jaringan", self._create_network_panel),
            ("sound", "🎧  Suara & Audio", self._create_sound_panel),
            ("input", "🖱️  Mouse & Touchpad", self._create_input_panel),
            ("power", "⚡  Daya & Baterai", self._create_power_panel),
            ("appearance", "🎨  Personalisasi", self._create_appearance_panel),
            ("timetravel", "🛡️  Cadangan Sistem", self._create_timetravel_panel),
            ("about", "ℹ️  Tentang Laptop & OS", self._create_about_panel),
        ]

        for cat_id, cat_title, builder in self.categories:
            # Add to Sidebar
            row = Gtk.ListBoxRow()
            row.cat_id = cat_id
            row.cat_title = cat_title
            lbl = Gtk.Label(label=cat_title, xalign=0)
            lbl.get_style_context().add_class("sidebar-row")
            row.add(lbl)
            self.nav_list.add(row)

            # Build and add Panel
            panel = builder()
            self.stack.add_named(panel, cat_id)

        # Select first row
        first_row = self.nav_list.get_row_at_index(0)
        if first_row:
            self.nav_list.select_row(first_row)

    # --------------------------------------------------------------------------
    # Panel 1: Layar & Tampilan (Display)
    # --------------------------------------------------------------------------
    def _create_display_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.get_style_context().add_class("content-area")

        h = Gtk.Label(label="Layar & Tampilan (Display)", xalign=0)
        h.get_style_context().add_class("section-header")
        sub = Gtk.Label(label="Atur resolusi, kecepatan refresh, dan skala teks layar laptop Anda.", xalign=0)
        sub.get_style_context().add_class("section-subtitle")
        box.pack_start(h, False, False, 0)
        box.pack_start(sub, False, False, 0)

        # Card 1: Monitor Detection & Resolution
        card1 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        card1.get_style_context().add_class("setting-card")

        row1 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        vbox1 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_m = Gtk.Label(label="Layar Aktif", xalign=0)
        lbl_m.get_style_context().add_class("card-title")
        lbl_md = Gtk.Label(label="Layar Laptop Utama (eDP-1) • Wayland DRM", xalign=0)
        lbl_md.get_style_context().add_class("card-desc")
        vbox1.pack_start(lbl_m, False, False, 0)
        vbox1.pack_start(lbl_md, False, False, 0)
        badge_live = Gtk.Label(label="Aktif")
        badge_live.get_style_context().add_class("badge-active")
        row1.pack_start(vbox1, True, True, 0)
        row1.pack_end(badge_live, False, False, 0)
        card1.pack_start(row1, False, False, 0)

        sep1 = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        card1.pack_start(sep1, False, False, 0)

        # Resolution Dropdown
        row_res = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        vbox_res = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_res = Gtk.Label(label="Resolusi Layar", xalign=0)
        lbl_res.get_style_context().add_class("card-title")
        lbl_resd = Gtk.Label(label="Pilih ketajaman piksel layar sesuai rasio monitor Anda", xalign=0)
        lbl_resd.get_style_context().add_class("card-desc")
        vbox_res.pack_start(lbl_res, False, False, 0)
        vbox_res.pack_start(lbl_resd, False, False, 0)

        self.combo_res = Gtk.ComboBoxText()
        for r in ["1920 x 1080 (16:9 Full HD)", "1600 x 900 (16:9 HD+)", "1366 x 768 (16:9 Standar)", "1280 x 720 (16:9 HD)"]:
            self.combo_res.append_text(r)
        self.combo_res.set_active(0)

        row_res.pack_start(vbox_res, True, True, 0)
        row_res.pack_end(self.combo_res, False, False, 0)
        card1.pack_start(row_res, False, False, 0)

        # Refresh Rate Dropdown
        row_hz = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        vbox_hz = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_hz = Gtk.Label(label="Kecepatan Refresh (Refresh Rate)", xalign=0)
        lbl_hz.get_style_context().add_class("card-title")
        lbl_hzd = Gtk.Label(label="Semakin tinggi Hz, pergerakan kursor dan jendela semakin mulus", xalign=0)
        lbl_hzd.get_style_context().add_class("card-desc")
        vbox_hz.pack_start(lbl_hz, False, False, 0)
        vbox_hz.pack_start(lbl_hzd, False, False, 0)

        self.combo_hz = Gtk.ComboBoxText()
        for hz in ["60 Hz (Hemat Baterai)", "120 Hz (Sangat Mulus)", "144 Hz (Performa Gaming)"]:
            self.combo_hz.append_text(hz)
        self.combo_hz.set_active(1)

        row_hz.pack_start(vbox_hz, True, True, 0)
        row_hz.pack_end(self.combo_hz, False, False, 0)
        card1.pack_start(row_hz, False, False, 0)
        box.pack_start(card1, False, False, 0)

        # Card 2: HiDPI Display Scale
        card2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        card2.get_style_context().add_class("setting-card")

        lbl_sc = Gtk.Label(label="Skala Tampilan (HiDPI Scaling)", xalign=0)
        lbl_sc.get_style_context().add_class("card-title")
        lbl_scd = Gtk.Label(label="Perbesar ukuran teks dan ikon agar pas di layar laptop Anda tanpa buram", xalign=0)
        lbl_scd.get_style_context().add_class("card-desc")
        card2.pack_start(lbl_sc, False, False, 0)
        card2.pack_start(lbl_scd, False, False, 0)

        # Radio Scale Buttons
        scale_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        self.scale_100 = Gtk.RadioButton.new_with_label(None, "100% (Standar)")
        self.scale_125 = Gtk.RadioButton.new_with_label_from_widget(self.scale_100, "125% (Rekomendasi Laptop)")
        self.scale_150 = Gtk.RadioButton.new_with_label_from_widget(self.scale_100, "150% (Besar Nyaman)")
        self.scale_100.set_active(True)

        scale_box.pack_start(self.scale_100, False, False, 0)
        scale_box.pack_start(self.scale_125, False, False, 0)
        scale_box.pack_start(self.scale_150, False, False, 0)
        card2.pack_start(scale_box, False, False, 0)

        # Apply Button
        btn_apply = Gtk.Button(label="Terapkan Pengaturan Layar")
        btn_apply.get_style_context().add_class("btn-primary")
        btn_apply.connect("clicked", self._on_apply_display)
        card2.pack_start(btn_apply, False, False, 6)

        box.pack_start(card2, False, False, 0)
        return box

    # --------------------------------------------------------------------------
    # Panel 2: Pelindung Mata (Night Light)
    # --------------------------------------------------------------------------
    def _create_nightlight_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.get_style_context().add_class("content-area")

        h = Gtk.Label(label="Pelindung Mata (Night Light)", xalign=0)
        h.get_style_context().add_class("section-header")
        sub = Gtk.Label(label="Kurangi radiasi cahaya biru di malam hari agar mata tidak lelah dan tidur lebih nyenyak.", xalign=0)
        sub.get_style_context().add_class("section-subtitle")
        box.pack_start(h, False, False, 0)
        box.pack_start(sub, False, False, 0)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        card.get_style_context().add_class("setting-card")

        # Master Switch
        row_sw = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        v_sw = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_sw = Gtk.Label(label="Aktifkan Night Light", xalign=0)
        lbl_sw.get_style_context().add_class("card-title")
        lbl_swd = Gtk.Label(label="Ubah nada warna layar menjadi lebih hangat", xalign=0)
        lbl_swd.get_style_context().add_class("card-desc")
        v_sw.pack_start(lbl_sw, False, False, 0)
        v_sw.pack_start(lbl_swd, False, False, 0)

        self.sw_night = Gtk.Switch()
        self.sw_night.set_active(False)
        self.sw_night.connect("state-set", self._on_nightlight_toggle)
        row_sw.pack_start(v_sw, True, True, 0)
        row_sw.pack_end(self.sw_night, False, False, 0)
        card.pack_start(row_sw, False, False, 0)

        card.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)

        # Color Temperature Slider
        v_temp = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        lbl_t = Gtk.Label(label="Suhu Warna Layar (Hangat vs Dingin)", xalign=0)
        lbl_t.get_style_context().add_class("card-title")
        v_temp.pack_start(lbl_t, False, False, 0)

        self.scale_temp = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 3500, 6500, 100)
        self.scale_temp.set_value(4500)
        self.scale_temp.set_draw_value(True)
        self.scale_temp.set_value_pos(Gtk.PositionType.RIGHT)
        self.scale_temp.connect("value-changed", self._on_temp_changed)
        v_temp.pack_start(self.scale_temp, False, False, 0)

        # Temperature Hints
        hints = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        lbl_warm = Gtk.Label(label="🟠 3500K (Sangat Hangat / Tidur)")
        lbl_warm.get_style_context().add_class("card-desc")
        lbl_cool = Gtk.Label(label="🔵 6500K (Standar Siang)")
        lbl_cool.get_style_context().add_class("card-desc")
        hints.pack_start(lbl_warm, False, False, 0)
        hints.pack_end(lbl_cool, False, False, 0)
        v_temp.pack_start(hints, False, False, 0)
        card.pack_start(v_temp, False, False, 0)

        card.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)

        # Automatic Schedule
        row_sch = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        v_sch = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_sch = Gtk.Label(label="Jadwal Otomatis (Matahari Terbenam ke Terbit)", xalign=0)
        lbl_sch.get_style_context().add_class("card-title")
        lbl_schd = Gtk.Label(label="Otomatis menyala pada pukul 18:00 dan kembali normal pada 06:00", xalign=0)
        lbl_schd.get_style_context().add_class("card-desc")
        v_sch.pack_start(lbl_sch, False, False, 0)
        v_sch.pack_start(lbl_schd, False, False, 0)

        sw_sch = Gtk.Switch()
        sw_sch.set_active(True)
        row_sch.pack_start(v_sch, True, True, 0)
        row_sch.pack_end(sw_sch, False, False, 0)
        card.pack_start(row_sch, False, False, 0)

        box.pack_start(card, False, False, 0)
        return box

    # --------------------------------------------------------------------------
    # Panel 3: Wi-Fi & Jaringan (Network)
    # --------------------------------------------------------------------------
    def _create_network_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.get_style_context().add_class("content-area")

        h = Gtk.Label(label="Wi-Fi & Jaringan", xalign=0)
        h.get_style_context().add_class("section-header")
        sub = Gtk.Label(label="Kelola koneksi internet nirkabel, sinyal Wi-Fi, dan status jaringan.", xalign=0)
        sub.get_style_context().add_class("section-subtitle")
        box.pack_start(h, False, False, 0)
        box.pack_start(sub, False, False, 0)

        # Card 1: Wi-Fi Master & Status
        card1 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        card1.get_style_context().add_class("setting-card")

        row_wf = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        v_wf = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_wf = Gtk.Label(label="Adaptor Wi-Fi Nirkabel", xalign=0)
        lbl_wf.get_style_context().add_class("card-title")
        lbl_wfd = Gtk.Label(label="Pindai dan sambungkan laptop ke jaringan hotspot sekitar", xalign=0)
        lbl_wfd.get_style_context().add_class("card-desc")
        v_wf.pack_start(lbl_wf, False, False, 0)
        v_wf.pack_start(lbl_wfd, False, False, 0)

        sw_wifi = Gtk.Switch()
        sw_wifi.set_active(True)
        row_wf.pack_start(v_wf, True, True, 0)
        row_wf.pack_end(sw_wifi, False, False, 0)
        card1.pack_start(row_wf, False, False, 0)

        card1.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)

        # Current Connection Badge
        row_cur = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        v_cur = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_cur = Gtk.Label(label="Jaringan Terhubung", xalign=0)
        lbl_cur.get_style_context().add_class("card-title")
        lbl_curd = Gtk.Label(label="Brisk-Secure-5G • Sinyal Sangat Kuat (92%) • IP: 192.168.1.108", xalign=0)
        lbl_curd.get_style_context().add_class("card-desc")
        v_cur.pack_start(lbl_cur, False, False, 0)
        v_cur.pack_start(lbl_curd, False, False, 0)

        btn_disc = Gtk.Button(label="Putuskan")
        btn_disc.get_style_context().add_class("btn-secondary")
        row_cur.pack_start(v_cur, True, True, 0)
        row_cur.pack_end(btn_disc, False, False, 0)
