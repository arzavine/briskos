    background-color: transparent;
    border: none;
}

scrollbar slider {
    min-width: 6px;
    min-height: 6px;
    border-radius: 9999px;
    background-color: #94A3B8;
    border: none;
    margin: 2px;
}

scrollbar slider:hover {
    background-color: #64748B;
}

scrollbar slider:active {
    background-color: #0E7490;
}
"""


class BriskControlCenter(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=APP_NAME)
        self.set_default_size(980, 660)
        self.set_size_request(760, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        Gtk.Window.set_default_icon_name("brisk-control")
        self.set_icon_name("brisk-control")

        self._loading_night = False
        self._loading_audio = False
        self._loading_input = False
        self._loading_power = False
        self._loading_appearance = False
        self._loading_network = False
        self._snapshot_busy = False
        self._temp_debounce_id = None
        self._input_debounce_id = None
        self._vol_debounce_id = None
        self.display_output = None
        self._audio_sinks = []
        self._active_wifi_con = None
        self._active_wifi_dev = None
        self._sidebar_rows = {}
        self._active_cat_id = "display"

        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(MORNING_BREEZE_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self._build_headerbar()
        self._build_ui()
        self.connect("key-press-event", self._on_window_key_press)
        self._load_all_states()
        self.show_all()
        if hasattr(self, "sidebar_empty_lbl"):
            self.sidebar_empty_lbl.hide()

        # Focus sidebar row instead of SearchEntry on launch so SearchEntry does not trap keypresses
        GLib.idle_add(self._focus_initial_row)

    # --------------------------------------------------------------------------
    # Shared Async, Config, Badge & Dialog Helpers
    # --------------------------------------------------------------------------
    def _focus_initial_row(self):
        row = self.nav_list.get_selected_row() or self.nav_list.get_row_at_index(0)
        if row:
            row.grab_focus()
        return False

    def _ui(self, fn, *args):
        def _cb():
            fn(*args)
            return False
        GLib.idle_add(_cb)

    def _run_bg(self, target):
        threading.Thread(target=target, daemon=True).start()

    def _run_cmd(self, cmd, timeout=10):
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
            return proc.returncode == 0, proc.stdout.strip(), proc.stderr.strip()
        except FileNotFoundError:
            return False, "", f"Perintah tidak ditemukan: {cmd[0]}"
        except subprocess.TimeoutExpired:
            return False, "", f"Timeout menjalankan {' '.join(cmd)}"
        except Exception as exc:
            return False, "", str(exc)

    def _set_badge(self, label_widget, text, style_class):
        ctx = label_widget.get_style_context()
        for cls in ("badge-active", "badge-info", "badge-warn", "badge-error"):
            ctx.remove_class(cls)
        ctx.add_class(style_class)
        label_widget.set_text(text)

    def _show_dialog(self, msg_type, title, body):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=msg_type,
            buttons=Gtk.ButtonsType.OK,
            text=title,
        )
        dialog.format_secondary_text(body)
        ok_btn = dialog.get_widget_for_response(Gtk.ResponseType.OK)
        if ok_btn:
            ok_btn.get_style_context().add_class("btn-primary")
        dialog.run()
        dialog.destroy()

    def _seed_user_config(self, rel_path):
        user_path = os.path.expanduser(f"~/.config/{rel_path}")
        os.makedirs(os.path.dirname(user_path), exist_ok=True)
        if not os.path.exists(user_path):
            skel_path = f"/etc/skel/.config/{rel_path}"
            if os.path.exists(skel_path):
                shutil.copy2(skel_path, user_path)
        return user_path

    def _clear_box(self, box):
        for child in box.get_children():
            box.remove(child)

    def _make_section_header(self, icon_name, title_text, subtitle_text):
        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        hdr.get_style_context().add_class("section-header-box")

        icon_wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        icon_wrap.get_style_context().add_class("section-icon-wrap")
        icon_wrap.set_valign(Gtk.Align.CENTER)
        icon_wrap.add(svg_icon(icon_name, color=COLOR_ACCENT_TEXT, size=22))

        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        text_box.set_valign(Gtk.Align.CENTER)
        h = Gtk.Label(label=title_text, xalign=0)
        h.get_style_context().add_class("section-header")
        h.set_line_wrap(True)

        sub = Gtk.Label(label=subtitle_text, xalign=0)
        sub.get_style_context().add_class("section-subtitle")
        sub.set_line_wrap(True)

        text_box.pack_start(h, False, False, 0)
        text_box.pack_start(sub, False, False, 0)

        hdr.pack_start(icon_wrap, False, False, 0)
        hdr.pack_start(text_box, True, True, 0)
        return hdr, sub

    def select_panel(self, cat_id):
        row = self._sidebar_rows.get(cat_id)
        if row:
            row.show()
            self.nav_list.select_row(row)
            self.stack.set_visible_child_name(cat_id)

    def _load_all_states(self):
        self._load_display_state()
        self._load_nightlight_state()
        self._refresh_network(rescan=False)
        self._load_audio_state()
        self._load_input_state()
        self._load_power_state()
        self._load_appearance_state()
        self._load_timetravel_state()

    def _build_headerbar(self):
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title(APP_NAME)
        header.set_subtitle(APP_SUBTITLE)
        self.set_titlebar(header)

        # Quick Time-Travel Snapshot Button in Header (SVG Icon + Preserved Label)
        self.hdr_snap_btn = Gtk.Button()
        snap_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        snap_icon = svg_icon("snapshot", color=COLOR_ACCENT_TEXT, size=16)
        self.hdr_snap_lbl = Gtk.Label(label="Snapshot")
        snap_box.pack_start(snap_icon, False, False, 0)
        snap_box.pack_start(self.hdr_snap_lbl, False, False, 0)
        self.hdr_snap_btn.add(snap_box)
        self.hdr_snap_btn.set_tooltip_text("Ambil Titik Pemulihan Sistem Instan (Brisk Time-Travel)")
        self.hdr_snap_btn.connect("clicked", self._on_quick_snapshot)
        header.pack_end(self.hdr_snap_btn)

    def _build_ui(self):
        main_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(main_box)

        # ----------------------------------------------------------------------
        # Left Sidebar Navigation (#E9F1F4)
        # ----------------------------------------------------------------------
        sidebar_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        sidebar_box.get_style_context().add_class("sidebar-box")
        main_box.pack_start(sidebar_box, False, False, 0)

        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Cari pengaturan...")
        self.search_entry.get_style_context().add_class("sidebar-search")
        self.search_entry.connect("search-changed", self._on_search_changed)
        self.search_entry.connect("key-press-event", self._on_search_key_press)
        sidebar_box.pack_start(self.search_entry, False, False, 0)

        scrolled_nav = Gtk.ScrolledWindow()
        scrolled_nav.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sidebar_box.pack_start(scrolled_nav, True, True, 0)

        nav_wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        scrolled_nav.add(nav_wrap)

        self.nav_list = Gtk.ListBox()
        self.nav_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.nav_list.connect("row-selected", self._on_nav_selected)
        nav_wrap.pack_start(self.nav_list, False, False, 0)

        self.sidebar_empty_lbl = Gtk.Label(
            label="Tidak ada pengaturan yang cocok. Tekan Esc untuk mereset pencarian.",
            xalign=0,
        )
        self.sidebar_empty_lbl.set_line_wrap(True)
        self.sidebar_empty_lbl.get_style_context().add_class("sidebar-empty")
        nav_wrap.pack_start(self.sidebar_empty_lbl, False, False, 0)

        # ----------------------------------------------------------------------
        # Right Stack Area (#F5F7F7)
        # ----------------------------------------------------------------------
        content_scroll = Gtk.ScrolledWindow()
        content_scroll.get_style_context().add_class("content-scroll")
        content_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        main_box.pack_start(content_scroll, True, True, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(150)
        content_scroll.add(self.stack)

        self.categories = [
            ("display", "Layar & Tampilan", "display", self._create_display_panel),
            ("nightlight", "Pelindung Mata", "nightlight", self._create_nightlight_panel),
            ("network", "Wi-Fi & Jaringan", "network", self._create_network_panel),
            ("sound", "Suara & Audio", "sound", self._create_sound_panel),
            ("input", "Mouse & Touchpad", "input", self._create_input_panel),
            ("power", "Daya & Baterai", "power", self._create_power_panel),
            ("appearance", "Personalisasi", "appearance", self._create_appearance_panel),
            ("timetravel", "Cadangan Sistem", "timetravel", self._create_timetravel_panel),
            ("about", "Tentang Laptop & OS", "about", self._create_about_panel),
        ]

        for cat_id, cat_title, icon_name, builder in self.categories:
            row = Gtk.ListBoxRow()
            row.cat_id = cat_id
            row.cat_title = cat_title
            row.icon_name = icon_name
            row.get_style_context().add_class("sidebar-row")

            row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row_img = svg_icon(icon_name, color=COLOR_TEXT_SECONDARY, size=18)
            row_lbl = Gtk.Label(label=cat_title, xalign=0)
            row_box.pack_start(row_img, False, False, 0)
            row_box.pack_start(row_lbl, True, True, 0)
            row.icon_img = row_img
            row.add(row_box)

            self._sidebar_rows[cat_id] = row
            self.nav_list.add(row)

            panel = builder()
            self.stack.add_named(panel, cat_id)

        first_row = self.nav_list.get_row_at_index(0)
        if first_row:
            self.nav_list.select_row(first_row)

    # --------------------------------------------------------------------------
    # Panel 1: Layar & Tampilan (Display)
    # --------------------------------------------------------------------------
    def _create_display_panel(self):
