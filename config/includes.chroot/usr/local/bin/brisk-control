    # --------------------------------------------------------------------------
    # Panel 7: Personalisasi (Appearance / swaybg & Waybar)
    # --------------------------------------------------------------------------
    def _create_appearance_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.get_style_context().add_class("content-area")

        h = Gtk.Label(label="Personalisasi & Tema", xalign=0)
        h.get_style_context().add_class("section-header")
        sub = Gtk.Label(label="Pilih latar desktop, mode warna solid, dan gaya panel taskbar Waybar.", xalign=0)
        sub.get_style_context().add_class("section-subtitle")
        box.pack_start(h, False, False, 0)
        box.pack_start(sub, False, False, 0)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        card.get_style_context().add_class("setting-card")

        # Wallpaper Selection
        lbl_w = Gtk.Label(label="Latar Belakang Desktop (Wallpaper)", xalign=0)
        lbl_w.get_style_context().add_class("card-title")
        card.pack_start(lbl_w, False, False, 0)

        wp_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        wp_presets = [
            ("default", "Night Glass Default", "Wallpaper SVG Bawaan"),
            ("midnight", "Midnight Slate Matte", "Warna Solid Hemat GPU (#0f172a)"),
        ]
        self.wp_buttons = {}
        for wp_key, wp_name, wp_desc in wp_presets:
            b = Gtk.Button()
            v_b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            l_t = Gtk.Label(label=wp_name)
            l_t.get_style_context().add_class("card-title")
            l_d = Gtk.Label(label=wp_desc)
            l_d.get_style_context().add_class("card-desc")
            v_b.pack_start(l_t, False, False, 0)
            v_b.pack_start(l_d, False, False, 0)
            b.add(v_b)
            b.get_style_context().add_class("btn-secondary")
            b.connect("clicked", self._on_select_wallpaper, wp_key)
            self.wp_buttons[wp_key] = b
            wp_box.pack_start(b, False, False, 0)
        card.pack_start(wp_box, False, False, 0)

        card.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)

        # Taskbar Style
        row_tb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        v_tb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_tb = Gtk.Label(label="Gaya Taskbar Waybar", xalign=0)
        lbl_tb.get_style_context().add_class("card-title")
        lbl_tbd = Gtk.Label(label="Pilih tata letak panel taskbar di bagian bawah layar", xalign=0)
        lbl_tbd.get_style_context().add_class("card-desc")
        v_tb.pack_start(lbl_tb, False, False, 0)
        v_tb.pack_start(lbl_tbd, False, False, 0)

        self.combo_tb = Gtk.ComboBoxText()
        self.combo_tb.append_text("Pulau Mengambang (Floating Islands - Bawaan)")
        self.combo_tb.append_text("Gaya Dermaga Penuh (Full Edge Dock)")
        self.combo_tb.set_active(0)
        self.combo_tb.connect("changed", self._on_taskbar_style_changed)

        row_tb.pack_start(v_tb, True, True, 0)
        row_tb.pack_end(self.combo_tb, False, False, 0)
        card.pack_start(row_tb, False, False, 0)

        box.pack_start(card, False, False, 0)
        return box

