        row_st.pack_end(self.badge_tt, False, False, 0)
        card.pack_start(row_st, False, False, 0)

        card.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)

        # Snapshot Action Buttons
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        btn_create = Gtk.Button(label="Buat Snapshot Baru Sekarang")
        btn_create.get_style_context().add_class("btn-primary")
        btn_create.connect("clicked", self._on_quick_snapshot)

        btn_gui = Gtk.Button(label="Buka Wizard Pemulihan Time-Travel")
        btn_gui.get_style_context().add_class("btn-secondary")
        btn_gui.connect("clicked", self._on_open_timetravel_gui)

        btn_box.pack_start(btn_create, False, False, 0)
        btn_box.pack_start(btn_gui, False, False, 0)
        card.pack_start(btn_box, False, False, 0)

        box.pack_start(card, False, False, 0)
        return box

