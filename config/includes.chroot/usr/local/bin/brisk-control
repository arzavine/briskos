# App Metadata
# ------------------------------------------------------------------------------
APP_ID = "org.briskos.control"
APP_NAME = "Brisk Control Center"
APP_SUBTITLE = "Pusat Pengaturan Terpadu"
APP_VERSION = "1.0.0"

# ------------------------------------------------------------------------------
# Night Glass CSS Theme (WCAG AAA Contrast, Matte Dark Slate, Ice Cyan Accents)
# ------------------------------------------------------------------------------
