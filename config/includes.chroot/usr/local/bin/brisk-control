            "Kurangi radiasi cahaya biru di malam hari agar mata tidak lelah dan tidur lebih nyenyak.",
        )
        box.pack_start(hdr, False, False, 0)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        card.get_style_context().add_class("setting-card")

        row_sw = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        v_sw = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
