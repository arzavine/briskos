        lbl_swd.get_style_context().add_class("card-desc")
        lbl_swd.set_line_wrap(True)
        v_sw.pack_start(lbl_sw, False, False, 0)
        v_sw.pack_start(lbl_swd, False, False, 0)

        right_nl = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        right_nl.set_valign(Gtk.Align.CENTER)
