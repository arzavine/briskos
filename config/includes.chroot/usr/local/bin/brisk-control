    # --------------------------------------------------------------------------
    # Panel 3: Wi-Fi & Jaringan (NetworkManager / nmcli)
    # --------------------------------------------------------------------------
    def _create_network_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.get_style_context().add_class("content-area")

        hdr, _ = self._make_section_header(
            "network",
            "Wi-Fi & Jaringan",
            "Kelola koneksi internet nirkabel, sinyal Wi-Fi, dan status jaringan.",
        )
