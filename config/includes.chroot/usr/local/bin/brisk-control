def svg_pixbuf(name, color=COLOR_TEXT_SECONDARY, size=18):
    """Render an inline uniform-stroke 1.75px SVG icon into a GdkPixbuf."""
    body = SVG_ICONS.get(name, SVG_ICONS["about"]).replace("CURRENT", color)
    svg_xml = (
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}" '
        f'viewBox="0 0 24 24" fill="none" stroke="{color}" stroke-width="1.75" '
        f'stroke-linecap="round" stroke-linejoin="round">{body}</svg>'
    ).encode("utf-8")
    try:
        loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
        loader.set_size(size, size)
        loader.write(svg_xml)
        loader.close()
        return loader.get_pixbuf()
    except Exception:
        return None


def svg_icon(name, color=COLOR_TEXT_SECONDARY, size=18):
    """Build a crisp Gtk.Image from an inline SVG vector icon."""
    pixbuf = svg_pixbuf(name, color=color, size=size)
    if pixbuf is not None:
        return Gtk.Image.new_from_pixbuf(pixbuf)
    return Gtk.Image.new_from_icon_name("preferences-system-symbolic", Gtk.IconSize.MENU)


