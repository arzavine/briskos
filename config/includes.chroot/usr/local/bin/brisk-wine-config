#!/usr/bin/env python3
# ==============================================================================
# Brisk Wine Configuration - Morning Breeze GTK3 Desktop App
# Manage Wine prefix, winecfg, winetricks, taskmgr, regedit, and clean resets.
# ==============================================================================

import os
import sys
import time
import shutil
import signal
import subprocess
import threading

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Pango", "1.0")
from gi.repository import Gtk, Gdk, GLib, GdkPixbuf, Pango

APP_ID = "brisk-wine-config"
APP_NAME = "Brisk Wine Configuration"
WINEPREFIX = os.environ.get("WINEPREFIX") or os.path.expanduser("~/.wine")

