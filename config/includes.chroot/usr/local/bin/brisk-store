# ------------------------------------------------------------------------------
# Icon Resolver
# ------------------------------------------------------------------------------
def create_app_icon(icon_name, category):
    theme = Gtk.IconTheme.get_default()

    if icon_name and theme is not None and theme.has_icon(icon_name):
        img = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.DND)
        img.set_pixel_size(40)
        return img

    alt_map = {
        "google-chrome": ["google-chrome-stable", "browser", "web-browser"],
        "com.visualstudio.code": ["visual-studio-code", "vscode", "text-editor"],
        "spotify": ["spotify-client", "audio-player"],
        "discord": ["discord-canary", "chat"],
        "telegram": ["telegram-desktop", "mail-message-new"],
        "obsidian": ["accessories-text-editor", "text-editor"],
        "steam": ["steam-launcher", "games"],
    }
    if theme is not None:
        for alt in alt_map.get(icon_name, []):
            if theme.has_icon(alt):
                img = Gtk.Image.new_from_icon_name(alt, Gtk.IconSize.DND)
                img.set_pixel_size(40)
                return img

        cat_map = {
            "internet": "web-browser",
            "development": "applications-development",
            "coding": "applications-development",
            "office": "x-office-document",
            "media": "applications-multimedia",
            "gaming": "applications-games",
            "utilities": "applications-system",
        }
        cat_icon = cat_map.get(category.lower(), "application-x-executable")
        if theme.has_icon(cat_icon):
            img = Gtk.Image.new_from_icon_name(cat_icon, Gtk.IconSize.DND)
            img.set_pixel_size(40)
            return img

    svg_key = category.lower() if category.lower() in SVG_PATHS else "package"
    return svg_icon(svg_key, color="#0E7490", size=38)

# ------------------------------------------------------------------------------
# Main Application Window
# ------------------------------------------------------------------------------
class BriskStoreWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=APP_NAME)
        self.set_default_size(940, 640)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name(APP_ID)

        self.catalog = []
        self.catalog_warning = None
        self.installed_ids = set()
        self.active_status = "all"          # "all" or "installed"
        self.active_category = "featured"   # "featured", "internet", "development", "office", "media", "gaming", "utilities"
        self.search_query = ""
        self.is_loading = True
        self._did_initial_focus = False

        self.app_cards = []
        self.app_buttons = {}
        self.sidebar_buttons = {}
        self.sidebar_icons = {}             # key -> (Gtk.Image, svg_name)

        self.load_catalog()
        self.setup_ui()
        self.connect("destroy", self.on_destroy)
        self.connect("key-press-event", self.on_key_press)
        self.connect("map-event", self.on_first_map)

        # Trigger background inventory of installed apps without blocking startup
        threading.Thread(target=self.async_fetch_installed_apps, daemon=True).start()

    # --------------------------------------------------------------------------
    # Catalog Loading (Local & Offline-Safe)
    # --------------------------------------------------------------------------
    def load_catalog(self):
        cat_file = resolve_catalog_path()
        if os.path.isfile(cat_file):
            try:
                with open(cat_file, "r", encoding="utf-8") as f:
                    data = json.load(f)
                if isinstance(data, list):
                    self.catalog = data
                else:
                    self.catalog = FALLBACK_CATALOG
                    self.catalog_warning = f"Format katalog {cat_file} tidak valid; menggunakan katalog cadangan offline."
            except Exception as e:
                print(f"[Brisk Store] Warning: Failed to parse catalog {cat_file}: {e}", file=sys.stderr)
                self.catalog = FALLBACK_CATALOG
                self.catalog_warning = "Katalog utama tidak dapat dibaca; menampilkan katalog cadangan offline."
        else:
            self.catalog = FALLBACK_CATALOG
            self.catalog_warning = "Katalog sistem belum ditemukan; menampilkan katalog cadangan offline."

    # --------------------------------------------------------------------------
    # UI Setup
    # --------------------------------------------------------------------------
    def setup_ui(self):
        # 1. HeaderBar
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title(APP_NAME)
        header.set_subtitle("Pusat Aplikasi Ringan BriskOS")

        brand_icon = svg_icon("brand", color="#0E7490", size=20)
        header.pack_start(brand_icon)

        # Search Entry (never auto-focused on launch)
        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Cari aplikasi (Ctrl+F)...")
