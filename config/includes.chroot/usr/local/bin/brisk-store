def make_svg_pixbuf(name, color="#475569", size=16):
    path_data = SVG_PATHS.get(name, SVG_PATHS["package"])
    svg_xml = (
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}" '
        f'viewBox="0 0 24 24" fill="none" stroke="{color}" '
        f'stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">'
        f'{path_data}</svg>'
    ).encode("utf-8")
    try:
        loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
        loader.set_size(size, size)
        loader.write(svg_xml)
        loader.close()
        return loader.get_pixbuf()
    except Exception:
        return None

def svg_icon(name, color="#475569", size=16):
    pixbuf = make_svg_pixbuf(name, color=color, size=size)
    if pixbuf is not None:
        return Gtk.Image.new_from_pixbuf(pixbuf)
    img = Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.MENU)
    img.set_pixel_size(size)
    return img

# ------------------------------------------------------------------------------
# Helpers: File & Path Resolution
# ------------------------------------------------------------------------------
def resolve_catalog_path():
    candidates = [
        "/etc/brisk/store/catalog.json",
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "../../../etc/brisk/store/catalog.json"),
        os.path.join(os.getcwd(), "config/includes.chroot/etc/brisk/store/catalog.json"),
    ]
    for path in candidates:
        if os.path.isfile(path):
            return path
    return "/etc/brisk/store/catalog.json"

def resolve_backend_path():
    candidates = [
        "/usr/local/bin/brisk-store-backend",
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "brisk-store-backend"),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "../../../usr/local/bin/brisk-store-backend"),
        os.path.join(os.getcwd(), "config/includes.chroot/usr/local/bin/brisk-store-backend"),
    ]
    for path in candidates:
        if os.path.exists(path) and os.access(path, os.X_OK):
            return path
    return "/usr/local/bin/brisk-store-backend"

def is_live_session():
    if os.path.isdir("/run/live/medium") or os.path.isdir("/run/live"):
        return True
    try:
        with open("/proc/cmdline", "r", encoding="utf-8", errors="ignore") as f:
            if "boot=live" in f.read():
                return True
    except Exception:
        pass
    return False

