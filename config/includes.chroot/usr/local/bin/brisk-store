    # --------------------------------------------------------------------------
    # Widget Generators & Focus Control
    # --------------------------------------------------------------------------
    def on_first_map(self, *args):
        if not self._did_initial_focus:
            self._did_initial_focus = True
            GLib.idle_add(self._focus_default_nav)
        return False

    def _focus_default_nav(self):
        target = self.sidebar_buttons.get("cat_featured")
        if target is not None:
            target.grab_focus()
        return False

    def on_key_press(self, widget, event):
        state = event.state & Gtk.accelerator_get_default_mod_mask()
        if state == Gdk.ModifierType.CONTROL_MASK and event.keyval in (Gdk.KEY_f, Gdk.KEY_F):
            self.search_entry.grab_focus()
            return True
        if event.keyval == Gdk.KEY_Escape:
            if self.search_entry.has_focus():
                if self.search_entry.get_text():
                    self.search_entry.set_text("")
                self._focus_default_nav()
                return True
            if self.banner_revealer.get_reveal_child():
                self.banner_revealer.set_reveal_child(False)
                return True
        return False

    def show_banner(self, message, is_error=True):
        ctx = self.banner_box.get_style_context()
        ctx.remove_class("notice-banner-error")
        ctx.remove_class("notice-banner-warn")
        if is_error:
            ctx.add_class("notice-banner-error")
            pix = make_svg_pixbuf("alert", color="#991B1B", size=16)
        else:
            ctx.add_class("notice-banner-warn")
            pix = make_svg_pixbuf("alert", color="#9A3412", size=16)
        if pix is not None:
            self.banner_icon.set_from_pixbuf(pix)
        self.banner_label.set_text(message)
        self.banner_revealer.set_reveal_child(True)

    def create_sidebar_item(self, key, icon_name, label_text, callback, param):
        btn = Gtk.Button()
        btn.get_style_context().add_class("sidebar-button")
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        img = svg_icon(icon_name, color="#475569", size=16)
        lbl = Gtk.Label(label=label_text, xalign=0)
        lbl.get_style_context().add_class("sidebar-btn-label")
        box.pack_start(img, False, False, 0)
        box.pack_start(lbl, True, True, 0)
        btn.add(box)
        btn.connect("clicked", callback, param)
        self.sidebar_buttons[key] = btn
        self.sidebar_icons[key] = (img, icon_name)
        return btn

    def _set_sidebar_group_active(self, prefix, active_key):
        for key, btn in self.sidebar_buttons.items():
            if not key.startswith(prefix):
                continue
            is_act = (key == active_key)
            ctx = btn.get_style_context()
            if is_act:
                ctx.add_class("active")
            else:
                ctx.remove_class("active")
            img_widget, icon_name = self.sidebar_icons[key]
            pix = make_svg_pixbuf(icon_name, color="#0E7490" if is_act else "#475569", size=16)
            if pix is not None:
                img_widget.set_from_pixbuf(pix)

    def _make_action_button_content(self, icon_name, label_text, color):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.set_halign(Gtk.Align.CENTER)
        box.pack_start(svg_icon(icon_name, color=color, size=14), False, False, 0)
        lbl = Gtk.Label(label=label_text)
        box.pack_start(lbl, False, False, 0)
        box.show_all()
        return box

    def _set_action_button_state(self, button, state):
        ctx = button.get_style_context()
        ctx.remove_class("btn-install")
        ctx.remove_class("btn-remove")
        ctx.remove_class("btn-busy")

        for child in button.get_children():
            button.remove(child)

        if state == "installed":
            ctx.add_class("btn-remove")
            button.add(self._make_action_button_content("remove", "Copot", "#B91C1C"))
            button.set_tooltip_text("Copot aplikasi dari sistem")
            button.get_accessible().set_name("Copot aplikasi")
            button.set_sensitive(True)
        elif state == "busy_install":
            ctx.add_class("btn-busy")
            button.set_label("Memasang...")
            button.set_sensitive(False)
        elif state == "busy_remove":
            ctx.add_class("btn-busy")
            button.set_label("Mencopot...")
            button.set_sensitive(False)
        else:
            ctx.add_class("btn-install")
            button.add(self._make_action_button_content("install", "Pasang", "#FFFFFF"))
            button.set_tooltip_text("Pasang aplikasi ke sistem")
            button.get_accessible().set_name("Pasang aplikasi")
            button.set_sensitive(True)

    def populate_cards(self):
        for app in self.catalog:
            child = Gtk.FlowBoxChild()
            card_widget = self.build_card_widget(app)
            child.add(card_widget)
            child.app_data = app
            self.flowbox.add(child)
            self.app_cards.append(child)

    def build_card_widget(self, app):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.get_style_context().add_class("app-card")
        card.set_size_request(270, 148)

        # Top Row: App Icon + Titles & Badges
        top_hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        card.pack_start(top_hbox, False, False, 0)

        icon_img = create_app_icon(app.get("icon", ""), app.get("category", "utilities"))
        top_hbox.pack_start(icon_img, False, False, 0)

        col_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        top_hbox.pack_start(col_vbox, True, True, 0)

        lbl_name = Gtk.Label(label=app.get("name", "Aplikasi"), xalign=0)
        lbl_name.set_ellipsize(Pango.EllipsizeMode.END)
        lbl_name.get_style_context().add_class("app-card-name")
        col_vbox.pack_start(lbl_name, False, False, 0)

        tags_hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        col_vbox.pack_start(tags_hbox, False, False, 0)

        cat_tag = Gtk.Label(label=app.get("category", "App").capitalize())
        cat_tag.get_style_context().add_class("badge-category")
        tags_hbox.pack_start(cat_tag, False, False, 0)

        src = app.get("source", "flathub").lower()
        if src == "apt":
            badge_src = Gtk.Label(label="Debian Native")
            badge_src.get_style_context().add_class("badge-debian")
        else:
            badge_src = Gtk.Label(label="Flathub")
            badge_src.get_style_context().add_class("badge-flathub")
        tags_hbox.pack_start(badge_src, False, False, 0)

        # Middle Row: 2-line clean summary description
        lbl_desc = Gtk.Label(label=app.get("summary", ""), xalign=0)
        lbl_desc.set_line_wrap(True)
        lbl_desc.set_line_wrap_mode(Pango.WrapMode.WORD)
        lbl_desc.set_lines(2)
        lbl_desc.set_ellipsize(Pango.EllipsizeMode.END)
        lbl_desc.set_max_width_chars(32)
        lbl_desc.get_style_context().add_class("app-card-summary")
        card.pack_start(lbl_desc, True, True, 0)

        # Bottom Row: Size Metric + Compact Action Button
        bottom_hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        card.pack_end(bottom_hbox, False, False, 0)

        size_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        size_box.pack_start(svg_icon("package", color="#475569", size=13), False, False, 0)
        lbl_size = Gtk.Label(label=app.get("size", "N/A"), xalign=0)
        lbl_size.get_style_context().add_class("app-card-size")
        size_box.pack_start(lbl_size, False, False, 0)
        bottom_hbox.pack_start(size_box, False, False, 0)

        spacer = Gtk.Box()
        bottom_hbox.pack_start(spacer, True, True, 0)

        btn_action = Gtk.Button()
        self._set_action_button_state(btn_action, "not_installed")
        btn_action.connect("clicked", self.on_action_clicked, app)
        bottom_hbox.pack_end(btn_action, False, False, 0)

        self.app_buttons[app.get("id")] = btn_action
        return card

    # --------------------------------------------------------------------------
    # Card Filtering Engine
    # --------------------------------------------------------------------------
    def filter_app_card(self, child):
        app = getattr(child, "app_data", None)
        if not app:
            return True

        app_id = app.get("id", "")
        category = app.get("category", "").lower()
        is_featured = bool(app.get("featured", False))
        is_installed = app_id in self.installed_ids

        # 1. Filter by Status (All vs Installed)
        if self.active_status == "installed" and not is_installed:
            return False

        # 2. Filter by Category (when search is empty, apply category; when searching across catalog, allow category or all)
        if self.active_category == "featured":
            if not is_featured and not self.search_query.strip():
                return False
        elif self.active_category != "all":
            target_cat = self.active_category
            if target_cat == "development" and category not in ("development", "coding"):
                return False
            elif target_cat == "media" and category not in ("media", "multimedia"):
                return False
            elif target_cat == "gaming" and category not in ("gaming", "games"):
                return False
            elif target_cat == "utilities" and category not in ("utilities", "utility", "system"):
                return False
            elif target_cat in ("internet", "office") and category != target_cat:
                return False

        # 3. Filter by Search Query
        q = self.search_query.strip().lower()
        if q:
            name = app.get("name", "").lower()
            summary = app.get("summary", "").lower()
            pkg = app.get("package", "").lower()
            if q not in name and q not in summary and q not in pkg and q not in category and q not in app_id.lower():
                return False

        return True

    def update_filter_view(self):
        self.flowbox.invalidate_filter()

        if self.active_status == "installed":
            self.lbl_sec_title.set_text("Aplikasi Terpasang")
            self.lbl_sec_desc.set_text("Daftar aplikasi katalog yang sudah terpasang di sistem Anda")
            pix = make_svg_pixbuf("installed", color="#0E7490", size=22)
            if pix is not None:
                self.sec_icon_img.set_from_pixbuf(pix)
        elif self.active_category == "featured":
            self.lbl_sec_title.set_text("Aplikasi Unggulan")
            self.lbl_sec_desc.set_text("Pilihan aplikasi esensial untuk penggunaan sehari-hari")
            pix = make_svg_pixbuf("featured", color="#0E7490", size=22)
            if pix is not None:
                self.sec_icon_img.set_from_pixbuf(pix)
        else:
            for cat_k, icon_k, cat_l, cat_d in self.categories_def:
                if cat_k == self.active_category:
                    self.lbl_sec_title.set_text(cat_l)
                    self.lbl_sec_desc.set_text(cat_d)
                    pix = make_svg_pixbuf(icon_k, color="#0E7490", size=22)
                    if pix is not None:
                        self.sec_icon_img.set_from_pixbuf(pix)
                    break

        visible_count = 0
        for child in self.app_cards:
            if self.filter_app_card(child):
                visible_count += 1
        self.lbl_sec_count.set_text(f"{visible_count} aplikasi")

        if visible_count == 0:
            self._update_empty_state()
            self.content_stack.set_visible_child_name("empty")
        else:
            self.content_stack.set_visible_child_name("grid")

    def _update_empty_state(self):
        q = self.search_query.strip()
        if q:
            pix = make_svg_pixbuf("search", color="#0E7490", size=32)
            if pix is not None:
                self.empty_icon_img.set_from_pixbuf(pix)
            self.lbl_empty_title.set_text(f"Tidak ada hasil untuk \"{q}\"")
            self.lbl_empty_desc.set_text("Coba kata kunci yang lebih singkat atau hapus pencarian untuk melihat seluruh katalog.")
            self.btn_empty_action.set_label("Reset Pencarian")
        elif self.active_status == "installed":
            pix = make_svg_pixbuf("installed", color="#0E7490", size=32)
            if pix is not None:
                self.empty_icon_img.set_from_pixbuf(pix)
            self.lbl_empty_title.set_text("Belum ada aplikasi katalog yang terpasang")
            self.lbl_empty_desc.set_text("Buka tampilan Semua untuk menelusuri dan memasang aplikasi dari APT atau Flathub.")
            self.btn_empty_action.set_label("Lihat Semua Aplikasi")
        else:
            pix = make_svg_pixbuf("package", color="#0E7490", size=32)
            if pix is not None:
                self.empty_icon_img.set_from_pixbuf(pix)
            self.lbl_empty_title.set_text("Belum ada aplikasi di kategori ini")
            self.lbl_empty_desc.set_text("Pilih kategori lain di bilah kiri atau tampilkan aplikasi unggulan.")
            self.btn_empty_action.set_label("Kembali ke Unggulan")

    def on_empty_action_clicked(self, widget):
        if self.search_query.strip():
            self.search_entry.set_text("")
        elif self.active_status == "installed":
            self.on_status_clicked(self.btn_status_all, "all")
        else:
            self.on_category_clicked(self.sidebar_buttons["cat_featured"], "featured")

    # --------------------------------------------------------------------------
    # Event Handlers: Navigation & Search
    # --------------------------------------------------------------------------
    def on_status_clicked(self, widget, status_mode):
        self.active_status = status_mode
        self._set_sidebar_group_active("status_", f"status_{status_mode}")
        self.update_filter_view()

    def on_category_clicked(self, widget, cat_key):
        self.active_category = cat_key
        self._set_sidebar_group_active("cat_", f"cat_{cat_key}")
        self.update_filter_view()

    def on_search_changed(self, entry):
        self.search_query = entry.get_text()
        self.update_filter_view()

    def on_refresh_clicked(self, widget):
        self.set_status("Menyegarkan status paket lokal...", True)
        threading.Thread(target=self.async_fetch_installed_apps, daemon=True).start()

    # --------------------------------------------------------------------------
    # Backend Async Package Operations
    # --------------------------------------------------------------------------
    def set_status(self, text, is_busy=False):
        def _apply():
            self.lbl_status.set_text(text)
            if is_busy:
                self.spinner.start()
                self.spinner.show()
            else:
                self.spinner.stop()
                self.spinner.hide()
        GLib.idle_add(_apply)

    def async_fetch_installed_apps(self):
        GLib.idle_add(self.set_status, "Memeriksa daftar aplikasi terpasang...", True)
        backend = resolve_backend_path()
        found_installed = set()
        backend_failed = False

        if os.path.exists(backend) and os.access(backend, os.X_OK):
            try:
                res = subprocess.run([backend, "list-installed", "--json"], capture_output=True, text=True, timeout=10)
                if res.returncode == 0 and res.stdout.strip():
                    data = json.loads(res.stdout.strip())
                    if isinstance(data, list):
                        found_installed = set(data)
                elif res.returncode != 0:
                    backend_failed = True
            except Exception as e:
                backend_failed = True
                print(f"[Brisk Store] Warning during list-installed: {e}", file=sys.stderr)

        # Safe local binary fallback if backend returned empty or failed
        if not found_installed:
            for app in self.catalog:
                cmd_str = app.get("command", "")
                if cmd_str:
                    bin_name = cmd_str.split()[0]
                    if bin_name != "flatpak" and shutil.which(bin_name):
                        found_installed.add(app.get("id"))

        GLib.idle_add(self.sync_installed_state, found_installed, backend_failed)

    def sync_installed_state(self, found_set, backend_failed=False):
        self.is_loading = False
        self.installed_ids = found_set
        self.lbl_installed_count.set_text(str(len(self.installed_ids)))

        for app_id, btn in self.app_buttons.items():
            state = "installed" if app_id in self.installed_ids else "not_installed"
            self._set_action_button_state(btn, state)

        self.update_filter_view()
        if backend_failed:
            self.set_status("Mode lokal aktif: pemeriksaan paket menggunakan deteksi biner langsung.", False)
        elif is_live_session():
            self.set_status(f"Mode Live siap: {len(self.installed_ids)} terpasang dari {len(self.catalog)} aplikasi katalog.", False)
        else:
            self.set_status(f"Siap. {len(self.installed_ids)} terpasang dari {len(self.catalog)} aplikasi katalog.", False)

    def on_action_clicked(self, button, app):
        app_id = app.get("id")
        is_installed = app_id in self.installed_ids
        action = "remove" if is_installed else "install"

        if action == "install":
            self._set_action_button_state(button, "busy_install")
            self.set_status(f"Memasang {app.get('name')}... Mohon tunggu.", True)
        else:
            self._set_action_button_state(button, "busy_remove")
            self.set_status(f"Mencopot {app.get('name')}... Mohon tunggu.", True)

        threading.Thread(target=self.async_execute_action, args=(app, action, button), daemon=True).start()

    def async_execute_action(self, app, action, button):
        app_id = app.get("id")
        backend = resolve_backend_path()

        if not (os.path.exists(backend) and os.access(backend, os.X_OK)):
            GLib.idle_add(
                self.on_action_finished,
                app, action, button, False,
                f"Backend tidak ditemukan di {backend}."
            )
            return

        is_root = False
        try:
            is_root = (os.geteuid() == 0)
        except AttributeError:
            is_root = False

        if is_root:
            cmd = [backend, action, app_id]
        elif shutil.which("sudo"):
            # Verify passwordless sudo; otherwise fall back to pkexec
            chk = subprocess.run(["sudo", "-n", "-l", backend], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if chk.returncode == 0:
                cmd = ["sudo", "-n", backend, action, app_id]
            elif shutil.which("pkexec"):
                cmd = ["pkexec", backend, action, app_id]
            else:
                cmd = ["sudo", "-n", backend, action, app_id]
        elif shutil.which("pkexec"):
            cmd = ["pkexec", backend, action, app_id]
        else:
            cmd = [backend, action, app_id]

        last_log = ""
        success = False

        try:
            proc = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
                universal_newlines=True
            )

            for line in iter(proc.stdout.readline, ""):
                stripped = line.strip()
                if stripped:
                    last_log = stripped
                    if stripped.startswith("-->") or "[Brisk Store" in stripped:
                        self.set_status(stripped, True)

            proc.stdout.close()
            ret = proc.wait()
            success = (ret == 0)
        except Exception as e:
            last_log = str(e)
            success = False

        GLib.idle_add(self.on_action_finished, app, action, button, success, last_log)

    def on_action_finished(self, app, action, button, success, last_log):
        app_id = app.get("id")

        if success:
            self.banner_revealer.set_reveal_child(False)
            if action == "install":
                self.installed_ids.add(app_id)
                self._set_action_button_state(button, "installed")
                msg = f"Berhasil memasang {app.get('name')}. Siap digunakan."
                self.notify_desktop(APP_NAME, f"Aplikasi {app.get('name')} berhasil dipasang.")
            else:
                self.installed_ids.discard(app_id)
                self._set_action_button_state(button, "not_installed")
                msg = f"Berhasil mencopot {app.get('name')}."
                self.notify_desktop(APP_NAME, f"Aplikasi {app.get('name')} berhasil dicopot.")

            self.set_status(msg, False)
        else:
            self._set_action_button_state(button, "installed" if action == "remove" else "not_installed")
            err_summary = last_log if last_log else "Terjadi kesalahan saat mengakses repositori atau koneksi internet."
            self.show_banner(f"Gagal memproses {app.get('name')}: {err_summary}", is_error=True)
            self.set_status(f"Gagal {action} {app.get('name')}. Periksa koneksi internet atau log sistem.", False)

        self.lbl_installed_count.set_text(str(len(self.installed_ids)))
        self.update_filter_view()

    def notify_desktop(self, title, message):
        if shutil.which("notify-send"):
            try:
                subprocess.Popen(
                    ["notify-send", "-i", APP_ID, "-a", APP_NAME, title, message],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
            except Exception:
                pass

    def on_destroy(self, *args):
        Gtk.main_quit()

# ------------------------------------------------------------------------------
# Entry Point
# ------------------------------------------------------------------------------
def apply_styling():
    screen = Gdk.Screen.get_default()
    if screen is not None:
        provider = Gtk.CssProvider()
        provider.load_from_data(MORNING_BREEZE_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            screen,
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    GLib.set_prgname(APP_ID)
    GLib.set_application_name(APP_NAME)

    if not Gtk.init_check()[0]:
        print("Error: Could not initialize GTK display (no X11/Wayland display server found).", file=sys.stderr)
        sys.exit(1)

    apply_styling()
    win = BriskStoreWindow()
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
