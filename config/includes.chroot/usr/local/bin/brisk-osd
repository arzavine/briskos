#!/usr/bin/env python3
# ==============================================================================
# Brisk Floating OSD HUD (brisk-osd)
# Ephemeral, Ultra-Lean Hardware Media & Brightness Overlay for BriskOS 1.0 LTS
# Pure PyGObject / GTK3 + LayerShell, Morning Breeze light surface + SVG icons.
# ==============================================================================

import os
import sys
import json
import socket
import signal
import subprocess
import threading

# ------------------------------------------------------------------------------
# Headless / Helper Hardware CLI Logic (Fast Path)
# ------------------------------------------------------------------------------
def get_socket_path():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    return os.path.join(runtime_dir, "brisk-osd.sock")

def adjust_volume(arg):
    # arg: "+5", "-5", "mute"
    is_mute_toggle = (arg == "mute")
    if is_mute_toggle:
        try:
            subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            try:
                subprocess.run(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "toggle"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
    else:
        sign = "+" if arg.startswith("+") else "-"
        val = arg.strip("+-")
        step = f"{val}%{sign}" if sign == "+" else f"{val}%-"
        try:
            subprocess.run(["wpctl", "set-volume", "-l", "1.5", "@DEFAULT_AUDIO_SINK@", step], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            try:
                subprocess.run(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{sign}{val}%"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass

    return read_volume()

def read_volume():
    # Returns (percent: int, muted: bool)
    try:
        res = subprocess.check_output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], text=True, stderr=subprocess.DEVNULL).strip()
        # Format example: "Volume: 0.65" or "Volume: 0.65 [MUTED]"
        parts = res.split()
        if len(parts) >= 2:
            vol_float = float(parts[1])
            muted = "[MUTED]" in res
            return int(round(vol_float * 100)), muted
    except Exception:
        pass

    try:
        res = subprocess.check_output(["pactl", "get-sink-volume", "@DEFAULT_SINK@"], text=True, stderr=subprocess.DEVNULL)
        for token in res.split():
            if token.endswith("%"):
                val = int(token.rstrip("%"))
                muted = False
                try:
                    mute_res = subprocess.check_output(["pactl", "get-sink-mute", "@DEFAULT_SINK@"], text=True, stderr=subprocess.DEVNULL)
                    muted = "yes" in mute_res.lower()
                except Exception:
                    pass
                return val, muted
    except Exception:
        pass

    return 65, False

def adjust_mic(arg):
    # Supports "toggle"/"mute", "on"/"unmute", "off", "+5", "-5"
    action = (arg or "toggle").strip().lower()
    if action.startswith(("+", "-")):
        sign = "+" if action.startswith("+") else "-"
        val = action.strip("+-")
        step = f"{val}%{sign}"
        try:
            subprocess.run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SOURCE@", step], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            try:
                subprocess.run(["pactl", "set-source-volume", "@DEFAULT_SOURCE@", f"{sign}{val}%"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
    elif action in ("on", "unmute", "0"):
        try:
            subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "0"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            try:
                subprocess.run(["pactl", "set-source-mute", "@DEFAULT_SOURCE@", "0"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
    elif action in ("off", "1"):
        try:
            subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "1"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            try:
                subprocess.run(["pactl", "set-source-mute", "@DEFAULT_SOURCE@", "1"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
    else:
        try:
            subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            try:
                subprocess.run(["pactl", "set-source-mute", "@DEFAULT_SOURCE@", "toggle"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
    return read_mic()

def read_mic():
    # Returns (percent: int, muted: bool)
    try:
        res = subprocess.check_output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@"], text=True, stderr=subprocess.DEVNULL).strip()
        muted = "[MUTED]" in res
        vol = 100
        for part in res.split():
            try:
                val = float(part)
                vol = int(round(val * 100))
                break
            except ValueError:
                continue
        return max(0, min(100, vol)), muted
    except Exception:
        pass

    try:
        res = subprocess.check_output(["pactl", "get-source-volume", "@DEFAULT_SOURCE@"], text=True, stderr=subprocess.DEVNULL)
        for token in res.split():
            if token.endswith("%"):
                val = max(0, min(100, int(token.rstrip("%"))))
                muted = False
                try:
                    mute_res = subprocess.check_output(["pactl", "get-source-mute", "@DEFAULT_SOURCE@"], text=True, stderr=subprocess.DEVNULL)
                    muted = "yes" in mute_res.lower()
                except Exception:
                    pass
                return val, muted
    except Exception:
        pass

    return 100, False

def adjust_brightness(arg):
    # arg: "+5", "-5"
    sign = "+" if arg.startswith("+") else "-"
    val = arg.strip("+-")
    step = f"{val}%{sign}"
    try:
        subprocess.run(["brightnessctl", "set", step], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
    return read_brightness()

def read_brightness():
    # Returns (percent: int)
    try:
        res = subprocess.check_output(["brightnessctl", "-m"], text=True, stderr=subprocess.DEVNULL).strip()
        parts = res.split(",")
        if len(parts) >= 4:
            for p in reversed(parts):
                if p.endswith("%"):
                    return int(p.rstrip("%"))
    except Exception:
        pass
    return 70

def send_ipc(payload):
    sock_path = get_socket_path()
    if not os.path.exists(sock_path):
        return False
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.2)
        s.connect(sock_path)
        s.sendall(json.dumps(payload).encode("utf-8") + b"\n")
        s.close()
        return True
    except Exception:
        return False

# ------------------------------------------------------------------------------
# Inline Uniform-Stroke SVG Icon Helpers
# ------------------------------------------------------------------------------
SVG_PATHS = {
    "volume_high": (
        '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>'
        '<path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>'
        '<path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>'
    ),
    "volume_mid": (
        '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>'
        '<path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>'
    ),
    "volume_low": (
        '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>'
    ),
    "volume_muted": (
        '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>'
        '<line x1="22" y1="9" x2="16" y2="15"/>'
        '<line x1="16" y1="9" x2="22" y2="15"/>'
    ),
    "brightness": (
        '<circle cx="12" cy="12" r="4"/>'
        '<line x1="12" y1="2" x2="12" y2="4"/>'
        '<line x1="12" y1="20" x2="12" y2="22"/>'
        '<line x1="4.93" y1="4.93" x2="6.34" y2="6.34"/>'
        '<line x1="17.66" y1="17.66" x2="19.07" y2="19.07"/>'
        '<line x1="2" y1="12" x2="4" y2="12"/>'
        '<line x1="20" y1="12" x2="22" y2="12"/>'
        '<line x1="6.34" y1="17.66" x2="4.93" y2="19.07"/>'
        '<line x1="19.07" y1="4.93" x2="17.66" y2="6.34"/>'
    ),
    "mic": (
        '<rect x="9" y="2" width="6" height="11" rx="3"/>'
        '<path d="M5 10a7 7 0 0 0 14 0"/>'
        '<line x1="12" y1="17" x2="12" y2="21"/>'
        '<line x1="8" y1="21" x2="16" y2="21"/>'
    ),
    "mic_muted": (
        '<rect x="9" y="2" width="6" height="11" rx="3"/>'
        '<path d="M5 10a7 7 0 0 0 10.6 6"/>'
        '<line x1="12" y1="17" x2="12" y2="21"/>'
        '<line x1="8" y1="21" x2="16" y2="21"/>'
        '<line x1="3" y1="3" x2="21" y2="21"/>'
    ),
}

# ------------------------------------------------------------------------------
# GUI HUD Application (PyGObject GTK3 + LayerShell)
# ------------------------------------------------------------------------------
def run_gui(initial_payload):
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import Gtk, Gdk, GLib, GdkPixbuf

    has_layer_shell = False
    try:
        gi.require_version("GtkLayerShell", "0.1")
        from gi.repository import GtkLayerShell
        has_layer_shell = bool(GtkLayerShell.is_supported())
    except Exception:
        has_layer_shell = False

    def make_svg_pixbuf(name, color="#0E7490", size=22):
        path_data = SVG_PATHS.get(name, SVG_PATHS["volume_high"])
        svg_xml = (
            f'<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}" '
            f'viewBox="0 0 24 24" fill="none" stroke="{color}" '
            f'stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">'
            f'{path_data}</svg>'
        ).encode("utf-8")
        try:
            loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
            loader.set_size(size, size)
            loader.write(svg_xml)
            loader.close()
            return loader.get_pixbuf()
        except Exception:
            return None

    OSD_CSS = b"""
    window {
        background-color: transparent;
        background-image: none;
    }

    .osd-pill {
        background-color: rgba(255, 255, 255, 0.94);
        background-image: none;
        border: 1px solid #CBD5E1;
        border-radius: 14px;
        padding: 12px 18px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.14);
    }

    .osd-icon-wrap {
        margin-right: 12px;
    }

    .osd-title {
        color: #475569;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
    }

    .osd-value {
        color: #0F172A;
        font-size: 13px;
        font-weight: 700;
        margin-left: 14px;
        min-width: 48px;
    }

    .osd-value-muted {
        color: #991B1B;
        font-size: 13px;
        font-weight: 700;
        margin-left: 14px;
        min-width: 48px;
    }

    /* Morning Breeze Level Bar */
    progressbar trough {
        background-color: #E9F1F4;
        background-image: none;
        box-shadow: none;
        border: 1px solid #CBD5E1;
        border-radius: 5px;
        min-height: 8px;
        min-width: 170px;
    }

    progressbar progress {
        background-color: #0E7490;
        background-image: none;
        box-shadow: none;
        border: none;
        border-radius: 5px;
    }

    .muted-bar progress {
        background-color: #B91C1C;
        background-image: none;
        box-shadow: none;
        border: none;
        border-radius: 5px;
    }
    """

    class BriskOSDWindow(Gtk.Window):
        def __init__(self, init_data):
            super().__init__(type=Gtk.WindowType.TOPLEVEL)
            self.set_title("Brisk OSD HUD")
            self.set_decorated(False)
            self.set_resizable(False)
            self.set_skip_taskbar_hint(True)
            self.set_skip_pager_hint(True)
            self.set_keep_above(True)

            # Request RGBA visual for crisp rounded pill transparency
            screen = self.get_screen()
            if screen is not None:
                visual = screen.get_rgba_visual()
                if visual is not None and screen.is_composited():
                    self.set_visual(visual)
                self.set_app_paintable(True)

            # Apply CSS
            provider = Gtk.CssProvider()
            provider.load_from_data(OSD_CSS)
            if screen is not None:
                Gtk.StyleContext.add_provider_for_screen(
                    screen,
                    provider,
                    Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
                )

            # Wayland Layer Shell Integration
            if has_layer_shell:
                GtkLayerShell.init_for_window(self)
                GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
                GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 48)
                GtkLayerShell.set_exclusive_zone(self, 0)
                GtkLayerShell.set_keyboard_interactivity(self, False)
            else:
                self.set_position(Gtk.WindowPosition.CENTER)

            # Build UI
            self.pill_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
            self.pill_box.get_style_context().add_class("osd-pill")
            self.add(self.pill_box)

            # Vector SVG Icon
            self.icon_img = Gtk.Image()
            self.icon_img.get_style_context().add_class("osd-icon-wrap")
            self.pill_box.pack_start(self.icon_img, False, False, 0)

            # Center VBox: Title + Progress Bar
            v_center = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            self.lbl_title = Gtk.Label(xalign=0)
            self.lbl_title.get_style_context().add_class("osd-title")
            v_center.pack_start(self.lbl_title, False, False, 0)

            self.progress = Gtk.ProgressBar()
            self.progress.set_show_text(False)
            v_center.pack_start(self.progress, False, False, 0)
            self.pill_box.pack_start(v_center, True, True, 0)

            # Percentage / Mute Label
            self.lbl_val = Gtk.Label(xalign=1)
            self.lbl_val.get_style_context().add_class("osd-value")
            self.pill_box.pack_start(self.lbl_val, False, False, 0)

            self.timeout_id = None
            self.update_hud(init_data)
            self.show_all()

            # Start IPC Listener Thread
            self.sock_path = get_socket_path()
            if os.path.exists(self.sock_path):
                try:
                    os.remove(self.sock_path)
                except Exception:
                    pass

            self.server_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.server_sock.bind(self.sock_path)
            self.server_sock.listen(5)

            t = threading.Thread(target=self._ipc_listener_loop, daemon=True)
            t.start()

        def _set_svg_icon(self, icon_name, muted=False):
            color = "#B91C1C" if muted else "#0E7490"
            pixbuf = make_svg_pixbuf(icon_name, color=color, size=22)
            if pixbuf is not None:
                self.icon_img.set_from_pixbuf(pixbuf)
            else:
                self.icon_img.set_from_icon_name("audio-volume-high-symbolic", Gtk.IconSize.LARGE_TOOLBAR)

        def update_hud(self, data):
            htype = data.get("type", "volume")
            val = int(data.get("value", 50))
            muted = bool(data.get("muted", False))

            val = max(0, min(100, val))
            fraction = val / 100.0

            val_ctx = self.lbl_val.get_style_context()
            bar_ctx = self.progress.get_style_context()

            if htype == "volume":
                self.lbl_title.set_text("VOLUME")
                if muted:
                    self._set_svg_icon("volume_muted", muted=True)
                    val_ctx.remove_class("osd-value")
                    val_ctx.add_class("osd-value-muted")
                    self.lbl_val.set_text("MUTE")
                    bar_ctx.add_class("muted-bar")
                else:
                    icon_name = "volume_high" if val > 60 else ("volume_mid" if val > 20 else "volume_low")
                    self._set_svg_icon(icon_name, muted=False)
                    val_ctx.remove_class("osd-value-muted")
                    val_ctx.add_class("osd-value")
                    self.lbl_val.set_text(f"{val}%")
                    bar_ctx.remove_class("muted-bar")
            elif htype == "brightness":
                self.lbl_title.set_text("KECERAHAN")
                self._set_svg_icon("brightness", muted=False)
                val_ctx.remove_class("osd-value-muted")
                val_ctx.add_class("osd-value")
                self.lbl_val.set_text(f"{val}%")
                bar_ctx.remove_class("muted-bar")
            elif htype == "mic":
                self.lbl_title.set_text("MIKROFON")
                if muted:
                    self._set_svg_icon("mic_muted", muted=True)
                    val_ctx.remove_class("osd-value")
                    val_ctx.add_class("osd-value-muted")
                    self.lbl_val.set_text("MUTE")
                    bar_ctx.add_class("muted-bar")
                else:
                    self._set_svg_icon("mic", muted=False)
                    val_ctx.remove_class("osd-value-muted")
                    val_ctx.add_class("osd-value")
                    self.lbl_val.set_text(f"{val}%")
                    bar_ctx.remove_class("muted-bar")

            self.progress.set_fraction(fraction)

            # Reset Auto-dismiss timer (1200ms)
            if self.timeout_id:
                GLib.source_remove(self.timeout_id)
            self.timeout_id = GLib.timeout_add(1200, self._on_timeout)

        def _on_timeout(self):
            if os.path.exists(self.sock_path):
                try:
                    os.remove(self.sock_path)
                except Exception:
                    pass
            Gtk.main_quit()
            return False

        def _ipc_listener_loop(self):
            while True:
                try:
                    conn, _ = self.server_sock.accept()
                    raw = conn.recv(1024).decode("utf-8")
                    conn.close()
                    if raw:
                        for line in raw.strip().split("\n"):
                            msg = json.loads(line)
                            GLib.idle_add(self.update_hud, msg)
                except Exception:
                    break

    BriskOSDWindow(initial_payload)
    Gtk.main()

# ------------------------------------------------------------------------------
# Entrypoint & Command Dispatcher
# ------------------------------------------------------------------------------
def main():
    if len(sys.argv) < 2:
        print("Brisk OSD HUD CLI")
        print("Usage: brisk-osd <volume|brightness|mic|preview> [args]")
        sys.exit(0)

    target = sys.argv[1].lower()
    arg = sys.argv[2] if len(sys.argv) > 2 else ("toggle" if target == "mic" else "+5")

    payload = {"type": "volume", "value": 65, "muted": False}

    if target == "volume":
        val, muted = adjust_volume(arg)
        payload = {"type": "volume", "value": val, "muted": muted}
    elif target == "brightness":
        val = adjust_brightness(arg)
        payload = {"type": "brightness", "value": val, "muted": False}
    elif target == "mic":
        val, muted = adjust_mic(arg)
        payload = {"type": "mic", "value": val, "muted": muted}
    elif target == "preview":
        ptype = arg if arg in ["volume", "brightness", "mic"] else "volume"
        pval = int(sys.argv[3]) if len(sys.argv) > 3 else 75
        pmuted = (len(sys.argv) > 4 and sys.argv[4].lower() in ("mute", "muted", "true", "1"))
        payload = {"type": ptype, "value": pval, "muted": pmuted}

    # 1. Try sending via IPC to existing visible HUD
    if send_ipc(payload):
        sys.exit(0)

    # 2. No HUD running, spawn HUD daemon
    if hasattr(os, "fork"):
        if os.fork() != 0:
            sys.exit(0)
        os.setsid()
    run_gui(payload)

if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    main()
