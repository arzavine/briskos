pipewire-pulse
wireplumber

# Network Management
network-manager
iwd

# Base Administration & Localization
sudo
locales
tzdata

# Bootloader Support (UEFI + BIOS / Secure Boot)
grub-efi-amd64-bin
grub-pc-bin
shim-signed
