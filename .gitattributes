# Enforce pure Unix LF line endings across all platforms
* text=auto eol=lf
*.sh text eol=lf
*.chroot text eol=lf
*.conf text eol=lf
*.list text eol=lf
*.ini text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.css text eol=lf
*.desktop text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
